<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- إعادة استعمال المصادر دون تعديل التطبيق القديم؛ كشف البنك المحلي يصحح قاعدة التقريب. -->
    <Compile Include="../../windows/SalaryDesktop.Core/*.cs" Exclude="../../windows/SalaryDesktop.Core/BankStatement.cs" Link="Reused/%(Filename)%(Extension)" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="plist-cil" Version="2.3.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.9" />
  </ItemGroup>
</Project>
