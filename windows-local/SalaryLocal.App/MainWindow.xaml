<Window x:Class="SalaryLocal.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="الرواتب المحلية 0.2 | مرشح اختبار" Width="1320" Height="850" Loaded="LoadedWindow" Closing="ClosingWindow">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Ink}"><DockPanel Margin="18,28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="▤" Foreground="{DynamicResource NavIcon}" FontSize="38"/><TextBlock Text="الرواتب المحلية" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,4"/><TextBlock Text="مساحة عمل خاصة على جهازك" Foreground="{DynamicResource NavMuted}" FontSize="12"/><Border Height="1" Background="{DynamicResource NavLine}" Margin="0,25"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="●  تخزين محلي" Foreground="{DynamicResource NavIcon}"/><TextBlock Text="لا اتصال بسيرفر أو مزامنة سحابية" Foreground="{DynamicResource NavMuted}" FontSize="11" Margin="0,8"/><TextBlock Text="0.2 • مرشح اختبار" Foreground="{DynamicResource NavMuted}" FontSize="11"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Navigation"><Button Content="الرئيسية" Tag="home" Click="Navigate"/><Button Content="المنتسبون" Tag="employees" Click="Navigate"/><Button Content="الاستقطاعات" Tag="deductions" Click="Navigate"/><Button Content="كشف البنك" Tag="bank" Click="Navigate"/><Button Content="الملاك" Tag="staff" Click="Navigate"/><Button Content="أرشيف الكتب" Tag="archive" Click="Navigate"/><Button Content="أمانات الرواتب" Tag="trust" Click="Navigate"/><Button Content="حسابات الجهات" Tag="accounts" Click="Navigate"/><Button Content="تجهيز التحويلات" Tag="transfers" Click="Navigate"/><Button Content="مطابقة البنك" Tag="reconciliation" Click="Navigate"/><Button Content="تدقيق الرواتب" Tag="audit" Click="Navigate"/><Button Content="مقارنة الاستقطاعات" Tag="comparison" Click="Navigate"/><Button Content="التقارير" Tag="reports" Click="Navigate"/><Button Content="سجل الاستيراد" Tag="history" Click="Navigate"/><Button Content="النسخ ومساحات العمل" Tag="settings" Click="Navigate"/></StackPanel></ScrollViewer></DockPanel></Border>
<Grid Grid.Column="1" Margin="28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid x:Name="Toolbar"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="إدارة الرواتب" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="من ملفات Excel إلى سجلات محلية منظمة" Foreground="{DynamicResource Muted}" Margin="0,5"/></StackPanel><ComboBox x:Name="Months" Grid.Column="1" Margin="12,6" SelectionChanged="MonthChanged" DisplayMemberPath="Name"/><Button Grid.Column="2" Content="＋ استيراد Excel" Style="{StaticResource PrimaryButton}" Click="ImportClick"/></Grid>
<Border Grid.Row="1" Background="{DynamicResource SoftAccent}" CornerRadius="8" Padding="13" Margin="0,18,0,16"><TextBlock x:Name="Notice" Text="ابدأ باستيراد ملف رواتب أو استقطاعات، أو افتح نسخة محلية." Foreground="{DynamicResource Accent}"/></Border>
<Grid Grid.Row="2"><ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Page"/></ScrollViewer><Grid x:Name="TablePanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Left" Content="تصدير Excel للمعروض" Click="ExportTableClick"/><TextBox x:Name="Search" MinWidth="200" ToolTip="ابحث بالاسم أو الرتبة أو الجهة" TextChanged="SearchChanged"/></DockPanel><DataGrid x:Name="Table" Grid.Row="1" MouseDoubleClick="OpenDetails" KeyDown="TableKeyDown"/><TextBlock x:Name="TableCount" Grid.Row="2" Margin="4,12" Foreground="{DynamicResource Muted}"/></Grid></Grid>
<DockPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="CancelOperation" Content="إلغاء العملية" Visibility="Collapsed" DockPanel.Dock="Left" Click="CancelClick" Padding="8,2"/><ProgressBar x:Name="Progress" Width="100" Height="4" IsIndeterminate="True" Visibility="Collapsed" DockPanel.Dock="Left"/><TextBlock x:Name="Status" Text="جاهز" Foreground="{DynamicResource Muted}" FontSize="12"/></DockPanel>
</Grid></Grid></Window>
