enum Money { static func format(_ value: Double?) -> String { "" } }
struct TransferLetterCustomizationStore: Decodable {
    static let settingsKey = "letters"
    struct Fields: Decodable {
        var header, footer, fixedNumber, committeeFirst, committeeSecond, committeeThird: String?
        var letterTemplate: CustomTransferTemplate?
        var signatureOffset: Int?
    }
    func effective(for id: String) -> Fields { common }
    var common: Fields
}
enum PDFWork { static func run<T>(_ body: @escaping () throws -> T) async throws -> T { try body() } }
@MainActor enum ActivityShare { static func present(_ urls: [URL], onDone: ((Bool) -> Void)? = nil) {} }
