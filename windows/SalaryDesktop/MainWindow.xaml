<Window x:Class="SalaryDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تطبيق الرواتب — ويندوز" Height="840" Width="1460" MinHeight="660" MinWidth="1080"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" FontSize="14"
        WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="WindowDragOver" Drop="WindowDrop" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" PreviewKeyDown="WindowKeyDown">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- القائمة الجانبية -->
    <Border Grid.Column="0" Background="{DynamicResource TbgFBFCFC}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,20,14,16">
        <Grid DockPanel.Dock="Top" Margin="4,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image Source="pack://application:,,,/SalaryDesktop;component/Assets/AppIcon.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="16.5" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" Text="تطبيق الرواتب"/>
            <TextBlock FontSize="11.5" Foreground="{DynamicResource Muted}" Text="نسخة ويندوز · قيد التطوير" x:Name="VersionText"/>
          </StackPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom">
          <!-- تنبيه الإصدار الأحدث من صفحة الإصدارات. -->
          <Border x:Name="UpdateCard" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource Accent}" FontSize="14" Margin="0,0,7,0"/><TextBlock x:Name="UpdateTitle" Text="إصدار أحدث متاح" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" FontSize="12.5"/></StackPanel>
              <TextBlock Text="نزّل ملف التثبيت وشغّله؛ يُحدّث البرنامج ولا تتأثر البيانات المحلية." FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/>
              <Button Style="{StaticResource ActionButton}" Content="تنزيل التحديث" Click="DownloadUpdate" Padding="12,6"/>
            </StackPanel>
          </Border>
          <!-- تذكير الحفظ: يظهر عند وجود تعديلات محلية لم تدخل نسخة شاملة بعد. -->
          <Border x:Name="BackupReminder" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
              <DockPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Top" DockPanel.Dock="Left"/><TextBlock x:Name="BackupReminderTitle" Text="تعديلات غير محفوظة في نسخة" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" FontSize="12.5"/></DockPanel>
              <TextBlock x:Name="BackupReminderText" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/>
              <Button x:Name="BackupNowButton" Style="{StaticResource ActionButton}" Content="حفظ نسخة الآن" Click="ExportBackup" Padding="12,6" ToolTip="حفظ نسخة احتياطية شاملة تتضمن التعديلات المحلية"/>
            </StackPanel>
          </Border>
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="settings" Checked="Navigate" ToolTip="Ctrl+0">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Width="28"/><TextBlock Text="الإعدادات"/></StackPanel>
          </RadioButton>
          <Border Background="{DynamicResource TbgF1F5F4}" CornerRadius="9" Padding="11,9" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock x:Name="SidebarData" Text="لا توجد بيانات مفتوحة" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Tfg38504C}" TextWrapping="Wrap"/>
              <TextBlock Text="محفوظة محلياً في حساب ويندوز" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel>
            <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="home" Checked="Navigate" IsChecked="True" ToolTip="Ctrl+1">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Width="28"/><TextBlock Text="الرئيسية"/></StackPanel>
            </RadioButton>
            <TextBlock Style="{StaticResource NavHeader}" Text="البيانات"/>
            <RadioButton x:Name="NavPayroll" Style="{StaticResource NavItem}" Tag="payroll" Checked="Navigate" ToolTip="Ctrl+2">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" Width="28"/><TextBlock Text="الرواتب"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavDeductions" Style="{StaticResource NavItem}" Tag="deductions" Checked="Navigate" ToolTip="Ctrl+3">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE738;" Width="28"/><TextBlock Text="الاستقطاعات"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavStaff" Style="{StaticResource NavItem}" Tag="staff" Checked="Navigate" ToolTip="Ctrl+4">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE716;" Width="28"/><TextBlock Text="الملاك"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavArchive" Style="{StaticResource NavItem}" Tag="archive" Checked="Navigate" ToolTip="Ctrl+5">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" Width="28"/><TextBlock Text="الأرشيف"/></StackPanel>
            </RadioButton>
            <TextBlock Style="{StaticResource NavHeader}" Text="التقارير"/>
            <RadioButton x:Name="NavGroups" Style="{StaticResource NavItem}" Tag="groups" Checked="Navigate" ToolTip="Ctrl+6">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Width="28"/><TextBlock Text="جهات التنفيذ"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavBank" Style="{StaticResource NavItem}" Tag="bank" Checked="Navigate" ToolTip="Ctrl+7">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8EF;" Width="28"/><TextBlock Text="كشف البنك"/></StackPanel>
            </RadioButton>
            <TextBlock Style="{StaticResource NavHeader}" Text="التحويلات"/>
            <RadioButton x:Name="NavTransfer" Style="{StaticResource NavItem}" Tag="transfer" Checked="Navigate" ToolTip="Ctrl+8">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Width="28"/><TextBlock Text="ملفات التحويل"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavAccounts" Style="{StaticResource NavItem}" Tag="accounts" Checked="Navigate" ToolTip="Ctrl+9">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE825;" Width="28"/><TextBlock Text="حسابات الجهات"/></StackPanel>
            </RadioButton>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- المحتوى -->
    <Grid Grid.Column="1" Margin="28,20,28,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" Text="الرئيسية" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageSubtitle" Text="ملخص الشهر المختار" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
        </StackPanel>
        <Button x:Name="GlobalSearchButton" Grid.Column="1" Click="OpenGlobalSearch" Margin="0,0,10,0" Padding="12,0" Height="38" Width="270" HorizontalContentAlignment="Stretch" BorderBrush="{DynamicResource TbgCFD9DA}" VerticalAlignment="Center" ToolTip="بحث شامل عن منتسب أو جهة أو قسم (Ctrl+K)">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource Tfg7A8D8A}" Margin="0,0,9,0"/>
            <TextBlock Grid.Column="1" Text="ابحث عن منتسب أو جهة…" Foreground="{DynamicResource Tfg8A9B98}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Border Grid.Column="2" Background="{DynamicResource TbgF1F5F4}" BorderBrush="{DynamicResource TbgE1E8E7}" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Ctrl+K" FlowDirection="LeftToRight" FontSize="11.5" Foreground="{DynamicResource Tfg5D716E}"/></Border>
          </Grid>
        </Button>
        <Border Grid.Column="2" Background="{DynamicResource TbgFFFFFF}" BorderBrush="{DynamicResource TbgCFD9DA}" BorderThickness="1" CornerRadius="9" Margin="0,0,10,0" VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" Foreground="{DynamicResource Primary}" Margin="12,0,2,0"/>
            <ComboBox x:Name="MonthPicker" Grid.Column="1" Width="190" Height="36" BorderThickness="0" Background="Transparent" SelectionChanged="MonthChanged" VerticalContentAlignment="Center" ToolTip="الشهر المعروض"/>
          </Grid>
        </Border>
        <Button x:Name="ThemeToggle" Grid.Column="3" Click="ToggleTheme" Padding="0" Width="38" Height="38" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="الوضع الداكن / الفاتح">
          <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE708;" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/>
        </Button>
        <Button Grid.Column="4" Click="OpenBackup" ToolTip="فتح نسخة احتياطية من الآيفون (Ctrl+O)" Padding="14,8">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/><TextBlock Text="فتح نسخة الآيفون"/></StackPanel>
        </Button>
      </Grid>
      <Border x:Name="SourceBanner" Grid.Row="1" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource TbgCFE2F8}" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource Tfg2C6FB4}" Margin="0,0,10,0"/>
          <TextBlock x:Name="SourceMessage" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Tfg2F5873}" Text="افتح نسخة احتياطية من الآيفون أو ابدأ من ملف Excel. تُحفظ البيانات محلياً دون تعديل الملف الأصلي."/>
          <Button Grid.Column="2" Style="{StaticResource QuietButton}" Click="HideBanner" ToolTip="إخفاء" Padding="6,2" MinHeight="24" Margin="8,0,0,0">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" Foreground="{DynamicResource Tfg4F7491}"/>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <!-- الرئيسية -->
        <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
          <StackPanel>
            <Border CornerRadius="16" Padding="26,22" Margin="0,0,0,14">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C6E5B" Offset="0"/><GradientStop Color="#0F443B" Offset="1"/></LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="NetLabel" Text="صافي الرواتب للشهر المختار" FontSize="14" Foreground="#CDE6DF"/>
                  <TextBlock x:Name="NetAmount" Text="—" FontSize="40" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,4"/>
                  <TextBlock x:Name="PayrollCount" Text="لا توجد بيانات مفتوحة" Foreground="#DDEFEA"/>
                  <WrapPanel x:Name="DeltaPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <Border Background="#26FFFFFF" CornerRadius="11" Padding="10,3" Margin="0,0,8,0"><TextBlock x:Name="DeltaNet" Foreground="White" FontSize="12.5"/></Border>
                    <Border Background="#26FFFFFF" CornerRadius="11" Padding="10,3"><TextBlock x:Name="DeltaPeople" Foreground="White" FontSize="12.5"/></Border>
                  </WrapPanel>
                  <TextBlock x:Name="DataWarning" TextWrapping="Wrap" Foreground="#FFD892" Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                  <TextBlock Text="الفئات من كشف الرواتب" Foreground="#CDE6DF" FontSize="12" Margin="6,0,0,8"/>
                  <ItemsControl x:Name="HomeCategories">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#1AFFFFFF" CornerRadius="12" Padding="16,12" Margin="6,0,0,0" MinWidth="104">
                          <StackPanel><TextBlock Text="{Binding Name}" Foreground="#CDE6DF" FontSize="12"/><TextBlock Text="{Binding Count, StringFormat={}{0:N0}}" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Border>
            <!-- شريط التدقيق: ملاحظات الشهر مجمّعة بنوعها؛ النقر على نوع يفتح التدقيق مصفّى عليه. -->
            <Border x:Name="AlertStrip" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,14" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                  <TextBlock x:Name="AlertIcon" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" Margin="0,0,8,0"/>
                  <TextBlock x:Name="AlertTitle" Text="يحتاج انتباهك" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl x:Name="HomeAlerts" Grid.Column="1" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Click="OpenAlert" Tag="{Binding Kind}" Margin="0,3,6,3" Padding="0" MinHeight="0" BorderThickness="0" Background="Transparent" ToolTip="عرض هذه الملاحظات في التدقيق">
                        <Border x:Name="Chip" CornerRadius="11" Padding="10,3" Background="{DynamicResource AccentSoft}">
                          <TextBlock x:Name="ChipText" Text="{Binding Text}" FontSize="12.5" FontWeight="Normal" Foreground="{DynamicResource Accent}"/>
                        </Border>
                      </Button>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Severe}" Value="True">
                          <Setter TargetName="Chip" Property="Background" Value="{DynamicResource WarnSoft}"/>
                          <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Warn}"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="AuditHomeButton" Grid.Column="2" Content="فتح التدقيق" Click="OpenSalaryReview" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </Grid>
            </Border>
            <UniformGrid Columns="3" Margin="0,0,0,0">
              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="التقارير وجهات التنفيذ" Margin="0,12,0,0"/>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="مبالغ الاستقطاع لكل جهة وقوائمها المعتمدة، وبنود الرواتب" TextWrapping="Wrap" Margin="0,4,0,14"/>
                  <WrapPanel VerticalAlignment="Bottom"><Button Style="{StaticResource ActionButton}" Tag="groups" Click="Navigate" Content="عرض الجهات" Margin="0,0,8,6"/><Button x:Name="SalaryItemsButton" Click="OpenSalaryItems" Content="بنود الرواتب" Margin="0,0,0,6"/></WrapPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="14,0,0,14">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource TbgFFF1E3}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{DynamicResource TfgB5640C}" HorizontalAlignment="Center"/></Border>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="الكشوف الخاصة" Margin="0,12,0,0"/>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="بالشكل المعتمد في الآيفون، Excel أو PDF أو طباعة" Margin="0,4,0,14"/>
                  <WrapPanel VerticalAlignment="Bottom"><Button Style="{StaticResource ActionButton}" Tag="fund" Click="OpenSpecialReport" Content="صندوق الشهداء" Margin="0,0,8,6"/><Button Tag="health" Click="OpenSpecialReport" Content="الرعاية الصحية" Margin="0,0,8,6"/><Button Tag="food" Click="OpenSpecialReport" Content="عقد الإطعام" Margin="0,0,0,6"/></WrapPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="14,0,0,14">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource PrimarySoft}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/></Border>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="البنك والتحويلات" Margin="0,12,0,0"/>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="كشف حساب البنك وملفات التحويل والكتب" Margin="0,4,0,14"/>
                  <WrapPanel VerticalAlignment="Bottom"><Button Style="{StaticResource ActionButton}" Tag="bank" Click="Navigate" Content="كشف البنك" Margin="0,0,8,6"/><Button Tag="transfer" Click="Navigate" Content="ملفات التحويل" Margin="0,0,0,6"/></WrapPanel>
                </DockPanel>
              </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource CardTitle}" Text="البيانات المفتوحة"/>
                  <TextBlock x:Name="SnapshotSummary" Style="{StaticResource Hint}" Text="اختر نسخة احتياطية للبدء." Margin="0,6,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button x:Name="StartFromExcelButton" Content="بدء بيانات جديدة من Excel" Click="StartFromExcel" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Visibility="Collapsed"/>
                  <Button Tag="settings" Click="Navigate" Content="النسخ الاحتياطي"/>
                </WrapPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- جداول البيانات -->
        <Grid x:Name="DataPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
              <TextBox x:Name="SearchBox" Height="38" Padding="34,6,10,6" TextChanged="SearchChanged" Tag="ابحث بالاسم أو الجهة… (Ctrl+F)" KeyDown="SearchKeyDown"/>
              <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource Tfg8A9B98}" FontSize="14" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
            </Grid>
            <WrapPanel Grid.Column="1">
              <Button x:Name="ColumnsButton" Click="ShowColumns" Margin="10,0,0,0" ToolTip="إظهار الأعمدة أو إخفاؤها؛ يُحفظ الاختيار لكل جدول">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Foreground="{DynamicResource Primary}" Margin="0,0,7,0"/><TextBlock Text="الأعمدة"/></StackPanel>
                <Button.ContextMenu><ContextMenu x:Name="ColumnsMenu"/></Button.ContextMenu>
              </Button>
              <Button x:Name="ExportButton" Click="ShowExportMenu" Margin="10,0,0,0" ToolTip="تصدير الجدول المعروض بالشكل المعتمد أو طباعته">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE749;" Foreground="{DynamicResource Primary}" Margin="0,0,7,0"/><TextBlock Text="تصدير وطباعة"/><TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Foreground="{DynamicResource Tfg7A8D8A}" Margin="8,0,0,0"/></StackPanel>
                <Button.ContextMenu>
                  <ContextMenu x:Name="ExportMenu">
                    <MenuItem Header="Excel بالشكل المعتمد" Click="ExportTableExcel"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{DynamicResource Tfg1E7145}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="PDF بالشكل المعتمد" Click="ExportTablePdf"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" Foreground="{DynamicResource TfgB03A2E}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="طباعة" Click="PrintTable"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE749;"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem x:Name="ExportCopyMenu" Header="نسخ الصفوف المحددة للصقها في Excel" InputGestureText="Ctrl+C" Click="CopyRows"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;"/></MenuItem.Icon></MenuItem>
                    <Separator x:Name="EntityExportSeparator"/>
                    <MenuItem x:Name="EntityExportMenu" Header="قائمة استقطاعات الجهة المعتمدة">
                      <MenuItem Header="Excel" Click="ExportEntityExcel"/>
                      <MenuItem Header="PDF" Click="ExportEntityPdf"/>
                      <MenuItem Header="طباعة" Click="PrintEntity"/>
                    </MenuItem>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button x:Name="StaffReloadButton" Content="إعادة قراءة الملاك" Click="ReloadStaff" Margin="10,0,0,0" Visibility="Collapsed"/>
              <Button x:Name="AccountImportButton" Content="استيراد حسابات Excel" Click="ImportAccounts" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Visibility="Collapsed"/>
              <Button x:Name="PayrollImportButton" Content="استيراد الرواتب والاستقطاعات" Click="ImportPayroll" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Visibility="Collapsed"/>
              <Button x:Name="AnnualImportButton" Content="الاستقطاعات السنوية" Click="ImportAnnual" Margin="10,0,0,0" Visibility="Collapsed" ToolTip="استيراد ملف استقطاعات سنوي يُقسّم إلى أشهر"/>
            </WrapPanel>
          </Grid>
          <WrapPanel x:Name="FilterBar" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
