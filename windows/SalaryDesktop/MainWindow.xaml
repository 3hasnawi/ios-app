<Window x:Class="SalaryDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SalaryDesktop"
        Title="تطبيق الرواتب — ويندوز" Height="840" Width="1460" MinHeight="660" MinWidth="1080"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" FontSize="14"
        WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="WindowDragOver" Drop="WindowDrop" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" PreviewKeyDown="WindowKeyDown">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- القائمة الجانبية -->
    <Border Grid.Column="0" Background="{DynamicResource TbgFBFCFC}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,20,14,16">
        <Grid DockPanel.Dock="Top" Margin="4,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image Source="pack://application:,,,/SalaryDesktop;component/Assets/AppIcon.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="16.5" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" Text="تطبيق الرواتب"/>
            <TextBlock FontSize="11.5" Foreground="{DynamicResource Muted}" Text="نسخة ويندوز · قيد التطوير" x:Name="VersionText"/>
          </StackPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom">
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="settings" Checked="Navigate" ToolTip="Ctrl+0">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Width="28"/><TextBlock Text="الإعدادات"/></StackPanel>
          </RadioButton>
          <Border Background="{DynamicResource TbgF1F5F4}" CornerRadius="9" Padding="11,9" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock x:Name="SidebarData" Text="لا توجد بيانات مفتوحة" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Tfg38504C}" TextWrapping="Wrap"/>
              <TextBlock Text="محفوظة محلياً في حساب ويندوز" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel>
            <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="home" Checked="Navigate" IsChecked="True" ToolTip="Ctrl+1">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Width="28"/><TextBlock Text="الرئيسية"/></StackPanel>
            </RadioButton>
            <TextBlock Style="{StaticResource NavHeader}" Text="البيانات"/>
            <RadioButton x:Name="NavPayroll" Style="{StaticResource NavItem}" Tag="payroll" Checked="Navigate" ToolTip="Ctrl+2">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" Width="28"/><TextBlock Text="الرواتب"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavDeductions" Style="{StaticResource NavItem}" Tag="deductions" Checked="Navigate" ToolTip="Ctrl+3">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE738;" Width="28"/><TextBlock Text="الاستقطاعات"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavStaff" Style="{StaticResource NavItem}" Tag="staff" Checked="Navigate" ToolTip="Ctrl+4">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE716;" Width="28"/><TextBlock Text="الملاك"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavArchive" Style="{StaticResource NavItem}" Tag="archive" Checked="Navigate" ToolTip="Ctrl+5">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" Width="28"/><TextBlock Text="الأرشيف"/></StackPanel>
            </RadioButton>
            <Button Style="{StaticResource NavButton}" Click="OpenSalaryTrust" ToolTip="أمانات رواتب الكاش غير المستلمة (الدفتر المشترك مع الآيفون)">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" Width="28"/><TextBlock Text="أمانات الرواتب"/></StackPanel>
            </Button>
            <TextBlock Style="{StaticResource NavHeader}" Text="التقارير"/>
            <RadioButton x:Name="NavGroups" Style="{StaticResource NavItem}" Tag="groups" Checked="Navigate" ToolTip="Ctrl+6">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Width="28"/><TextBlock Text="جهات التنفيذ"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavBank" Style="{StaticResource NavItem}" Tag="bank" Checked="Navigate" ToolTip="Ctrl+7">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8EF;" Width="28"/><TextBlock Text="كشف البنك"/></StackPanel>
            </RadioButton>
            <TextBlock Style="{StaticResource NavHeader}" Text="التحويلات"/>
            <RadioButton x:Name="NavTransfer" Style="{StaticResource NavItem}" Tag="transfer" Checked="Navigate" ToolTip="Ctrl+8">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Width="28"/><TextBlock Text="ملفات التحويل"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavAccounts" Style="{StaticResource NavItem}" Tag="accounts" Checked="Navigate" ToolTip="Ctrl+9">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE825;" Width="28"/><TextBlock Text="حسابات الجهات"/></StackPanel>
            </RadioButton>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- المحتوى -->
    <Grid Grid.Column="1" Margin="28,20,28,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" Text="الرئيسية" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageSubtitle" Text="ملخص الشهر المختار" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
        </StackPanel>
        <Button x:Name="GlobalSearchButton" Grid.Column="1" Click="OpenGlobalSearch" Margin="0,0,10,0" Padding="12,0" Height="38" Width="270" HorizontalContentAlignment="Stretch" BorderBrush="{DynamicResource TbgCFD9DA}" VerticalAlignment="Center" ToolTip="بحث شامل عن منتسب أو جهة أو قسم (Ctrl+K)">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource Tfg7A8D8A}" Margin="0,0,9,0"/>
            <TextBlock Grid.Column="1" Text="ابحث عن منتسب أو جهة…" Foreground="{DynamicResource Tfg8A9B98}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Border Grid.Column="2" Background="{DynamicResource TbgF1F5F4}" BorderBrush="{DynamicResource TbgE1E8E7}" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Ctrl+K" FlowDirection="LeftToRight" FontSize="11.5" Foreground="{DynamicResource Tfg5D716E}"/></Border>
          </Grid>
        </Button>
        <Border Grid.Column="2" Background="{DynamicResource TbgFFFFFF}" BorderBrush="{DynamicResource TbgCFD9DA}" BorderThickness="1" CornerRadius="9" Margin="0,0,10,0" VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" Foreground="{DynamicResource Primary}" Margin="12,0,2,0"/>
            <ComboBox x:Name="MonthPicker" Grid.Column="1" Width="190" Height="36" BorderThickness="0" Background="Transparent" SelectionChanged="MonthChanged" VerticalContentAlignment="Center" ToolTip="الشهر المعروض"/>
          </Grid>
        </Border>
        <Button x:Name="ThemeToggle" Grid.Column="3" Click="ToggleTheme" Padding="0" Width="38" Height="38" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="الوضع الداكن / الفاتح">
          <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE708;" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/>
        </Button>
        <!-- جرس الإشعارات: كل التنبيهات في مكان واحد، وعليه عدّاد أحمر واضح عند وجود ما يحتاج انتباهك. -->
        <Button x:Name="BellButton" Grid.Column="4" Click="ToggleNotifications" Padding="0" Width="38" Height="38" VerticalAlignment="Center" ToolTip="الإشعارات والتنبيهات">
          <Grid>
            <TextBlock x:Name="BellIcon" Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="16" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.1">
              <TextBlock.RenderTransform><RotateTransform x:Name="BellSwing"/></TextBlock.RenderTransform>
            </TextBlock>
            <Border x:Name="BellBadge" Background="#D93025" CornerRadius="9" MinWidth="18" Height="18" Padding="4,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-9,-9,0,0" Visibility="Collapsed" BorderBrush="{DynamicResource Page}" BorderThickness="2">
              <TextBlock x:Name="BellCount" Text="1" Foreground="White" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
            </Border>
          </Grid>
        </Button>
      </Grid>
      <Border x:Name="SourceBanner" Grid.Row="1" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource TbgCFE2F8}" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource Tfg2C6FB4}" Margin="0,0,10,0"/>
          <TextBlock x:Name="SourceMessage" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Tfg2F5873}" Text="استورد نسخة احتياطية أو ملفات Excel من الإعدادات ← استيراد الملفات، أو اسحبها إلى النافذة. تُحفظ البيانات محلياً دون تعديل الملف الأصلي."/>
          <Button Grid.Column="2" Style="{StaticResource QuietButton}" Click="HideBanner" ToolTip="إخفاء" Padding="6,2" MinHeight="24" Margin="8,0,0,0">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" Foreground="{DynamicResource Tfg4F7491}"/>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <!-- الرئيسية -->
        <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
          <StackPanel>
            <Border CornerRadius="16" Padding="26,22" Margin="0,0,0,14">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C6E5B" Offset="0"/><GradientStop Color="#0F443B" Offset="1"/></LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="NetLabel" Text="صافي الرواتب للشهر المختار" FontSize="14" Foreground="#CDE6DF"/>
                  <TextBlock x:Name="NetAmount" Text="—" FontSize="40" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,4"/>
                  <TextBlock x:Name="PayrollCount" Text="لا توجد بيانات مفتوحة" Foreground="#DDEFEA"/>
                  <WrapPanel x:Name="DeltaPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <Border Background="#26FFFFFF" CornerRadius="11" Padding="10,3" Margin="0,0,8,0"><TextBlock x:Name="DeltaNet" Foreground="White" FontSize="12.5"/></Border>
                    <Border Background="#26FFFFFF" CornerRadius="11" Padding="10,3"><TextBlock x:Name="DeltaPeople" Foreground="White" FontSize="12.5"/></Border>
                  </WrapPanel>
                  <TextBlock x:Name="DataWarning" TextWrapping="Wrap" Foreground="#FFD892" Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                  <TextBlock Text="الفئات من كشف الرواتب" Foreground="#CDE6DF" FontSize="12" Margin="6,0,0,8"/>
                  <ItemsControl x:Name="HomeCategories">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#1AFFFFFF" CornerRadius="12" Padding="16,12" Margin="6,0,0,0" MinWidth="104">
                          <StackPanel><TextBlock Text="{Binding Name}" Foreground="#CDE6DF" FontSize="12"/><TextBlock Text="{Binding Count, StringFormat={}{0:N0}}" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Border>
            <!-- شريط التدقيق: ملاحظات الشهر مجمّعة بنوعها؛ النقر على نوع يفتح التدقيق مصفّى عليه. -->
            <Border x:Name="AlertStrip" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,14" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                  <TextBlock x:Name="AlertIcon" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" Margin="0,0,8,0"/>
                  <TextBlock x:Name="AlertTitle" Text="يحتاج انتباهك" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl x:Name="HomeAlerts" Grid.Column="1" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Click="OpenAlert" Tag="{Binding Kind}" Margin="0,3,6,3" Padding="0" MinHeight="0" BorderThickness="0" Background="Transparent" ToolTip="عرض هذه الملاحظات في التدقيق">
                        <Border x:Name="Chip" CornerRadius="11" Padding="10,3" Background="{DynamicResource AccentSoft}">
                          <TextBlock x:Name="ChipText" Text="{Binding Text}" FontSize="12.5" FontWeight="Normal" Foreground="{DynamicResource Accent}"/>
                        </Border>
                      </Button>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Severe}" Value="True">
                          <Setter TargetName="Chip" Property="Background" Value="{DynamicResource WarnSoft}"/>
                          <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Warn}"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="AuditHomeButton" Grid.Column="2" Content="فتح التدقيق" Click="OpenSalaryReview" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </Grid>
            </Border>
            <UniformGrid Columns="3" Margin="0,0,0,0">
              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="التقارير وجهات التنفيذ" Margin="0,12,0,0"/>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="مبالغ الاستقطاع لكل جهة وقوائمها المعتمدة، وبنود الرواتب" TextWrapping="Wrap" Margin="0,4,0,14"/>
                  <WrapPanel VerticalAlignment="Bottom"><Button Style="{StaticResource ActionButton}" Tag="groups" Click="Navigate" Content="عرض الجهات" Margin="0,0,8,6"/><Button x:Name="SalaryItemsButton" Click="OpenSalaryItems" Content="بنود الرواتب" Margin="0,0,8,6"/><Button Click="OpenEmployeeDeductions" Content="كشف استقطاعات موظف" Margin="0,0,8,6" ToolTip="استقطاع جهة واحدة لموظف عبر الأشهر"/><Button Click="OpenSalaryTrust" Content="أمانات الرواتب" Margin="0,0,0,6" ToolTip="أمانات رواتب الكاش غير المستلمة (تحت جهات التنفيذ كما في تقارير الآيفون)"/></WrapPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="14,0,0,14">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource TbgFFF1E3}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{DynamicResource TfgB5640C}" HorizontalAlignment="Center"/></Border>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="الكشوف الخاصة" Margin="0,12,0,0"/>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="بالشكل المعتمد في الآيفون، Excel أو PDF أو طباعة" Margin="0,4,0,14"/>
                  <WrapPanel VerticalAlignment="Bottom"><Button Style="{StaticResource ActionButton}" Tag="fund" Click="OpenSpecialReport" Content="صندوق الشهداء" Margin="0,0,8,6"/><Button Tag="health" Click="OpenSpecialReport" Content="الرعاية الصحية" Margin="0,0,8,6"/><Button Tag="food" Click="OpenSpecialReport" Content="عقد الإطعام" Margin="0,0,0,6"/></WrapPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="14,0,0,14">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource PrimarySoft}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/></Border>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="البنك والتحويلات" Margin="0,12,0,0"/>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="كشف حساب البنك وملفات التحويل والكتب" Margin="0,4,0,14"/>
                  <WrapPanel VerticalAlignment="Bottom"><Button Style="{StaticResource ActionButton}" Tag="bank" Click="Navigate" Content="كشف البنك" Margin="0,0,8,6"/><Button Tag="transfer" Click="Navigate" Content="ملفات التحويل" Margin="0,0,0,6"/></WrapPanel>
                </DockPanel>
              </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource CardTitle}" Text="البيانات المفتوحة"/>
                  <TextBlock x:Name="SnapshotSummary" Style="{StaticResource Hint}" Text="اختر نسخة احتياطية للبدء." Margin="0,6,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button x:Name="StartFromExcelButton" Content="استيراد الملفات" Click="ImportFiles" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="نسخة احتياطية أو ملف رواتب Excel (Ctrl+O)"/>
                  <Button Tag="settings" Click="Navigate" Content="النسخ الاحتياطي"/>
                </WrapPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- جداول البيانات -->
        <Grid x:Name="DataPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
              <TextBox x:Name="SearchBox" Height="38" Padding="34,6,10,6" TextChanged="SearchChanged" Tag="ابحث بالاسم أو الجهة… (Ctrl+F)" KeyDown="SearchKeyDown"/>
              <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource Tfg8A9B98}" FontSize="14" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
            </Grid>
            <WrapPanel Grid.Column="1">
              <Button x:Name="ColumnsButton" Click="ShowColumns" Margin="10,0,0,0" ToolTip="إظهار الأعمدة أو إخفاؤها؛ يُحفظ الاختيار لكل جدول">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Foreground="{DynamicResource Primary}" Margin="0,0,7,0"/><TextBlock Text="الأعمدة"/></StackPanel>
                <Button.ContextMenu><ContextMenu x:Name="ColumnsMenu"/></Button.ContextMenu>
              </Button>
              <Button x:Name="ExportButton" Click="ShowExportMenu" Margin="10,0,0,0" ToolTip="تصدير الجدول المعروض بالشكل المعتمد أو طباعته">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE749;" Foreground="{DynamicResource Primary}" Margin="0,0,7,0"/><TextBlock Text="تصدير وطباعة"/><TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Foreground="{DynamicResource Tfg7A8D8A}" Margin="8,0,0,0"/></StackPanel>
                <Button.ContextMenu>
                  <ContextMenu x:Name="ExportMenu">
                    <MenuItem Header="معاينة الكشف" Click="PreviewTable"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Excel بالشكل المعتمد" Click="ExportTableExcel"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{DynamicResource Tfg1E7145}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="PDF بالشكل المعتمد" Click="ExportTablePdf"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" Foreground="{DynamicResource TfgB03A2E}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="طباعة" Click="PrintTable"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE749;"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem x:Name="ExportCopyMenu" Header="نسخ الصفوف المحددة للصقها في Excel" InputGestureText="Ctrl+C" Click="CopyRows"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;"/></MenuItem.Icon></MenuItem>
                    <Separator x:Name="EntityExportSeparator"/>
                    <MenuItem x:Name="EntityExportMenu" Header="قائمة استقطاعات الجهة المعتمدة">
                      <MenuItem Header="معاينة" Click="PreviewEntity"/>
                      <MenuItem Header="Excel" Click="ExportEntityExcel"/>
                      <MenuItem Header="PDF" Click="ExportEntityPdf"/>
                      <MenuItem Header="طباعة" Click="PrintEntity"/>
                    </MenuItem>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button x:Name="StaffReloadButton" Content="إعادة قراءة الملاك" Click="ReloadStaff" Margin="10,0,0,0" Visibility="Collapsed"/>
            </WrapPanel>
          </Grid>
          <WrapPanel x:Name="FilterBar" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
            <Border Background="{DynamicResource PrimarySoft}" CornerRadius="8" Width="34" Height="34" Margin="0,0,8,0" ToolTip="تصفية سريعة"><TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/></Border>
            <StackPanel x:Name="FilterHost" Orientation="Horizontal"/>
            <Button x:Name="ClearFiltersButton" Style="{StaticResource QuietButton}" Click="ClearFilters" Visibility="Collapsed" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE894;" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="مسح التصفية"/></StackPanel>
            </Button>
          </WrapPanel>
          <TextBlock x:Name="TableStatus" Grid.Row="2" Foreground="{DynamicResource Muted}" Margin="2,10,0,10" TextWrapping="Wrap"/>
          <DataGrid x:Name="DataTable" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" EnableColumnVirtualization="True"
                    SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="OpenArchiveBook" PreviewKeyDown="TableKeyDown" SelectionChanged="TableSelectionChanged">
            <DataGrid.ContextMenu>
              <ContextMenu Opened="RowMenuOpened">
                <MenuItem x:Name="OpenRowMenu" Header="فتح التفاصيل" Click="OpenSelectedRow" FontWeight="SemiBold"/>
                <MenuItem x:Name="SecondRowMenu" Header="تفاصيل أخرى" Click="OpenSecondRow"/>
                <Separator/>
                <MenuItem x:Name="CopyRowsMenu" Header="نسخ الصفوف المحددة" InputGestureText="Ctrl+C" Click="CopyRows"/>
                <MenuItem x:Name="RowEntityMenu" Header="قائمة استقطاعات الجهة المعتمدة">
                  <MenuItem Header="Excel" Click="ExportEntityExcel"/>
                  <MenuItem Header="PDF" Click="ExportEntityPdf"/>
                  <MenuItem Header="طباعة" Click="PrintEntity"/>
                </MenuItem>
              </ContextMenu>
            </DataGrid.ContextMenu>
          </DataGrid>
          <Border x:Name="TotalsBar" Grid.Row="4" Background="{DynamicResource TbgF7FAF9}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,1,1" Padding="14,8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="Ctrl+A تحديد الكل · Ctrl+C نسخ المحدد" Foreground="{DynamicResource Tfg8A9B98}" FontSize="12" VerticalAlignment="Center"/>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8EF;" Foreground="{DynamicResource Primary}" Margin="0,0,8,0"/>
                <TextBlock x:Name="TotalsShown" FontWeight="SemiBold" VerticalAlignment="Center" Text="—"/>
              </StackPanel>
              <TextBlock x:Name="TotalsSelected" Margin="22,0,0,0" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </Border>
        </Grid>

        <!-- الأرشيف: قائمة الكتب حسب الشهر يميناً ومعاينة الكتاب المختار يساراً؛ الزر الأيمن على الكتاب يفتح خيارات التعديل. -->
        <Grid x:Name="ArchivePanel" Visibility="Collapsed" AllowDrop="True" DragOver="ArchiveDragOver" Drop="ArchiveDrop">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ArchiveAddButton" Style="{StaticResource ActionButton}" Click="ArchiveAddFromFile" ToolTip="ملف PDF أو صور الكتاب (من صفحة إلى ثلاث صفحات)">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Foreground="White" Margin="0,0,7,0"/><TextBlock Text="إضافة كتاب من ملف"/></StackPanel>
              </Button>
              <Button x:Name="ArchiveScanButton" Click="ArchiveScan" Margin="8,0,0,0" ToolTip="مسح الكتاب من الطابعة أو الماسح الضوئي المتصل بالحاسبة">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FE;" Foreground="{DynamicResource Primary}" Margin="0,0,7,0"/><TextBlock Text="مسح من الماسح الضوئي"/></StackPanel>
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Grid Width="290">
                <TextBox x:Name="ArchiveSearch" Height="38" Padding="34,6,10,6" TextChanged="ArchiveFilterChanged" Tag="ابحث باسم الكتاب أو الجهة… (Ctrl+F)"/>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource Tfg8A9B98}" FontSize="14" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
              </Grid>
              <ComboBox x:Name="ArchiveMonthFilter" Width="170" Height="38" Margin="8,0,0,0" VerticalContentAlignment="Center" SelectionChanged="ArchiveFilterChanged" ToolTip="عرض كتب شهر واحد"/>
            </StackPanel>
          </Grid>
          <DockPanel Grid.Row="1" Margin="2,10,0,10">
            <TextBlock DockPanel.Dock="Right" Text="الزر الأيمن على الكتاب: فتح، طباعة، تعديل، استبدال، حذف · اسحب ملفات PDF هنا لإضافتها" Foreground="{DynamicResource Tfg8A9B98}" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock x:Name="ArchiveStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
            <!-- القائمة -->
            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,14,0">
              <Grid>
                <ListBox x:Name="ArchiveList" BorderThickness="0" Background="Transparent" SelectionChanged="ArchiveSelectionChanged" MouseDoubleClick="ArchiveDoubleClick" KeyDown="ArchiveKeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel">
                  <ListBox.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                          <DockPanel Margin="8,12,8,6">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource PrimarySoft}" CornerRadius="9" Padding="8,1"><TextBlock Text="{Binding ItemCount, StringFormat={}{0:N0} كتاب}" Foreground="{DynamicResource Primary}" FontSize="12"/></Border>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" Foreground="{DynamicResource Primary}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center"/>
                          </DockPanel>
                        </DataTemplate>
                      </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                  </ListBox.GroupStyle>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Box" CornerRadius="10" Padding="10,8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Cursor="Hand"><ContentPresenter/></Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource TbgEEF3F2}"/></Trigger>
                              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimarySoft}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Primary}"/></Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="46" CornerRadius="7" Background="{DynamicResource TbgFFFFFF}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                          <TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="18" Foreground="{DynamicResource TfgB03A2E}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="8,2" VerticalAlignment="Center" Visibility="{Binding LocalVisibility}" ToolTip="أُضيف أو استُبدل ملفه في ويندوز؛ يدخل في النسخة الاحتياطية التالية">
                          <TextBlock Text="من ويندوز" Foreground="{DynamicResource Accent}" FontSize="11.5"/>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                  <ListBox.ContextMenu>
                    <ContextMenu x:Name="ArchiveMenu" Opened="ArchiveMenuOpened">
                      <MenuItem x:Name="ArchiveOpenItem" Header="فتح الكتاب" Click="ArchiveOpen" FontWeight="SemiBold" InputGestureText="Enter"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8FF;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                      <MenuItem x:Name="ArchivePrintItem" Header="طباعة" Click="ArchivePrint"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE749;"/></MenuItem.Icon></MenuItem>
                      <MenuItem x:Name="ArchiveSaveItem" Header="حفظ نسخة PDF…" Click="ArchiveSaveCopy"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" Foreground="{DynamicResource TfgB03A2E}"/></MenuItem.Icon></MenuItem>
                      <Separator/>
                      <MenuItem x:Name="ArchiveEditItem" Header="تعديل الاسم والشهر والجهة…" Click="ArchiveEdit" InputGestureText="F2"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                      <MenuItem x:Name="ArchiveReplaceItem" Header="استبدال ملف الكتاب">
                        <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;"/></MenuItem.Icon>
                        <MenuItem Header="من ملف PDF أو صور…" Click="ArchiveReplaceFromFile"/>
                        <MenuItem Header="بالمسح من الماسح الضوئي…" Click="ArchiveReplaceScan"/>
                      </MenuItem>
                      <MenuItem x:Name="ArchiveCopyItem" Header="نسخ اسم الكتاب" Click="ArchiveCopyTitle"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;"/></MenuItem.Icon></MenuItem>
                      <Separator/>
                      <MenuItem Header="إضافة كتاب من ملف…" Click="ArchiveAddFromFile"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                      <MenuItem Header="مسح كتاب من الماسح الضوئي…" Click="ArchiveScan"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8FE;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                      <Separator/>
                      <MenuItem x:Name="ArchiveDeleteItem" Header="حذف الكتاب…" Click="ArchiveDelete" Foreground="{DynamicResource TfgB4362A}" InputGestureText="Delete"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{DynamicResource TfgB4362A}"/></MenuItem.Icon></MenuItem>
                    </ContextMenu>
                  </ListBox.ContextMenu>
                </ListBox>
                <StackPanel x:Name="ArchiveEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="20">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="40" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="ArchiveEmptyTitle" Text="لا توجد كتب في الأرشيف بعد" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                  <TextBlock x:Name="ArchiveEmptyText" Text="أضف كتاباً من ملف PDF، أو ضعه في الطابعة واختر «مسح من الماسح الضوئي»." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
              </Grid>
            </Border>
            <!-- معاينة الكتاب المختار -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="16">
              <Grid>
                <DockPanel x:Name="ArchiveDetails">
                  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Style="{StaticResource ActionButton}" Click="ArchiveOpen" HorizontalContentAlignment="Center" Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FF;" Foreground="White" Margin="0,0,7,0"/><TextBlock Text="فتح الكتاب"/></StackPanel>
                    </Button>
                    <UniformGrid Columns="2">
                      <Button Click="ArchivePrint" Margin="0,0,4,8" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE749;" Margin="0,0,7,0"/><TextBlock Text="طباعة"/></StackPanel></Button>
                      <Button Click="ArchiveEdit" Margin="4,0,0,8" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Margin="0,0,7,0"/><TextBlock Text="تعديل"/></StackPanel></Button>
                      <Button Click="ArchiveSaveCopy" Margin="0,0,4,0" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,7,0"/><TextBlock Text="حفظ نسخة"/></StackPanel></Button>
                      <Button Click="ArchiveDelete" Margin="4,0,0,0" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{DynamicResource TfgB4362A}" Margin="0,0,7,0"/><TextBlock Text="حذف" Foreground="{DynamicResource TfgB4362A}"/></StackPanel></Button>
                    </UniformGrid>
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock x:Name="ArchiveTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                      <TextBlock Text="الشهر" Foreground="{DynamicResource Muted}" Margin="0,0,14,4"/><TextBlock x:Name="ArchiveMonth" Grid.Column="1" FontWeight="SemiBold" Margin="0,0,0,4"/>
                      <TextBlock Grid.Row="1" Text="الجهة" Foreground="{DynamicResource Muted}" Margin="0,0,14,4"/><TextBlock x:Name="ArchiveEntity" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                      <TextBlock Grid.Row="2" Text="الصفحات" Foreground="{DynamicResource Muted}" Margin="0,0,14,4"/><TextBlock x:Name="ArchivePages" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Margin="0,0,0,4"/>
                      <TextBlock Grid.Row="3" Text="المصدر" Foreground="{DynamicResource Muted}" Margin="0,0,14,0"/><TextBlock x:Name="ArchiveOrigin" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap"/>
                    </Grid>
                  </StackPanel>
                  <Border Background="{DynamicResource TbgF7FAF9}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="8" Cursor="Hand" MouseLeftButtonUp="ArchiveThumbClicked" ToolTip="انقر لفتح الكتاب">
                    <Grid>
                      <Image x:Name="ArchiveThumb" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                      <TextBlock x:Name="ArchiveThumbText" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Grid>
                  </Border>
                </DockPanel>
                <TextBlock x:Name="ArchiveNoSelection" Text="اختر كتاباً من القائمة لمعاينته." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- كشف البنك: بطاقات الحالة، جدول الكشف بأقسامه (الزر الأيمن لكل الإجراءات)، وفترات المطابقة. -->
        <Grid x:Name="BankPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
              <Button Click="EditBankDetails" ToolTip="اسم الحساب وفرعه ورقمه المحلي وIBAN، ومبالغ الشهر اليدوية">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="{DynamicResource Primary}" Margin="0,0,7,0"/><TextBlock Text="بيانات الحساب والمبالغ اليدوية"/></StackPanel>
              </Button>
              <Button Click="PreviewBankStatement" Margin="8,0,0,0" ToolTip="كشف الشهر بالشكل المعتمد؛ الطباعة والحفظ من الزر الأيمن على الجدول">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FF;" Foreground="{DynamicResource Primary}" Margin="0,0,7,0"/><TextBlock Text="معاينة الكشف"/></StackPanel>
              </Button>
              <Button x:Name="OpenReconciliationButton" Click="OpenReconciliation" Margin="8,0,0,0" IsEnabled="False" Background="{DynamicResource Primary}" BorderBrush="{DynamicResource Primary}" Foreground="White" ToolTip="فترات المطابقة وحركاتها واعتمادها">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE82D;" Foreground="White" Margin="0,0,7,0"/><TextBlock Text="دفتر المطابقة"/></StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="الزر الأيمن على أي سطر لتعديله أو نسخه أو طباعة الكشف" Foreground="{DynamicResource Tfg8A9B98}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border CornerRadius="14" Padding="20,14">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C6E5B" Offset="0"/><GradientStop Color="#0F443B" Offset="1"/></LinearGradientBrush></Border.Background>
              <StackPanel>
                <TextBlock Text="المبلغ للمراجعة مع المصرف" FontSize="13" Foreground="#CDE6DF"/>
                <TextBlock x:Name="BankTotalText" FontSize="30" FontWeight="SemiBold" Foreground="White" Margin="0,4" Text="—"/>
                <TextBlock x:Name="BankNotice" Foreground="#FFD892" TextWrapping="Wrap" FontSize="12.5" MaxHeight="52" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="18,14">
              <StackPanel>
                <TextBlock Text="مطابقة الاستقطاعات التنفيذية" Foreground="{DynamicResource Muted}"/>
                <TextBlock x:Name="BankReconcileText" FontSize="16.5" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="BankReconcileHint" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0" Padding="18,14" Cursor="Hand" MouseLeftButtonUp="OpenLatestPeriod" ToolTip="فتح الفترة في دفتر المطابقة">
              <StackPanel>
                <TextBlock Text="مطابقة الشهر السابق" Foreground="{DynamicResource Muted}"/>
                <TextBlock x:Name="BankLastPeriodText" FontSize="16.5" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" Text="—"/>
                <TextBlock x:Name="BankLastPeriodHint" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Grid>
          <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
            <!-- جدول الكشف -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
              <ListBox x:Name="BankRows" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                       MouseDoubleClick="BankRowDoubleClick" KeyDown="BankRowKeyDown">
                <ListBox.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource TbgF7FAF9}" BorderBrush="{DynamicResource TbgEDF1F2}" BorderThickness="0,1,0,1" Padding="18,7">
                          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="12.5"/>
                        </Border>
                      </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                  </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Box" Padding="18,8" Background="Transparent" BorderBrush="{DynamicResource TbgEDF1F2}" BorderThickness="0,0,0,1"><ContentPresenter/></Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource TbgEEF3F2}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimarySoft}"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="Title" Text="{Binding Title}" Foreground="{DynamicResource Tfg3A524F}" TextTrimming="CharacterEllipsis"/>
                        <Border Margin="8,0,0,0" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="7" Padding="6,0" Visibility="{Binding ManualVisibility}" ToolTip="مبلغ يدوي لهذا الشهر؛ عدّله بالنقر المزدوج أو الزر الأيمن">
                          <TextBlock Text="يدوي" Foreground="{DynamicResource Accent}" FontSize="11.5"/>
                        </Border>
                      </StackPanel>
                      <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsTotal}" Value="True">
                        <Setter TargetName="Title" Property="FontWeight" Value="Bold"/><Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Primary}"/>
                        <Setter TargetName="Value" Property="FontWeight" Value="Bold"/><Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Primary}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsBasis}" Value="True"><Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Muted}"/><Setter TargetName="Value" Property="FontWeight" Value="Normal"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                  <ContextMenu x:Name="BankMenu" Opened="BankMenuOpened">
                    <MenuItem x:Name="BankEditManualItem" Header="تعديل المبلغ اليدوي…" Click="EditBankManual" FontWeight="SemiBold"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="BankCopyAmountItem" Header="نسخ المبلغ" Click="CopyBankAmount"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="BankCopyLineItem" Header="نسخ السطر" Click="CopyBankLine"/>
                    <MenuItem Header="نسخ الكشف كاملاً" Click="CopyBankAll"/>
                    <Separator/>
                    <MenuItem Header="بيانات الحساب والمبالغ اليدوية…" Click="EditBankDetails"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="معاينة الكشف" Click="PreviewBankStatement"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8FF;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="طباعة الكشف" Click="PrintBankStatement"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE749;"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="حفظ الكشف PDF…" Click="SaveBankStatementPdf"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" Foreground="{DynamicResource TfgB03A2E}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="حفظ الكشف Excel…" Click="SaveBankStatementExcel"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{DynamicResource Tfg1E7145}"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="فتح دفتر المطابقة" Click="OpenReconciliation"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE82D;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                  </ContextMenu>
                </ListBox.ContextMenu>
              </ListBox>
            </Border>
            <!-- فترات المطابقة -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="16">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                  <Button DockPanel.Dock="Right" Click="NewReconciliationPeriod" Padding="10,4" ToolTip="فترة مطابقة جديدة">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Foreground="{DynamicResource Primary}" Margin="0,0,6,0"/><TextBlock Text="فترة جديدة"/></StackPanel>
                  </Button>
                  <TextBlock Style="{StaticResource CardTitle}" Text="فترات المطابقة" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="انقر مرتين لفتح الفترة · الزر الأيمن: فتح، معاينة، طباعة" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
                <Grid>
                  <ListBox x:Name="BankPeriods" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="BankPeriodDoubleClick" ItemTemplate="{StaticResource PeriodCardTemplate}" ItemContainerStyle="{StaticResource PeriodCardItem}">
                    <ListBox.ContextMenu>
                      <ContextMenu Opened="BankPeriodMenuOpened">
                        <MenuItem x:Name="BankPeriodOpenItem" Header="فتح الفترة في دفتر المطابقة" Click="OpenSelectedBankPeriod" FontWeight="SemiBold"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE82D;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                        <MenuItem x:Name="BankPeriodPreviewItem" Header="معاينة كشف الفترة" Click="PreviewBankPeriod"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8FF;"/></MenuItem.Icon></MenuItem>
                        <MenuItem x:Name="BankPeriodPrintItem" Header="طباعة كشف الفترة" Click="PrintBankPeriod"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE749;"/></MenuItem.Icon></MenuItem>
                        <MenuItem x:Name="BankPeriodSaveItem" Header="حفظ كشف الفترة PDF…" Click="SaveBankPeriod"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" Foreground="{DynamicResource TfgB03A2E}"/></MenuItem.Icon></MenuItem>
                        <Separator/>
                        <MenuItem Header="فترة جديدة…" Click="NewReconciliationPeriod"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                      </ContextMenu>
                    </ListBox.ContextMenu>
                  </ListBox>
                  <TextBlock x:Name="BankPeriodsEmpty" Text="لا توجد فترات مطابقة بعد؛ أضف فترة جديدة." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>
                </Grid>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- ملفات التحويل -->
        <Grid x:Name="TransferPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="{DynamicResource TbgE8EEED}" CornerRadius="9" Padding="2" HorizontalAlignment="Left">
            <ListBox x:Name="TransferGroupPicker" SelectedIndex="0" SelectionChanged="TransferGroupChanged" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Segment}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBoxItem Tag="rafidain" Content="الرافدين · عدا فرع الأنبار"/>
              <ListBoxItem Tag="other" Content="رشيد ومصارف أخرى"/>
              <ListBoxItem Tag="anbar" Content="الكتب المنفردة · فرع الأنبار"/>
              <ListBoxItem Tag="unresolved" Content="تحتاج تصنيفاً"/>
            </ListBox>
          </Border>
          <Border Grid.Row="1" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource TbgF5DDB8}" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,12,0,12">
            <ScrollViewer MaxHeight="92" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="TransferNotice" Foreground="{DynamicResource Warn}" TextWrapping="Wrap"/><TextBlock x:Name="IssuanceNotice" Foreground="{DynamicResource Tfg8F5510}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></ScrollViewer>
          </Border>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="236"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="TransferTable" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
              <DataGrid.Columns><DataGridTextColumn Header="الجهة" Binding="{Binding Title}" Width="2*" MinWidth="130"/><DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="Auto" MinWidth="90"/><DataGridTextColumn Header="المصرف والفرع" Binding="{Binding Branch}" Width="1.5*" MinWidth="90"/><DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="2*" MinWidth="120"/><DataGridTextColumn Header="المراجعة" Binding="{Binding Issues}" Width="1.5*" MinWidth="90"/></DataGrid.Columns>
              <DataGrid.ContextMenu>
                <ContextMenu FlowDirection="RightToLeft">
                  <MenuItem Header="ربط حساب الجهة" Click="LinkTransferAccount"/>
                  <MenuItem Header="تحديد مجموعة الجهة" Click="ClassifyTransfer"/>
                </ContextMenu>
              </DataGrid.ContextMenu>
            </DataGrid>
            <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <!-- إجراءات كل تبويب منفصلة: التحويل والكتاب للرافدين والمصارف الأخرى، والكتب المنفردة والقوائم لفرع الأنبار، والتصنيف لما يحتاج تصنيفاً. -->
                <Border x:Name="UnresolvedCard" Style="{StaticResource Card}" Padding="14,10,14,12" Margin="0,0,0,10" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="جهات تحتاج تصنيفاً"/>
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" Text="اختر جهة من الجدول ثم اربط حسابها أو حدّد مجموعتها؛ لا يُصدَّر أي ملف تحويل وفيه جهة غير مصنّفة."/>
                  </StackPanel>
                </Border>
                <Border x:Name="GroupCard" Style="{StaticResource Card}" Padding="14,4,14,10" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock x:Name="GroupCardTitle" Style="{StaticResource SectionLabel}" Text="المجموعة المصرفية"/>
                    <Button x:Name="TransferExport" Style="{StaticResource PanelAction}" Content="تصدير ملف التحويل CSV" Click="ExportTransfer" IsEnabled="False"/>
                    <Button Style="{StaticResource PanelButton}" Content="كتاب المجموعة (مسودة)" Click="OpenGroupLetter" ToolTip="مسودة PDF لكتاب المجموعة المختارة"/>
                    <Button Style="{StaticResource PanelButton}" Content="تدقيق إصدار المجموعة" Click="OpenGroupIssuance"/>
                  </StackPanel>
                </Border>
                <Border x:Name="IndividualCard" Style="{StaticResource Card}" Padding="14,4,14,10" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="الكتب المنفردة والقوائم"/>
                    <Button Style="{StaticResource PanelButton}" Content="كتب الرواتب المنفردة" Click="OpenIndividualPayroll"/>
                    <Button Style="{StaticResource PanelButton}" Content="كتب الجهات المنفردة" Click="OpenIndividualEntity"/>
                    <Button Style="{StaticResource PanelButton}" Content="قوائم الأسماء" Click="OpenNameLists"/>
                  </StackPanel>
                </Border>
                <!-- ربط حساب الجهة وتحديد مجموعتها من قائمة النقر الأيمن على الصف فقط (طلب المالك). -->
                <Border x:Name="ReferencesCard" Style="{StaticResource Card}" Padding="14,4,14,10" Margin="0,0,0,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="مراجع الكتب"/>
                    <Button Style="{StaticResource PanelButton}" Content="استيراد مراجع الكتب" Click="ImportReferences"/>
                    <Button Style="{StaticResource PanelButton}" Content="استيراد خط ساكال" Click="ImportSakkalFont"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <!-- الإعدادات -->
        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
          <StackPanel MaxWidth="860" HorizontalAlignment="Left">
            <!-- الاستيراد الموحّد (مثل الآيفون): يتعرف على نوع كل ملف ويفرزه. -->
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource PrimarySoft}" VerticalAlignment="Top"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="18" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                  <TextBlock Style="{StaticResource CardTitle}" Text="استيراد الملفات"/>
                  <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,12" Text="اختر ملفاً أو أكثر معاً، أو اسحبها إلى نافذة البرنامج. يتعرف البرنامج على نوع كل ملف ويفرزه، ثم يُراجع كل ملف قبل حفظه. الملفات الأصلية لا تتغير."/>
                  <WrapPanel Margin="0,0,0,12">
                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="10,4" Margin="0,0,6,6"><TextBlock Text="نسخة احتياطية ZIP" Foreground="{DynamicResource Accent}" FontSize="12.5"/></Border>
                    <Border Background="{DynamicResource PrimarySoft}" CornerRadius="8" Padding="10,4" Margin="0,0,6,6"><TextBlock Text="رواتب واستقطاعات شهر" Foreground="{DynamicResource Primary}" FontSize="12.5"/></Border>
                    <Border Background="{DynamicResource PrimarySoft}" CornerRadius="8" Padding="10,4" Margin="0,0,6,6"><TextBlock Text="استقطاعات سنوية" Foreground="{DynamicResource Primary}" FontSize="12.5"/></Border>
                    <Border Background="{DynamicResource PrimarySoft}" CornerRadius="8" Padding="10,4" Margin="0,0,6,6"><TextBlock Text="حسابات جهات التنفيذ" Foreground="{DynamicResource Primary}" FontSize="12.5"/></Border>
                  </WrapPanel>
                  <WrapPanel><Button x:Name="ImportFilesButton" Style="{StaticResource ActionButton}" Click="ImportFiles" ToolTip="Ctrl+O"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Foreground="White" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="استيراد ملفات…"/></StackPanel></Button></WrapPanel>
                </StackPanel>
              </Grid>
            </Border>
            <!-- النسخ الاحتياطي (مثل الآيفون): ملف واحد يُكتب فوقه بعد كل استيراد أو دورياً، مع الحفظ اليدوي والاسترجاع. -->
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top"><TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="18" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                  <TextBlock Style="{StaticResource CardTitle}" Text="النسخ الاحتياطي"/>
                  <TextBlock x:Name="BackupStatus" FontWeight="Medium" Margin="0,6,0,2" TextWrapping="Wrap"/>
                  <TextBlock x:Name="BackupFileText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                  <!-- خدمة النسخ (مثل الآيفون): ملف يُكتب فوقه، أو السيرفر المحلي نفسه الذي يستعمله الآيفون. -->
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="خدمة النسخ" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="{DynamicResource TbgE8EEED}" CornerRadius="9" Padding="2">
                      <ListBox x:Name="BackupServicePicker" SelectionChanged="BackupServiceChanged" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Segment}">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBoxItem Tag="file" Content="ملف (OneDrive · Google Drive · هذا الجهاز)"/>
                        <ListBoxItem Tag="server" Content="السيرفر المحلي"/>
                      </ListBox>
                    </Border>
                  </StackPanel>
                  <Border x:Name="ServerPanel" Background="{DynamicResource TbgF1F5F4}" CornerRadius="10" Padding="14,12" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                      <TextBlock Text="سيرفر النسخ الاحتياطي" FontWeight="SemiBold"/>
                      <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="عنوان السيرفر" VerticalAlignment="Center"/>
                        <TextBox x:Name="ServerAddressBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center" FlowDirection="LeftToRight" MaxWidth="360" HorizontalAlignment="Left" Width="360" ToolTip="مثال: http://192.168.1.10:8765"/>
                        <TextBlock Grid.Row="2" Text="رمز الوصول" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="ServerTokenBox" Grid.Row="2" Grid.Column="1" Height="34" VerticalContentAlignment="Center" FlowDirection="LeftToRight" MaxWidth="360" HorizontalAlignment="Left" Width="360" ToolTip="الرمز نفسه في إعدادات إضافة Home Assistant وفي الآيفون (٣٢ حرفاً على الأقل)"/>
                      </Grid>
                      <CheckBox x:Name="ServerEnabledBox" Content="تفعيل النسخ إلى السيرفر" Margin="0,12,0,6"/>
                      <CheckBox x:Name="ServerNotifyBox" Content="إشعار عند وجود نسخة أحدث على السيرفر (يظهر في جرس الإشعارات)" Click="ServerNotifyChanged" Margin="0,0,0,10"/>
                      <WrapPanel>
                        <Button Style="{StaticResource ActionButton}" Content="حفظ إعدادات السيرفر" Click="SaveServerSettings" Margin="0,0,8,0"/>
                        <Button x:Name="TestServerButton" Content="اختبار الاتصال" Click="TestServer"/>
                      </WrapPanel>
                      <TextBlock x:Name="ServerTestText" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                      <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Text="نفس السيرفر والرمز المستعملين في الآيفون. الاتصال المحلي HTTP غير مشفّر؛ استعمله على شبكة موثوقة فقط. يحتفظ السيرفر بنسخة واحدة حالية، ويرفض استبدالها بنسخة ينقصها شهر أو قسم كامل، فإذا كانت نسخة الآيفون أحدث استرجعها هنا أولاً. يُحفظ الرمز مشفّراً لحساب ويندوز الحالي ولا يدخل في النسخة."/>
                    </StackPanel>
                  </Border>
                  <WrapPanel Margin="0,0,0,12">
                    <Button x:Name="BackupNowButton2" Style="{StaticResource ActionButton}" Click="BackupNow" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Foreground="White" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="نسخ الآن"/></StackPanel></Button>
                    <Button x:Name="ChooseFileButton" Content="اختيار ملف النسخة…" Click="ChooseBackupFile" Margin="0,0,8,0"/>
                    <Button x:Name="BackupExport" Content="حفظ نسخة في مكان آخر…" Click="ExportBackup" IsEnabled="False"/>
                  </WrapPanel>
                  <CheckBox x:Name="BackupAutoBox" Content="نسخ تلقائي بعد كل استيراد" Click="BackupOptionChanged" Margin="0,0,0,10"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="نسخ دوري" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="{DynamicResource TbgE8EEED}" CornerRadius="9" Padding="2">
                      <ListBox x:Name="BackupSchedulePicker" SelectionChanged="BackupScheduleChanged" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Segment}">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBoxItem Tag="off" Content="متوقف"/>
                        <ListBoxItem Tag="hourly" Content="كل ساعة"/>
                        <ListBoxItem Tag="daily" Content="كل يوم"/>
                      </ListBox>
                    </Border>
                  </StackPanel>
                  <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,12"/>
                  <WrapPanel><Button Click="OpenBackup" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="استرجاع من نسخة…"/></StackPanel></Button><Button x:Name="RestoreServerButton" Click="RestoreFromServer" Visibility="Collapsed" ToolTip="تنزيل آخر نسخة من السيرفر وفتحها بعد فحصها"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="استرجاع من السيرفر"/></StackPanel></Button></WrapPanel>
                  <TextBlock Style="{StaticResource Hint}" FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0" Text="يُكتب الملف المختار في مكانه بعد كل استيراد أو حسب الجدول، ولا يُستبدل بنسخة فقدت أشهراً أو بيانات. اختر مجلداً متزامناً (OneDrive أو Google Drive) لتصل النسخة إلى الآيفون، واسترجعها هناك من «استرجاع من نسخة». النسخة تشمل الأشهر المستوردة والحسابات وروابطها ودفتر المطابقة."/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="البيانات على هذا الجهاز"/>
                <TextBlock Style="{StaticResource Hint}" Text="البيانات والسجلات محفوظة في مجلد حساب ويندوز الحالي. سجل الأخطاء يحتوي نوع الخطأ ومكانه فقط، ويفيد عند الإبلاغ عن مشكلة." Margin="0,8,0,14"/>
                <WrapPanel>
                  <Button Content="فتح مجلد البيانات" Click="OpenDataFolder" Margin="0,0,8,0"/>
                  <Button Content="فتح سجل الأخطاء" Click="OpenLogFolder"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="الأمان"/>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,10" Text="البيانات أسماء وأرقام حسابات؛ إذا كان الجهاز مشتركاً فاقفل البرنامج بكلمة سر وشفّر ملفاته لحساب ويندوز."/>
                <CheckBox x:Name="LockEnabledBox" Content="قفل البرنامج بكلمة سر عند الفتح وبعد عدم الاستخدام" Click="LockEnabledClicked" Margin="0,0,0,8"/>
                <StackPanel x:Name="LockOptions" Margin="24,0,0,0">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="القفل التلقائي بعد" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="LockMinutesBox" Width="150" SelectionChanged="LockMinutesChanged">
                      <ComboBoxItem Tag="5" Content="5 دقائق"/><ComboBoxItem Tag="10" Content="10 دقائق"/><ComboBoxItem Tag="15" Content="15 دقيقة"/><ComboBoxItem Tag="30" Content="30 دقيقة"/><ComboBoxItem Tag="60" Content="ساعة"/><ComboBoxItem Tag="0" Content="عند الفتح فقط"/>
                    </ComboBox>
                  </StackPanel>
                  <CheckBox x:Name="LockHelloBox" Content="السماح بالفتح بـ Windows Hello (البصمة أو الوجه أو رمز PIN)" Click="LockHelloClicked" Margin="0,0,0,8"/>
                  <WrapPanel><Button Content="تغيير كلمة السر" Click="ChangePassword" Margin="0,0,8,0"/><Button Content="قفل الآن (Ctrl+L)" Click="LockNow"/></WrapPanel>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource Line}" Margin="0,14"/>
                <TextBlock x:Name="EncryptStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <WrapPanel><Button x:Name="EncryptButton" Content="تشفير بيانات البرنامج لحساب ويندوز" Click="EncryptData"/></WrapPanel>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" Text="يستعمل تشفير ملفات ويندوز (EFS): تُفتح الملفات من حسابك فقط. غير متاح في ويندوز Home. احتفظ بنسخة احتياطية شاملة؛ إعادة تعيين كلمة سر حساب ويندوز من المسؤول قد تمنع فتح الملفات المشفّرة."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="النسخ المحلية"/>
                <TextBlock x:Name="CopiesText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,10" Text="—"/>
                <WrapPanel><Button x:Name="PruneButton" Content="حذف النسخ الأقدم (يبقى آخر نسختين)" Click="PruneCopies"/></WrapPanel>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" Text="كل نسخة آيفون تُفتح تُحفظ نسخة منها هنا. لا تُحذف النسخة المفتوحة ولا أي نسخة مرتبطة بتعديلات محلية."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="الإصدار والتحديث"/>
                <TextBlock x:Name="VersionStatus" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                <WrapPanel><Button x:Name="CheckUpdateButton" Content="التحقق من وجود تحديث" Click="CheckUpdate" Margin="0,0,8,0"/><Button Content="صفحة التنزيل" Click="OpenReleasePage"/></WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="الخط والأرقام"/>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,10" Text="يتغيّر خط الواجهة وشكل الأرقام فوراً في كل النوافذ. الكشوف المطبوعة وملفات Excel تبقى بالخط والأرقام المعتمدة."/>
                <ComboBox x:Name="FontPicker" Width="420" HorizontalAlignment="Left" SelectionChanged="FontChanged" Margin="0,0,0,12">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Preview}" FontFamily="{Binding Font}" FontWeight="{Binding Weight}" FontSize="15"/>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource Muted}"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Note, Mode=OneWay}"/></TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="الأرقام" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Border Background="{DynamicResource TbgE8EEED}" CornerRadius="9" Padding="2">
                    <ListBox x:Name="DigitsPicker" SelectionChanged="DigitsChanged" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Segment}">
                      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                      <ListBoxItem Tag="latin" Content="إنجليزية  1,234" NumberSubstitution.Substitution="European"/>
                      <ListBoxItem Tag="arabic" Content="هندية  ١٬٢٣٤"/>
                    </ListBox>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="المظهر"/>
                <TextBlock Style="{StaticResource Hint}" Text="الوضع الداكن يريح العين في الإضاءة الخافتة؛ «حسب ويندوز» يتبع إعداد النظام. الكشوف المطبوعة لا تتأثر." Margin="0,6,0,10" TextWrapping="Wrap"/>
<Border Background="{DynamicResource TbgE8EEED}" CornerRadius="9" Padding="2" HorizontalAlignment="Left">
                <ListBox x:Name="ThemePicker" SelectionChanged="ThemeChanged" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Segment}">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBoxItem Tag="light" Content="فاتح"/>
                  <ListBoxItem Tag="dark" Content="داكن"/>
                  <ListBoxItem Tag="system" Content="حسب ويندوز"/>
                </ListBox>
                </Border>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="اختصارات لوحة المفاتيح"/>
                <StackPanel Margin="0,8,0,0">
                  <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource TbgF1F5F4}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+1 … Ctrl+9" FlowDirection="LeftToRight" FontSize="12.5"/></Border><TextBlock Grid.Column="1" Text="التنقل بين الأقسام بترتيب القائمة" Foreground="{DynamicResource Tfg3A524F}" VerticalAlignment="Center"/></Grid>
                  <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource TbgF1F5F4}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+0" FlowDirection="LeftToRight" FontSize="12.5"/></Border><TextBlock Grid.Column="1" Text="الإعدادات" Foreground="{DynamicResource Tfg3A524F}" VerticalAlignment="Center"/></Grid>
                  <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource TbgF1F5F4}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+F" FlowDirection="LeftToRight" FontSize="12.5"/></Border><TextBlock Grid.Column="1" Text="البحث في الجدول" Foreground="{DynamicResource Tfg3A524F}" VerticalAlignment="Center"/></Grid>
                  <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource TbgF1F5F4}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+K" FlowDirection="LeftToRight" FontSize="12.5"/></Border><TextBlock Grid.Column="1" Text="البحث الشامل عن منتسب أو جهة أو قسم" Foreground="{DynamicResource Tfg3A524F}" VerticalAlignment="Center"/></Grid>
                  <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource TbgF1F5F4}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+C" FlowDirection="LeftToRight" FontSize="12.5"/></Border><TextBlock Grid.Column="1" Text="نسخ الصفوف المحددة للصقها في Excel" Foreground="{DynamicResource Tfg3A524F}" VerticalAlignment="Center"/></Grid>
                  <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource TbgF1F5F4}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+O" FlowDirection="LeftToRight" FontSize="12.5"/></Border><TextBlock Grid.Column="1" Text="استيراد الملفات (نسخة احتياطية أو Excel)" Foreground="{DynamicResource Tfg3A524F}" VerticalAlignment="Center"/></Grid>
                  <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource TbgF1F5F4}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+L" FlowDirection="LeftToRight" FontSize="12.5"/></Border><TextBlock Grid.Column="1" Text="قفل البرنامج (عند تفعيل القفل)" Foreground="{DynamicResource Tfg3A524F}" VerticalAlignment="Center"/></Grid>
                  <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource TbgF1F5F4}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="F5" FlowDirection="LeftToRight" FontSize="12.5"/></Border><TextBlock Grid.Column="1" Text="إعادة تحميل الصفحة" Foreground="{DynamicResource Tfg3A524F}" VerticalAlignment="Center"/></Grid>
                  <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource TbgF1F5F4}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="Enter" FlowDirection="LeftToRight" FontSize="12.5"/></Border><TextBlock Grid.Column="1" Text="فتح الصف المختار" Foreground="{DynamicResource Tfg3A524F}" VerticalAlignment="Center"/></Grid>
                  <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource TbgF1F5F4}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="Esc" FlowDirection="LeftToRight" FontSize="12.5"/></Border><TextBlock Grid.Column="1" Text="مسح البحث" Foreground="{DynamicResource Tfg3A524F}" VerticalAlignment="Center"/></Grid>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <!-- دائرة التحميل في وسط الصفحة أثناء احتساب كشف البنك والتحويل والجداول وفتح النسخ. -->
        <Border x:Name="LoadingOverlay" Background="{DynamicResource Page}" Visibility="Collapsed" Panel.ZIndex="50"><local:LoadingSpinner x:Name="LoadingView"/></Border>
        <Border x:Name="UnavailablePanel" Visibility="Collapsed" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock x:Name="UnavailableTitle" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="UnavailableMessage" Margin="0,10,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="14"/></StackPanel></Border>
      </Grid>
      <!-- لوحة الإشعارات تحت الجرس. -->
      <Border x:Name="NotificationPanel" Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="80" HorizontalAlignment="Right" VerticalAlignment="Top" Width="360" Margin="0,-8,0,0" Visibility="Collapsed"
              Background="{DynamicResource TbgFFFFFF}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="14">
        <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.18"/></Border.Effect>
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Click="CloseNotifications" Padding="6,2" MinHeight="24" ToolTip="إغلاق"><TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11"/></Button>
            <TextBlock Text="الإشعارات" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
            <StackPanel>
          <!-- نسخة أحدث على السيرفر رفعها جهاز آخر (الآيفون). -->
          <Border x:Name="ServerNewerCard" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
              <DockPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Foreground="{DynamicResource Warn}" FontSize="14" Margin="0,0,7,0" DockPanel.Dock="Left"/><TextBlock Text="نسخة أحدث على السيرفر" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" FontSize="12.5"/></DockPanel>
              <TextBlock x:Name="ServerNewerText" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/>
              <Button Style="{StaticResource ActionButton}" Content="استرجاع من السيرفر" Click="RestoreFromNotification" Padding="12,6"/>
            </StackPanel>
          </Border>
          <!-- تنبيه الإصدار الأحدث من صفحة الإصدارات. -->
          <Border x:Name="UpdateCard" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource Accent}" FontSize="14" Margin="0,0,7,0"/><TextBlock x:Name="UpdateTitle" Text="إصدار أحدث متاح" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" FontSize="12.5"/></StackPanel>
              <TextBlock Text="نزّل ملف التثبيت وشغّله؛ يُحدّث البرنامج ولا تتأثر البيانات المحلية." FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/>
              <Button Style="{StaticResource ActionButton}" Content="تنزيل التحديث" Click="DownloadUpdate" Padding="12,6"/>
            </StackPanel>
          </Border>
          <!-- تذكير الحفظ: يظهر عند وجود تعديلات محلية لم تدخل نسخة شاملة بعد. -->
          <Border x:Name="BackupReminder" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
              <DockPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Top" DockPanel.Dock="Left"/><TextBlock x:Name="BackupReminderTitle" Text="تعديلات غير محفوظة في نسخة" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" FontSize="12.5"/></DockPanel>
              <TextBlock x:Name="BackupReminderText" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/>
              <Button x:Name="BackupNowButton" Style="{StaticResource ActionButton}" Content="نسخ الآن" Click="BackupNow" Padding="12,6" ToolTip="حفظ نسخة احتياطية شاملة تتضمن التعديلات المحلية"/>
            </StackPanel>
          </Border>
              <!-- النسخ الاحتياطي غير مُعدّ أو فشل آخر نسخ. -->
              <Border x:Name="BackupSetupCard" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                  <DockPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE753;" Foreground="{DynamicResource Warn}" FontSize="14" Margin="0,0,7,0" DockPanel.Dock="Left"/><TextBlock x:Name="BackupSetupTitle" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" FontSize="12.5"/></DockPanel>
                  <TextBlock x:Name="BackupSetupText" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                  <Button x:Name="BackupSetupButton" Style="{StaticResource ActionButton}" Content="اختيار ملف النسخة" Click="BackupSetupClicked" Padding="12,6"/>
                </StackPanel>
              </Border>
              <!-- تنبيهات تدقيق الشهر المهمة. -->
              <Border x:Name="AuditNoticeCard" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                  <DockPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Foreground="{DynamicResource Accent}" FontSize="14" Margin="0,0,7,0" DockPanel.Dock="Left"/><TextBlock x:Name="AuditNoticeTitle" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" FontSize="12.5"/></DockPanel>
                  <TextBlock x:Name="AuditNoticeText" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                  <Button Content="فتح تدقيق الرواتب" Click="OpenAuditFromNotification" Padding="12,6"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="NoNotifications" Text="لا توجد إشعارات. كل شيء محفوظ ومحدّث." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,18"/>
            </StackPanel>
          </ScrollViewer>
        </StackPanel>
      </Border>
      <DockPanel Grid.Row="3" Margin="0,10,0,0">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Foreground="{DynamicResource Tfg8A9B98}" Margin="0,0,7,0"/>
        <TextBlock x:Name="StatusBar" Foreground="{DynamicResource Muted}" FontSize="12" Text="القراءة محلية على جهازك؛ لا توجد مزامنة أو تعديل للنسخة." VerticalAlignment="Center"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
