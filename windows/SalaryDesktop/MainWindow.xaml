<Window x:Class="SalaryDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تطبيق الرواتب — ويندوز" Height="840" Width="1460" MinHeight="660" MinWidth="1080"
        Background="{StaticResource Page}" Foreground="{StaticResource Ink}" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="13.5"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" PreviewKeyDown="WindowKeyDown">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- القائمة الجانبية -->
    <Border Grid.Column="0" Background="#FBFCFC" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,20,14,16">
        <Grid DockPanel.Dock="Top" Margin="4,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource Primary}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource Primary}" Text="تطبيق الرواتب"/>
            <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}" Text="نسخة ويندوز · قيد التطوير"/>
          </StackPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom">
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="settings" Checked="Navigate" ToolTip="Ctrl+0">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Width="28"/><TextBlock Text="الإعدادات"/></StackPanel>
          </RadioButton>
          <Border Background="#F1F5F4" CornerRadius="9" Padding="11,9" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock x:Name="SidebarData" Text="لا توجد بيانات مفتوحة" FontSize="12" FontWeight="SemiBold" Foreground="#38504C" TextWrapping="Wrap"/>
              <TextBlock Text="محفوظة محلياً في حساب ويندوز" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel>
            <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="home" Checked="Navigate" IsChecked="True" ToolTip="Ctrl+1">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Width="28"/><TextBlock Text="الرئيسية"/></StackPanel>
            </RadioButton>
            <TextBlock Style="{StaticResource NavHeader}" Text="البيانات"/>
            <RadioButton x:Name="NavPayroll" Style="{StaticResource NavItem}" Tag="payroll" Checked="Navigate" ToolTip="Ctrl+2">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" Width="28"/><TextBlock Text="الرواتب"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavDeductions" Style="{StaticResource NavItem}" Tag="deductions" Checked="Navigate" ToolTip="Ctrl+3">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE738;" Width="28"/><TextBlock Text="الاستقطاعات"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavStaff" Style="{StaticResource NavItem}" Tag="staff" Checked="Navigate" ToolTip="Ctrl+4">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE716;" Width="28"/><TextBlock Text="الملاك"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavArchive" Style="{StaticResource NavItem}" Tag="archive" Checked="Navigate" ToolTip="Ctrl+5">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" Width="28"/><TextBlock Text="الأرشيف"/></StackPanel>
            </RadioButton>
            <TextBlock Style="{StaticResource NavHeader}" Text="التقارير"/>
            <RadioButton x:Name="NavGroups" Style="{StaticResource NavItem}" Tag="groups" Checked="Navigate" ToolTip="Ctrl+6">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Width="28"/><TextBlock Text="جهات التنفيذ"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavBank" Style="{StaticResource NavItem}" Tag="bank" Checked="Navigate" ToolTip="Ctrl+7">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8EF;" Width="28"/><TextBlock Text="كشف البنك"/></StackPanel>
            </RadioButton>
            <TextBlock Style="{StaticResource NavHeader}" Text="التحويلات"/>
            <RadioButton x:Name="NavTransfer" Style="{StaticResource NavItem}" Tag="transfer" Checked="Navigate" ToolTip="Ctrl+8">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Width="28"/><TextBlock Text="ملفات التحويل"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavAccounts" Style="{StaticResource NavItem}" Tag="accounts" Checked="Navigate" ToolTip="Ctrl+9">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE825;" Width="28"/><TextBlock Text="حسابات الجهات"/></StackPanel>
            </RadioButton>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- المحتوى -->
    <Grid Grid.Column="1" Margin="28,20,28,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" Text="الرئيسية" FontSize="24" FontWeight="Bold"/>
          <TextBlock x:Name="PageSubtitle" Text="ملخص الشهر المختار" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Background="White" BorderBrush="#CFD9DA" BorderThickness="1" CornerRadius="9" Margin="0,0,10,0" VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" Foreground="{StaticResource Primary}" Margin="12,0,2,0"/>
            <ComboBox x:Name="MonthPicker" Grid.Column="1" Width="190" Height="36" BorderThickness="0" Background="Transparent" SelectionChanged="MonthChanged" VerticalContentAlignment="Center" ToolTip="الشهر المعروض"/>
          </Grid>
        </Border>
        <Button Grid.Column="2" Click="OpenBackup" ToolTip="فتح نسخة احتياطية من الآيفون (Ctrl+O)" Padding="14,8">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/><TextBlock Text="فتح نسخة الآيفون"/></StackPanel>
        </Button>
      </Grid>
      <Border x:Name="SourceBanner" Grid.Row="1" Background="{StaticResource AccentSoft}" BorderBrush="#CFE2F8" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="#2C6FB4" Margin="0,0,10,0"/>
          <TextBlock x:Name="SourceMessage" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#2F5873" Text="افتح نسخة احتياطية من الآيفون أو ابدأ من ملف Excel. تُحفظ البيانات محلياً دون تعديل الملف الأصلي."/>
          <Button Grid.Column="2" Style="{StaticResource QuietButton}" Click="HideBanner" ToolTip="إخفاء" Padding="6,2" MinHeight="24" Margin="8,0,0,0">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" Foreground="#4F7491"/>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <!-- الرئيسية -->
        <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border CornerRadius="16" Padding="26,22" Margin="0,0,0,14">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C6E5B" Offset="0"/><GradientStop Color="#0F443B" Offset="1"/></LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="NetLabel" Text="صافي الرواتب للشهر المختار" FontSize="14" Foreground="#CDE6DF"/>
                  <TextBlock x:Name="NetAmount" Text="—" FontSize="40" FontWeight="Bold" Foreground="White" Margin="0,6,0,4"/>
                  <TextBlock x:Name="PayrollCount" Text="لا توجد بيانات مفتوحة" Foreground="#DDEFEA"/>
                  <TextBlock x:Name="DataWarning" TextWrapping="Wrap" Foreground="#FFD892" Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
                </StackPanel>
                <UniformGrid Grid.Column="1" Columns="3" VerticalAlignment="Center" Margin="24,0,0,0">
                  <Border Background="#1AFFFFFF" CornerRadius="12" Padding="16,12" Margin="6,0,0,0" MinWidth="120">
                    <StackPanel><TextBlock Text="المنتسبون" Foreground="#CDE6DF" FontSize="12"/><TextBlock x:Name="HomeEmployees" Text="—" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                  </Border>
                  <Border Background="#1AFFFFFF" CornerRadius="12" Padding="16,12" Margin="6,0,0,0" MinWidth="120">
                    <StackPanel><TextBlock Text="قيود الاستقطاع" Foreground="#CDE6DF" FontSize="12"/><TextBlock x:Name="HomeDeductions" Text="—" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                  </Border>
                  <Border Background="#1AFFFFFF" CornerRadius="12" Padding="16,12" Margin="6,0,0,0" MinWidth="120">
                    <StackPanel><TextBlock Text="الأشهر المحفوظة" Foreground="#CDE6DF" FontSize="12"/><TextBlock x:Name="HomeMonths" Text="—" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                  </Border>
                </UniformGrid>
              </Grid>
            </Border>
            <UniformGrid Columns="3" Margin="0,0,0,0">
              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentSoft}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/></Border>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="التقارير وجهات التنفيذ" Margin="0,12,0,0"/>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="مبالغ الاستقطاع لكل جهة وبنود الرواتب" Margin="0,4,0,14"/>
                  <WrapPanel VerticalAlignment="Bottom"><Button Style="{StaticResource ActionButton}" Tag="groups" Click="Navigate" Content="عرض الجهات" Margin="0,0,8,0"/><Button x:Name="SalaryItemsButton" Click="OpenSalaryItems" Content="بنود الرواتب"/></WrapPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="14,0,0,14">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="9" Background="#FFF1E3" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Foreground="#B5640C" HorizontalAlignment="Center"/></Border>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="تدقيق الرواتب" Margin="0,12,0,0"/>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="فحوص أولية ومقارنة بالشهر السابق" Margin="0,4,0,14"/>
                  <WrapPanel VerticalAlignment="Bottom"><Button x:Name="AuditHomeButton" Style="{StaticResource ActionButton}" Content="فتح التدقيق" Click="OpenSalaryReview"/></WrapPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="14,0,0,14">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="9" Background="{StaticResource PrimarySoft}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Foreground="{StaticResource Primary}" HorizontalAlignment="Center"/></Border>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="البنك والتحويلات" Margin="0,12,0,0"/>
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="كشف حساب البنك وملفات التحويل والكتب" Margin="0,4,0,14"/>
                  <WrapPanel VerticalAlignment="Bottom"><Button Style="{StaticResource ActionButton}" Tag="bank" Click="Navigate" Content="كشف البنك" Margin="0,0,8,0"/><Button Tag="transfer" Click="Navigate" Content="ملفات التحويل"/></WrapPanel>
                </DockPanel>
              </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource CardTitle}" Text="البيانات المفتوحة"/>
                  <TextBlock x:Name="SnapshotSummary" Style="{StaticResource Hint}" Text="اختر نسخة احتياطية للبدء." Margin="0,6,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button x:Name="StartFromExcelButton" Content="بدء بيانات جديدة من Excel" Click="StartFromExcel" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Visibility="Collapsed"/>
                  <Button Tag="settings" Click="Navigate" Content="النسخ الاحتياطي"/>
                </WrapPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- جداول البيانات -->
        <Grid x:Name="DataPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
              <TextBox x:Name="SearchBox" Height="38" Padding="34,6,10,6" TextChanged="SearchChanged" Tag="ابحث بالاسم أو الجهة… (Ctrl+F)" KeyDown="SearchKeyDown"/>
              <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="#8A9B98" FontSize="14" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
            </Grid>
            <WrapPanel Grid.Column="1">
              <Button x:Name="StaffReloadButton" Content="إعادة قراءة الملاك" Click="ReloadStaff" Margin="10,0,0,0" Visibility="Collapsed"/>
              <Button x:Name="AccountImportButton" Content="استيراد حسابات Excel" Click="ImportAccounts" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Visibility="Collapsed"/>
              <Button x:Name="PayrollImportButton" Content="استيراد الرواتب والاستقطاعات" Click="ImportPayroll" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Visibility="Collapsed"/>
              <Button x:Name="AnnualImportButton" Content="الاستقطاعات السنوية" Click="ImportAnnual" Margin="10,0,0,0" Visibility="Collapsed" ToolTip="استيراد ملف استقطاعات سنوي يُقسّم إلى أشهر"/>
            </WrapPanel>
          </Grid>
          <TextBlock x:Name="TableStatus" Grid.Row="1" Foreground="{StaticResource Muted}" Margin="2,10,0,10" TextWrapping="Wrap"/>
          <DataGrid x:Name="DataTable" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" EnableColumnVirtualization="True" SelectionMode="Single" MouseDoubleClick="OpenArchiveBook" PreviewKeyDown="TableKeyDown">
            <DataGrid.ContextMenu>
              <ContextMenu FlowDirection="RightToLeft">
                <MenuItem x:Name="OpenRowMenu" Header="فتح التفاصيل" Click="OpenSelectedRow"/>
              </ContextMenu>
            </DataGrid.ContextMenu>
          </DataGrid>
        </Grid>

        <!-- كشف البنك -->
        <ScrollViewer x:Name="BankPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,14,14" VerticalAlignment="Top">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <Button DockPanel.Dock="Right" Click="EditBankDetails" ToolTip="بيانات الجهة الدافعة والمبالغ اليدوية للشهر">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="تعديل الحساب والمبالغ اليدوية"/></StackPanel>
                  </Button>
                  <TextBlock Style="{StaticResource CardTitle}" Text="تفاصيل المبالغ" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl x:Name="BankRows">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#EDF1F2" BorderThickness="0,0,0,1" Padding="2,9">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Title}" Foreground="#3A524F"/><TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="1">
              <Border CornerRadius="14" Padding="20" Margin="0,0,0,14">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C6E5B" Offset="0"/><GradientStop Color="#0F443B" Offset="1"/></LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                  <TextBlock Text="كشف حساب البنك · مبلغ للمراجعة" FontSize="13" Foreground="#CDE6DF"/>
                  <TextBlock x:Name="BankTotalText" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,8" Text="—"/>
                  <TextBlock x:Name="BankNotice" Foreground="#FFD892" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardTitle}" Text="مطابقة استقطاعات المصارف"/>
                  <TextBlock x:Name="BankReconcileText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                  <Button x:Name="OpenReconciliationButton" Content="دفتر مطابقة الحساب" Click="OpenReconciliation" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,14,0,0" IsEnabled="False"/>
                  <TextBlock Style="{StaticResource Hint}" Text="راجع الحركات والمبالغ المقترحة مع كشف المصرف؛ كشف PDF مسودة تحتاج مراجعة." FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- ملفات التحويل -->
        <Grid x:Name="TransferPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="#E8EEED" CornerRadius="9" Padding="2" HorizontalAlignment="Left">
            <ListBox x:Name="TransferGroupPicker" SelectedIndex="0" SelectionChanged="TransferGroupChanged" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Segment}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBoxItem Tag="rafidain" Content="الرافدين · عدا فرع الأنبار"/>
              <ListBoxItem Tag="other" Content="رشيد ومصارف أخرى"/>
              <ListBoxItem Tag="anbar" Content="الكتب المنفردة · فرع الأنبار"/>
              <ListBoxItem Tag="unresolved" Content="تحتاج تصنيفاً"/>
            </ListBox>
          </Border>
          <Border Grid.Row="1" Background="{StaticResource WarnSoft}" BorderBrush="#F5DDB8" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,12,0,12">
            <StackPanel><TextBlock x:Name="TransferNotice" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/><TextBlock x:Name="IssuanceNotice" Foreground="#8F5510" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
          </Border>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="262"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="TransferTable" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
              <DataGrid.Columns><DataGridTextColumn Header="الجهة" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="*"/><DataGridTextColumn Header="المصرف والفرع" Binding="{Binding Branch}" Width="2*"/><DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="2*"/><DataGridTextColumn Header="المراجعة" Binding="{Binding Issues}" Width="2*"/></DataGrid.Columns>
              <DataGrid.ContextMenu>
                <ContextMenu FlowDirection="RightToLeft">
                  <MenuItem Header="ربط حساب الجهة" Click="LinkTransferAccount"/>
                  <MenuItem Header="تحديد مجموعة الجهة" Click="ClassifyTransfer"/>
                </ContextMenu>
              </DataGrid.ContextMenu>
            </DataGrid>
            <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14,4,14,10" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="المجموعة المصرفية"/>
                    <Button x:Name="TransferExport" Style="{StaticResource PanelAction}" Content="تصدير ملف التحويل CSV" Click="ExportTransfer" IsEnabled="False"/>
                    <Button Style="{StaticResource PanelButton}" Content="كتاب المجموعة · مسودة PDF" Click="OpenGroupLetter"/>
                    <Button Style="{StaticResource PanelButton}" Content="تدقيق إصدار المجموعة" Click="OpenGroupIssuance"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,4,14,10" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="الجهة المختارة في الجدول"/>
                    <Button Style="{StaticResource PanelButton}" Content="ربط حساب الجهة" Click="LinkTransferAccount"/>
                    <Button Style="{StaticResource PanelButton}" Content="تحديد مجموعة الجهة" Click="ClassifyTransfer"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,4,14,10" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="الكتب المنفردة والقوائم"/>
                    <Button Style="{StaticResource PanelButton}" Content="كتب الرواتب المنفردة" Click="OpenIndividualPayroll"/>
                    <Button Style="{StaticResource PanelButton}" Content="كتب الجهات المنفردة" Click="OpenIndividualEntity"/>
                    <Button Style="{StaticResource PanelButton}" Content="قوائم الأسماء" Click="OpenNameLists"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,4,14,10" Margin="0,0,0,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="مراجع الكتب"/>
                    <Button Style="{StaticResource PanelButton}" Content="استيراد مراجع الكتب" Click="ImportReferences"/>
                    <Button Style="{StaticResource PanelButton}" Content="استيراد خط ساكال" Click="ImportSakkalFont"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <!-- الإعدادات -->
        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="860" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="النسخة الاحتياطية"/>
                <TextBlock Style="{StaticResource Hint}" Text="يحفظ البرنامج نسخة محلية بعد فحصها ولا يعدّل ملف الآيفون. تبقى النسخ السابقة على الجهاز عند استيراد نسخة جديدة." Margin="0,8,0,14"/>
                <WrapPanel>
                  <Button x:Name="BackupExport" Style="{StaticResource ActionButton}" Content="حفظ نسخة تشمل التعديلات المحلية" Click="ExportBackup" IsEnabled="False" Margin="0,0,8,0"/>
                  <Button Content="فتح نسخة الآيفون" Click="OpenBackup"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}" FontSize="12.5" Text="تشمل النسخة الأشهر المستوردة والحسابات وروابطها وتصنيف الجهات ودفتر المطابقة. ملفات CSV المحفوظة منفصلة لا تُضاف إليها. اختبر استعادتها على الآيفون قبل الاعتماد." Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="البيانات على هذا الجهاز"/>
                <TextBlock Style="{StaticResource Hint}" Text="البيانات والسجلات محفوظة في مجلد حساب ويندوز الحالي. سجل الأخطاء يحتوي نوع الخطأ ومكانه فقط، ويفيد عند الإبلاغ عن مشكلة." Margin="0,8,0,14"/>
                <WrapPanel>
                  <Button Content="فتح مجلد البيانات" Click="OpenDataFolder" Margin="0,0,8,0"/>
                  <Button Content="فتح سجل الأخطاء" Click="OpenLogFolder"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="اختصارات لوحة المفاتيح"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" LineHeight="22" Text="Ctrl+1 … Ctrl+9 للتنقل بين الأقسام، و Ctrl+0 للإعدادات · Ctrl+F للبحث · Ctrl+O لفتح نسخة · F5 لإعادة تحميل الصفحة · Enter لفتح الصف المختار · Esc لمسح البحث"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border x:Name="UnavailablePanel" Visibility="Collapsed" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock x:Name="UnavailableTitle" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="UnavailableMessage" Margin="0,10,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="14"/></StackPanel></Border>
      </Grid>
      <DockPanel Grid.Row="3" Margin="0,10,0,0">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Foreground="#8A9B98" Margin="0,0,7,0"/>
        <TextBlock x:Name="StatusBar" Foreground="{StaticResource Muted}" FontSize="12" Text="القراءة محلية على جهازك؛ لا توجد مزامنة أو تعديل للنسخة." VerticalAlignment="Center"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
