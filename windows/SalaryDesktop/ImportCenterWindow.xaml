<Window x:Class="SalaryDesktop.ImportCenterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="استيراد الملفات" Width="720" Height="520" MinWidth="560" MinHeight="380" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" FontSize="14"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" ShowInTaskbar="False" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="21" FontWeight="SemiBold" Text="التعرّف على الملفات"/>
    <TextBlock x:Name="Summary" Grid.Row="1" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <Border Grid.Row="2" Background="{DynamicResource TbgFFFFFF}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="Files" Margin="6">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource TbgEDF1F2}" BorderThickness="0,0,0,1" Padding="8,10">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="36" Height="36" CornerRadius="9" Background="{Binding Tint}"><TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Ink}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Border Grid.Column="2" Background="{Binding Tint}" CornerRadius="8" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Kind}" Foreground="{Binding Ink}" FontSize="12.5" FontWeight="Medium"/>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
      <Button x:Name="ImportButton" Style="{StaticResource ActionButton}" Content="استيراد" Click="Confirm" IsDefault="True" MinWidth="110"/>
      <Button Content="إلغاء" IsCancel="True" Margin="10,0,0,0" MinWidth="90"/>
    </StackPanel>
  </Grid>
</Window>
