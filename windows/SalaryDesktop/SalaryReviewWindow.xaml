<Window x:Class="SalaryDesktop.SalaryReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تدقيق الرواتب" Width="1260" Height="820" MinWidth="980" MinHeight="600" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFont}" FontSize="14" Foreground="{DynamicResource Ink}" Background="{DynamicResource Page}">
  <!-- التدقيق (التصميم المعتمد 2026-11-02): الأنواع يميناً بعددها وشدتها، ثم حالات النوع (التكرار حالة لكل رقم)، والنقر يفتح «مكمن الخلل» وجدول المقارنة والخطوة المقترحة. -->
  <Window.Resources>
    <Style x:Key="ToneChip" TargetType="Border">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="7,1"/>
      <Setter Property="Background" Value="{DynamicResource TbgEEF3F2}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="bad"><Setter Property="Background" Value="{DynamicResource DangerSoft}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter Property="Background" Value="{DynamicResource WarnSoft}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="info"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ToneText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="bad"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="info"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PlainList" TargetType="ListBox">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
    </Style>
  </Window.Resources>
  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="Subheading" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Grid Width="270">
          <TextBox x:Name="Search" Height="36" Padding="32,6,10,6" TextChanged="SearchChanged" Tag="بحث بالاسم أو الرقم أو IBAN…"/>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource Tfg8A9B98}" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
        </Grid>
        <Button Click="ExportExcel" Margin="8,0,0,0" ToolTip="كل الحالات وتشخيصها في Excel"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" FontSize="13" Margin="0,0,7,0" Foreground="{DynamicResource Primary}"/><TextBlock Text="Excel"/></StackPanel></Button>
        <Button Click="ExportPdf" Margin="8,0,0,0" ToolTip="الكشف الشامل PDF بالشكل المعتمد"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="13" Margin="0,0,7,0" Foreground="{DynamicResource TfgB03A2E}"/><TextBlock Text="PDF"/></StackPanel></Button>
      </StackPanel>
    </Grid>

    <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,-10,10">
      <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0">
        <StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource DangerSoft}"><TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center"/></Border>
          <StackPanel Margin="12,0,0,0"><TextBlock x:Name="SevereCount" Text="0" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="مشكلات مهمة" FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0">
        <StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource WarnSoft}"><TextBlock Style="{StaticResource Icon}" Text="&#xE890;" Foreground="{DynamicResource Warn}" HorizontalAlignment="Center"/></Border>
          <StackPanel Margin="12,0,0,0"><TextBlock x:Name="ReviewCount" Text="0" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="تحتاج مراجعة" FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0">
        <StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoft}"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border>
          <StackPanel Margin="12,0,0,0"><TextBlock x:Name="ChangeCount" Text="0" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ChangeLabel" Text="تغيّرات الشهر" FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0">
        <StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource TbgEEF3F2}"><TextBlock Style="{StaticResource Icon}" Text="&#xE716;" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/></Border>
          <StackPanel Margin="12,0,0,0"><TextBlock x:Name="StaffCount" Text="0" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="فروقات مع الملاك" FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel>
      </Border>
    </UniformGrid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="0,6" Margin="0,0,10,0">
        <ListBox x:Name="CategoryList" Style="{StaticResource PlainList}" SelectionChanged="CategoryChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Box" Margin="6,1" Padding="10,6" CornerRadius="9" Background="Transparent"><ContentPresenter/></Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource TbgEEF3F2}"/></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="White"/></Trigger>
                      <DataTrigger Binding="{Binding IsHeader}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter TargetName="Box" Property="Background" Value="Transparent"/><Setter TargetName="Box" Property="Padding" Value="10,10,10,2"/></DataTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border x:Name="Chip" Grid.Column="1" Style="{StaticResource ToneChip}" Margin="8,0,0,0"><TextBlock Text="{Binding CountText}" Style="{StaticResource ToneText}"/></Border>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                  <Setter TargetName="Chip" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="Label" Property="FontSize" Value="11.5"/>
                  <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                  <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Tfg8A9B98}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,10,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource TbgE8EEED}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel><TextBlock x:Name="CasesTitle" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="CasesHint" FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
          </Border>
          <Grid>
            <ListBox x:Name="CaseList" Style="{StaticResource PlainList}" SelectionChanged="CaseChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Cursor" Value="Hand"/>
                  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                          <Border x:Name="Box" Padding="14,9" Background="Transparent" BorderBrush="{DynamicResource TbgE8EEED}" BorderThickness="0,0,0,1"><ContentPresenter/></Border>
                          <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" Background="{DynamicResource Primary}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource TbgF7FAF9}"/></Trigger>
                          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimarySoft}"/><Setter TargetName="Marker" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{DynamicResource Danger}" Margin="0,0,7,0" Visibility="{Binding GlyphVisibility}"/>
                      <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" MaxHeight="36"/>
                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,4,0,0" Focusable="False">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource ToneChip}" Margin="0,0,5,2"><TextBlock Text="{Binding Text}" Style="{StaticResource ToneText}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Mono}" Value="True"><Setter TargetName="Title" Property="FontFamily" Value="Consolas"/><Setter TargetName="Title" Property="FlowDirection" Value="LeftToRight"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="CasesEmpty" Text="لا توجد حالات." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Padding="18,14">
            <StackPanel x:Name="Detail"/>
          </ScrollViewer>
          <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="34" Foreground="{DynamicResource TbgC5CFCE}" HorizontalAlignment="Center"/>
            <TextBlock Text="اختر حالة لعرض مكمن الخلل وتفاصيلها" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource TbgCFE2F8}" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="0,10,0,0">
      <DockPanel>
        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource Tfg2C6FB4}" Margin="0,0,8,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="Notes" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Tfg2F5873}"/>
      </DockPanel>
    </Border>
    <Button Width="0" Height="0" IsCancel="True" Click="CloseClicked" Focusable="False" Opacity="0"/>
  </Grid>
</Window>
