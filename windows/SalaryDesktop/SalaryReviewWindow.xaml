<Window x:Class="SalaryDesktop.SalaryReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تدقيق الرواتب الأولي" Width="1120" Height="760" MinWidth="780" MinHeight="520" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI" Background="#F1F4F6">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="Heading" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="Notes" Grid.Row="1" TextWrapping="Wrap" Foreground="#A76716" Margin="0,10"/>
  <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="KindPicker" Height="38" SelectionChanged="FilterChanged"/><TextBox x:Name="Search" Grid.Column="1" Height="38" Margin="12,0,0,0" Padding="8" TextChanged="SearchChanged" ToolTip="البحث بالاسم أو التفاصيل"/></Grid>
  <DataGrid x:Name="Rows" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="White" GridLinesVisibility="Horizontal" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <DataGrid.Columns><DataGridTextColumn Header="الملاحظة" Binding="{Binding Kind}" Width="1.3*"/><DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="1.7*"/><DataGridTextColumn Header="التفاصيل" Binding="{Binding Detail}" Width="2.5*"/><DataGridTextColumn Header="قبل" Binding="{Binding Before}" Width="*"/><DataGridTextColumn Header="بعد" Binding="{Binding After}" Width="*"/></DataGrid.Columns>
  </DataGrid>
  <DockPanel Grid.Row="4" Margin="0,12,0,0"><Button DockPanel.Dock="Left" Content="إغلاق" IsCancel="True" Padding="20,8"/><TextBlock x:Name="Count" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
