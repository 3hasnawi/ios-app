<Window x:Class="SalaryDesktop.PayrollImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="استيراد الرواتب والاستقطاعات" Width="1050" Height="720" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI" Background="#F1F4F6">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="استيراد الرواتب والاستقطاعات" FontSize="23" FontWeight="Bold"/>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12"><TextBlock Text="الشهر والسنة:" VerticalAlignment="Center"/><TextBox x:Name="MonthText" Width="240" Padding="8" Margin="10,0" TextChanged="MonthChanged"/><Button x:Name="Choose" Content="اختيار ملف Excel" Click="ChooseFile" Style="{StaticResource ActionButton}"/></StackPanel>
  <TextBlock x:Name="Notice" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#A76716" Text="اختر الشهر ثم ملف Excel. ستظهر السجلات والأخطاء للمراجعة قبل الحفظ."/>
  <TabControl Grid.Row="3"><TabItem Header="الرواتب"><DataGrid x:Name="Employees" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="الرتبة" Binding="{Binding Rank}" Width="*"/><DataGridTextColumn Header="محل العمل" Binding="{Binding Workplace}" Width="2*"/><DataGridTextColumn Header="الصافي" Binding="{Binding Net, StringFormat={}{0:N0}}" Width="*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="الاستقطاعات"><DataGrid x:Name="Deductions" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="الجهة" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="*"/><DataGridTextColumn Header="الملاحظة" Binding="{Binding Note}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
  <ScrollViewer Grid.Row="4" MaxHeight="110" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Problems"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="#A76716" TextWrapping="Wrap"><Run Text="{Binding Sheet}"/><Run Text=" · الصف "/><Run Text="{Binding Row}"/><Run Text=" · "/><Run Text="{Binding Message}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="SaveButton" Content="حفظ بيانات الشهر" Click="Save" Style="{StaticResource ActionButton}" IsEnabled="False"/><Button Content="إلغاء" IsCancel="True" Padding="16,8" Margin="10,0"/></StackPanel>
 </Grid>
</Window>
