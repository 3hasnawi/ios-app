<Application x:Class="SalaryDesktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- ألوان التطبيق: الأخضر المحاسبي من الآيفون، والأزرق للأفعال الرئيسية. -->
    <SolidColorBrush x:Key="Primary" Color="#135148"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#0D3B34"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSubtle" Color="#F8FAFA"/>
    <SolidColorBrush x:Key="AccountingGridHover" Color="#EDF5F3"/>
    <SolidColorBrush x:Key="AccountingGridLines" Color="#EEF2F2"/>
    <SolidColorBrush x:Key="AccountingGridAlternate" Color="#F9FBFA"/>
    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#135148" Offset="0.0"/>
      <GradientStop Color="#0D3832" Offset="0.55"/>
      <GradientStop Color="#184A63" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimarySoft" Color="#E3EFEC"/>
    <SolidColorBrush x:Key="Violet" Color="#6B4FD8"/>
    <SolidColorBrush x:Key="Danger" Color="#B4362A"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FDECEA"/>
    <SolidColorBrush x:Key="VioletSoft" Color="#EEE9FB"/>
    <SolidColorBrush x:Key="NavGroup" Color="#F4F7F7"/>
    <SolidColorBrush x:Key="Accent" Color="#0877E8"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E7F1FD"/>
    <SolidColorBrush x:Key="Page" Color="#F3F5F6"/>
    <SolidColorBrush x:Key="Line" Color="#E2E8E9"/>
    <SolidColorBrush x:Key="Ink" Color="#172D2B"/>
    <SolidColorBrush x:Key="Muted" Color="#6B7F7C"/>
    <SolidColorBrush x:Key="Warn" Color="#A9620F"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF5E5"/>
    <SolidColorBrush x:Key="WarnLine" Color="#F3D3A8"/>
    <!-- ألوان مشتقة (مولّدة) -->
    <SolidColorBrush x:Key="Tbg0877E8" Color="#0877E8"/>
    <SolidColorBrush x:Key="Tbg0B2420" Color="#0B2420"/>
    <SolidColorBrush x:Key="Tbg7A8D8A" Color="#7A8D8A"/>
    <SolidColorBrush x:Key="Tbg83958F" Color="#83958F"/>
    <SolidColorBrush x:Key="TbgA3B2B0" Color="#A3B2B0"/>
    <SolidColorBrush x:Key="TbgA9B8B9" Color="#A9B8B9"/>
    <SolidColorBrush x:Key="TbgC5CFCE" Color="#C5CFCE"/>
    <SolidColorBrush x:Key="TbgCFD9DA" Color="#CFD9DA"/>
    <SolidColorBrush x:Key="TbgCFE2F8" Color="#CFE2F8"/>
    <SolidColorBrush x:Key="TbgD3DCDD" Color="#D3DCDD"/>
    <SolidColorBrush x:Key="TbgD9EAFB" Color="#D9EAFB"/>
    <SolidColorBrush x:Key="TbgE1E7E8" Color="#E1E7E8"/>
    <SolidColorBrush x:Key="TbgE1E8E7" Color="#E1E8E7"/>
    <SolidColorBrush x:Key="TbgE8EEED" Color="#E8EEED"/>
    <SolidColorBrush x:Key="TbgEDF1F2" Color="#EDF1F2"/>
    <SolidColorBrush x:Key="TbgEEF3F2" Color="#EEF3F2"/>
    <SolidColorBrush x:Key="TbgEFF6F5" Color="#EFF6F5"/>
    <SolidColorBrush x:Key="TbgF1F4F6" Color="#F1F4F6"/>
    <SolidColorBrush x:Key="TbgF1F5F4" Color="#F1F5F4"/>
    <SolidColorBrush x:Key="TbgF4F7F7" Color="#F4F7F7"/>
    <SolidColorBrush x:Key="TbgF5DDB8" Color="#F5DDB8"/>
    <SolidColorBrush x:Key="TbgF7FAF9" Color="#F7FAF9"/>
    <SolidColorBrush x:Key="TbgFAFCFC" Color="#FAFCFC"/>
    <SolidColorBrush x:Key="TbgFBFCFC" Color="#FBFCFC"/>
    <SolidColorBrush x:Key="TbgFFF1E3" Color="#FFF1E3"/>
    <SolidColorBrush x:Key="TbgFFFFFF" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Tfg0D2A3D" Color="#0D2A3D"/>
    <SolidColorBrush x:Key="Tfg135148" Color="#135148"/>
    <SolidColorBrush x:Key="Tfg1E7145" Color="#1E7145"/>
    <SolidColorBrush x:Key="Tfg2C6FB4" Color="#2C6FB4"/>
    <SolidColorBrush x:Key="Tfg2F4744" Color="#2F4744"/>
    <SolidColorBrush x:Key="Tfg2F5873" Color="#2F5873"/>
    <SolidColorBrush x:Key="Tfg38504C" Color="#38504C"/>
    <SolidColorBrush x:Key="Tfg3A524F" Color="#3A524F"/>
    <SolidColorBrush x:Key="Tfg4B625F" Color="#4B625F"/>
    <SolidColorBrush x:Key="Tfg4F7491" Color="#4F7491"/>
    <SolidColorBrush x:Key="Tfg5D716E" Color="#5D716E"/>
    <SolidColorBrush x:Key="Tfg6B7F7C" Color="#6B7F7C"/>
    <SolidColorBrush x:Key="Tfg718481" Color="#718481"/>
    <SolidColorBrush x:Key="Tfg7A8D8A" Color="#7A8D8A"/>
    <SolidColorBrush x:Key="Tfg7C8E8B" Color="#7C8E8B"/>
    <SolidColorBrush x:Key="Tfg8A9B98" Color="#8A9B98"/>
    <SolidColorBrush x:Key="Tfg8F5510" Color="#8F5510"/>
    <SolidColorBrush x:Key="TfgA76716" Color="#A76716"/>
    <SolidColorBrush x:Key="TfgB03A2E" Color="#B03A2E"/>
    <SolidColorBrush x:Key="TfgB4362A" Color="#B4362A"/>
    <SolidColorBrush x:Key="TfgB5640C" Color="#B5640C"/>
    <!-- نهاية الألوان المشتقة -->
    <Style x:Key="FluentCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="InspectorTab" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="TabSurface" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource TbgEEF3F2}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource TbgFFFFFF}"/><Setter Property="Foreground" Value="{DynamicResource Primary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- خط الواجهة الافتراضي (يُستبدل من الإعدادات عبر AppFonts): Regular للنصوص والقوائم، Medium للأزرار، SemiBold للعناوين. -->
    <FontFamily x:Key="AppFont">pack://application:,,,/SalaryDesktop;component/Fonts/#Noto Kufi Arabic, Segoe UI</FontFamily>

    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate><Rectangle Margin="-2" RadiusX="9" RadiusY="9" Stroke="{DynamicResource Tbg0877E8}" StrokeThickness="2" SnapsToDevicePixels="True"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FlowDirection" Value="LeftToRight"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- الأزرار: طبقة شفافة للتمرير والضغط حتى يعمل التأثير على أي لون خلفية. -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TbgD3DCDD}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
              <Grid>
                <Border x:Name="Shade" Background="{DynamicResource Tbg0B2420}" CornerRadius="7" Opacity="0"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shade" Property="Opacity" Value="0.05"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shade" Property="Opacity" Value="0.11"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="18,8"/>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <!-- زر بعرض كامل في لوحات الإجراءات، النص في البداية. -->
    <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="PanelAction" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- القائمة الجانبية (المقترح ١ المعتمد): مجموعات بخلفية خفيفة، لكل قسم أيقونة في مربع ملوّن، والقسم المفتوح شريط أخضر ممتلئ بنص أبيض.
         لون المربع والأيقونة من Tag (مورد ديناميكي)، ويتحول للأبيض في القسم المفتوح. -->
    <Style x:Key="NavTile" TargetType="Border">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True"><Setter Property="Background" Value="#2EFFFFFF"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavGroupBox" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource NavGroup}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <!-- عنصر في القائمة الجانبية يفتح نافذة (مثل أمانات الرواتب) بنفس شكل عناصر الأقسام. -->
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Tfg2F4744}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Pill" CornerRadius="10" Background="Transparent" Padding="6,5"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource TbgE8EEED}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource PrimarySoft}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="Foreground" Value="{DynamicResource Tfg2F4744}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Pill" CornerRadius="10" Background="Transparent" Padding="6,5">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource TbgE8EEED}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Primary}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- زر الإعدادات الصغير في بطاقة الحالة أسفل القائمة. -->
    <Style x:Key="NavGear" TargetType="RadioButton">
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Tfg3A524F}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Box" Width="32" Height="32" CornerRadius="9" Background="{DynamicResource TbgFFFFFF}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TbgC5CFCE}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Primary}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Tfg8A9B98}"/>
      <Setter Property="Margin" Value="8,4,0,2"/>
    </Style>
    <!-- عناصر الرئيسية: بطاقة قابلة للنقر (أداة، خطوة، رقم)، وشريحة «فُتح مؤخراً»، وزر الخطوة التالية. -->
    <Style x:Key="HomeTile" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
              <Grid>
                <Border x:Name="Shade" Background="{DynamicResource Tbg0B2420}" CornerRadius="11" Opacity="0"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shade" Property="Opacity" Value="0.035"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TbgC5CFCE}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shade" Property="Opacity" Value="0.08"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StatCell" TargetType="Button" BasedOn="{StaticResource HomeTile}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,13"/>
    </Style>
    <Style x:Key="ChipButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/>
      <Setter Property="Foreground" Value="{DynamicResource Tfg2F4744}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,6"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="12,4">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TbgEEF3F2}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Primary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,10"/>
    </Style>
    <!-- أزرار مجموعات ملفات التحويل كتبويبات مقسّمة. -->
    <Style x:Key="Segment" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Tfg3A524F}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Seg" CornerRadius="7" Padding="14,7" Margin="2" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Seg" Property="Background" Value="{DynamicResource TbgEEF3F2}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Seg" Property="Background" Value="{DynamicResource TbgFFFFFF}"/>
                <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
                <Setter Property="FontWeight" Value="Medium"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Tfg7C8E8B}"/>
      <Setter Property="Margin" Value="2,12,0,6"/>
    </Style>

    <!-- مربعات النص: حواف مستديرة، ونص إرشادي من Tag عند خلوّها. TextBox يطبّق Padding على النص بنفسه، فلا يُكرر على PART_ContentHost (يقص السطر). -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TbgCFD9DA}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="3,0" Foreground="#98A7A5" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TbgA9B8B9}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderThickness" Value="1.5"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <!-- النص متعدد الأسطر (متن الكتب) يبدأ من الأعلى. -->
        <Trigger Property="AcceptsReturn" Value="True"><Setter Property="VerticalContentAlignment" Value="Top"/></Trigger>
      </Style.Triggers>
    </Style>

    <!-- الجداول: صفوف أعلى، خطوط أفقية خفيفة، وتمرير بالبكسل مع إعادة استخدام الصفوف. -->
    <Style x:Key="AccountingNumberText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="AccountingNetText" TargetType="TextBlock" BasedOn="{StaticResource AccountingNumberText}">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
    </Style>
    <Style x:Key="AccountingDeductionText" TargetType="TextBlock" BasedOn="{StaticResource AccountingNumberText}">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    </Style>
    <Style x:Key="HeaderGripper" TargetType="Thumb">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="SizeWE"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource TbgF4F7F7}"/>
      <Setter Property="Foreground" Value="{DynamicResource Tfg4B625F}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <DockPanel>
                  <Path x:Name="SortArrow" DockPanel.Dock="Right" Width="8" Height="5" Margin="6,0,0,0" Stretch="Fill" Fill="{DynamicResource Tbg7A8D8A}" Data="M0,0 L1,0 0.5,1 Z" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"/>
                  <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </DockPanel>
              </Border>
              <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource HeaderGripper}"/>
              <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource HeaderGripper}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="SortDirection" Value="Ascending">
                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                <Setter TargetName="SortArrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="BorderThickness" Value="0,0,3,0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccountingGridHover}"/></Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource PrimarySoft}"/>
          <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AccountingGridLines}"/>
      <Setter Property="RowHeight" Value="42"/>
      <Setter Property="ColumnHeaderHeight" Value="44"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Setter Property="MinRowHeight" Value="30"/>
      <Setter Property="AlternationCount" Value="2"/>
      <Setter Property="RowBackground" Value="{DynamicResource TbgFFFFFF}"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource AccountingGridAlternate}"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="EnableRowVirtualization" Value="True"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    </Style>

    <!-- القوائم المنسدلة: نفس شكل مربعات النص، وقائمة عائمة بحواف مستديرة. -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ClickMode" Value="Press"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource TbgEEF3F2}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoft}"/><Setter Property="Foreground" Value="{DynamicResource Primary}"/><Setter Property="FontWeight" Value="Medium"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TbgCFD9DA}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"/>
              <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Foreground="{DynamicResource Tfg6B7F7C}" Margin="8,0,0,0"/>
              </Grid>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource TbgFFFFFF}" BorderBrush="{DynamicResource TbgCFD9DA}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                  <ScrollViewer>
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TbgA9B8B9}"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- أشرطة تمرير رفيعة. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Knob" Background="{DynamicResource TbgC5CFCE}" CornerRadius="4"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Background" Value="{DynamicResource TbgA3B2B0}"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Background" Value="{DynamicResource Tbg83958F}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="11"/>
      <Setter Property="MinWidth" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,2">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinHeight="28"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="11"/>
          <Setter Property="MinHeight" Value="11"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                  <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,2">
                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinWidth="28"/></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- التبويبات في النوافذ. -->
    <Style TargetType="TabControl">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <!-- لون العنوان ووزنه على عنوان التبويب فقط؛ لو وُضعا على TabItem لورثهما محتوى التبويب كله. -->
    <Style TargetType="TabItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Tab" Padding="16,8" Margin="0,0,4,0" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" SnapsToDevicePixels="True">
              <ContentPresenter x:Name="Head" ContentSource="Header" HorizontalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource Tfg3A524F}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource TbgEEF3F2}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Head" Property="TextElement.Foreground" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Head" Property="TextElement.FontWeight" Value="Medium"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- القوائم المنبثقة: من اليمين لليسار بخط الواجهة وحافة هادئة. -->
    <Style TargetType="ContextMenu">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FlowDirection" Value="RightToLeft"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TbgD3DCDD}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="3"/>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>
    <!-- عناصر بلا قالب خاص: ألوانها من المظهر الحالي بدل ألوان ويندوز الثابتة. -->
    <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/><Setter Property="BorderBrush" Value="{DynamicResource TbgCFD9DA}"/><Setter Property="Padding" Value="8,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
    <Style TargetType="ListBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
    <Style TargetType="DatePicker"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/><Setter Property="BorderBrush" Value="{DynamicResource TbgCFD9DA}"/></Style>
    <!-- بطاقة فترة مطابقة (صفحة كشف البنك ودفتر المطابقة): الشهر والحالة والمدى والرصيد. -->
    <Style x:Key="PeriodCardItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Box" CornerRadius="10" Padding="12,10" Background="{DynamicResource TbgFFFFFF}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Cursor="Hand"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource TbgEEF3F2}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimarySoft}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Primary}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="PeriodCardTemplate">
      <StackPanel>
        <DockPanel>
          <Border x:Name="Chip" DockPanel.Dock="Right" CornerRadius="9" Padding="8,1" Background="{DynamicResource WarnSoft}">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="Lock" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="11" Margin="0,0,5,0" Foreground="{DynamicResource Primary}" Visibility="Collapsed"/>
              <TextBlock x:Name="ChipText" Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Warn}"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Month}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBlock Text="{Binding Range}" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding Detail}" FontSize="12.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
          <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PrimarySoft}"/>
          <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Primary}"/>
          <Setter TargetName="Lock" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- أنماط النوافذ الثانوية؛ الألوان تتبع المظهر الفاتح والداكن. -->
    <Style x:Key="DialogRootWindow" TargetType="Window">
      <Setter Property="Background" Value="{DynamicResource Page}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FlowDirection" Value="RightToLeft"/><Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style x:Key="DialogHeaderBanner" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18,14"/>
      <Setter Property="Margin" Value="0,0,0,14"/><Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="DialogHeaderIconBox" TargetType="Border">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/><Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{StaticResource HeroGradient}"/><Setter Property="Margin" Value="0,0,14,0"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DialogSectionCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource TbgFFFFFF}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="DialogFooterBar" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource NavGroup}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,14,0,0"/>
    </Style>
    <Style x:Key="FluentFieldInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="10,7"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
  </Application.Resources>
</Application>
