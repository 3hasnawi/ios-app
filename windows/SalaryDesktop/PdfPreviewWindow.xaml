<Window x:Class="SalaryDesktop.PdfPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SalaryDesktop"
        Title="معاينة" Width="980" Height="860" MinWidth="620" MinHeight="460" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" FontSize="14"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" PreviewKeyDown="WindowKeyDown">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource TbgFFFFFF}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource PrimarySoft}"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="InfoText" Foreground="{DynamicResource Muted}" FontSize="12.5" Text="جارٍ تجهيز المعاينة…"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource TbgF1F5F4}" CornerRadius="9" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource QuietButton}" Click="ZoomOut" ToolTip="تصغير (Ctrl −)" Padding="10,6"><TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" FontSize="13"/></Button>
              <TextBlock x:Name="ZoomText" Text="100٪" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center" FontWeight="Medium"/>
              <Button Style="{StaticResource QuietButton}" Click="ZoomIn" ToolTip="تكبير (Ctrl +)" Padding="10,6"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" FontSize="13"/></Button>
              <Button Style="{StaticResource QuietButton}" Click="FitWidth" ToolTip="ملاءمة العرض" Padding="10,6"><TextBlock Style="{StaticResource Icon}" Text="&#xE9A6;" FontSize="13"/></Button>
            </StackPanel>
          </Border>
          <Button x:Name="PrintButton" Click="PrintClicked" Margin="0,0,8,0" IsEnabled="False" ToolTip="Ctrl+P"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE749;" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="طباعة"/></StackPanel></Button>
          <Button x:Name="SaveButton" Style="{StaticResource ActionButton}" Click="SaveClicked" Margin="0,0,8,0" IsEnabled="False" ToolTip="Ctrl+S"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Foreground="White" Margin="0,0,7,0"/><TextBlock Text="حفظ PDF…"/></StackPanel></Button>
          <Button Content="إغلاق" IsCancel="True" Click="CloseClicked"/>
        </StackPanel>
      </Grid>
    </Border>
    <local:LoadingSpinner x:Name="Rendering" Grid.Row="1" Panel.ZIndex="5" Text="جارٍ تجهيز الصفحات…"/>
    <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource TbgE8EEED}" PreviewMouseWheel="ScrollerWheel">
      <ItemsControl x:Name="Pages" Margin="0,18" FlowDirection="LeftToRight">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
              <Border Background="White" HorizontalAlignment="Center">
                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22"/></Border.Effect>
                <Image Source="{Binding Image}" Width="{Binding Width}" Height="{Binding Height}" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Border>
              <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" FlowDirection="RightToLeft"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</Window>
