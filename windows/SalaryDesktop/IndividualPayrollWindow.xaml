<Window Foreground="{DynamicResource Ink}" x:Class="SalaryDesktop.IndividualPayrollWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="الكتب المنفردة من الرواتب" Width="900" Height="650" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" Background="{DynamicResource TbgF1F4F6}">
 <DockPanel Margin="24"><WrapPanel DockPanel.Dock="Bottom" Margin="0,15,0,0"><Button x:Name="SettingsButton" Content="تخصيص الكتاب" Click="OpenSettings" Padding="16,9" Margin="0,0,10,0"/><Button x:Name="PreviewButton" Content="معاينة المسودة" Click="Preview" Padding="16,9" Margin="0,0,10,0" IsEnabled="False"/><Button x:Name="ExportButton" Content="تصدير مسودة PDF" Click="Export" Style="{StaticResource ActionButton}" IsEnabled="False"/><Button Content="إغلاق" IsCancel="True" Padding="18,9" Margin="12,0"/></WrapPanel>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="اختر الكتاب وراجع حساب المستفيد والمبلغ؛ إعدادات الترويسة واللجنة من النسخة المحلية." TextWrapping="Wrap" Foreground="{DynamicResource Tfg718481}" Margin="0,8,0,12"/>
  <ComboBox x:Name="BookPicker" Height="40" DisplayMemberPath="Title" SelectionChanged="BookChanged"/>
  <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource TfgA76716}" Margin="0,12"/>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="المبلغ" Foreground="{DynamicResource Tfg718481}"/><TextBlock x:Name="AmountText" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,12"/><TextBlock Text="حساب المستفيد من المرجع" Foreground="{DynamicResource Tfg718481}"/><TextBlock x:Name="AccountText" FontSize="17" FlowDirection="LeftToRight" TextAlignment="Right" Margin="0,6,0,0"/></StackPanel></Border>
  <TextBlock Text="رقم وتاريخ عقد الإطعام · لمسودة الشركة والضريبة"/><TextBox x:Name="ContractText" Padding="8" Margin="0,5,0,8"/><TextBlock Text="يُستخدم هذا الحقل للمسودة الحالية؛ لا يُحفظ كتخصيص دائم." TextWrapping="Wrap" Foreground="{DynamicResource Tfg718481}"/>
 </StackPanel></ScrollViewer></DockPanel>
</Window>
