<UserControl x:Class="SalaryDesktop.LoadingSpinner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Center">
  <StackPanel>
    <Grid Width="56" Height="56" HorizontalAlignment="Center">
      <Ellipse Stroke="{DynamicResource Line}" StrokeThickness="5"/>
      <!-- قوس دوّار: ربع الدائرة تقريباً (طول المحيط ≈ 32 وحدة من سماكة الخط). -->
      <Ellipse Stroke="{DynamicResource Primary}" StrokeThickness="5" StrokeDashArray="8 40" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform><RotateTransform x:Name="Spin"/></Ellipse.RenderTransform>
      </Ellipse>
    </Grid>
    <TextBlock x:Name="Label" Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" Foreground="{DynamicResource Muted}" FontSize="13.5"/>
  </StackPanel>
</UserControl>
