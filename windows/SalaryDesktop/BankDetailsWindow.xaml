<Window x:Class="SalaryDesktop.BankDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بيانات الحساب والمبالغ اليدوية" Width="760" Height="690" MinWidth="600" MinHeight="520" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" FontSize="14"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" ShowInTaskbar="False">
  <DockPanel Margin="22">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource PrimarySoft}"><TextBlock Style="{StaticResource Icon}" Text="&#xE825;" FontSize="20" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="Heading" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Text="بيانات الحساب مشتركة لكل الأشهر وتظهر في رأس كشف المطابقة؛ المبالغ اليدوية تخص الشهر المختار فقط." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
    </Grid>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button DockPanel.Dock="Left" Content="إلغاء" IsCancel="True" Padding="20,7"/>
      <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Click="Save" IsDefault="True" Padding="18,7">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,7,0" Foreground="White"/><TextBlock Text="حفظ البيانات"/></StackPanel>
      </Button>
      <TextBlock x:Name="Status" Foreground="{DynamicResource Warn}" VerticalAlignment="Center" Margin="14,0" TextWrapping="Wrap"/>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="الحساب"/>
            <TextBlock Text="اسم الحساب (الجهة الدافعة)" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/><TextBox x:Name="PayerText" Height="36" VerticalContentAlignment="Center"/>
            <TextBlock Text="الفرع" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/><TextBox x:Name="BranchText" Height="36" VerticalContentAlignment="Center"/>
            <TextBlock Text="رقم الحساب المحلي" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/><TextBox x:Name="LocalText" Height="36" VerticalContentAlignment="Center" FlowDirection="LeftToRight"/>
            <TextBlock Text="IBAN" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/><TextBox x:Name="IbanText" Height="36" VerticalContentAlignment="Center" FlowDirection="LeftToRight"/>
            <TextBlock Text="عند تغيير IBAN الدافع تُراجع مطابقته مع مراجع الكتب قبل إصدارها." Foreground="{DynamicResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock x:Name="ManualTitle" Style="{StaticResource CardTitle}" Text="المبالغ اليدوية"/>
            <TextBlock Text="الخانة الفارغة تعني صفراً." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/>
            <TextBlock Text="الإجازات المتراكمة" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/><TextBox x:Name="LeaveText" Height="36" VerticalContentAlignment="Center"/>
            <TextBlock Text="مكافآت المنتسبين" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/><TextBox x:Name="RewardsText" Height="36" VerticalContentAlignment="Center"/>
            <TextBlock Text="قائمة مفردة" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/><TextBox x:Name="SingleText" Height="36" VerticalContentAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
