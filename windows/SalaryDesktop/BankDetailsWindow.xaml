<Window x:Class="SalaryDesktop.BankDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="بيانات الحساب والمبالغ اليدوية" Width="780" Height="720" MinWidth="580" MinHeight="520" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI" Background="#F1F4F6">
 <DockPanel Margin="24"><WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="حفظ البيانات" Click="Save" Style="{StaticResource ActionButton}"/><Button Content="إلغاء" IsCancel="True" Padding="18,9" Margin="12,0"/></WrapPanel>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="Heading" FontSize="23" FontWeight="Bold"/><TextBlock Text="الجهة الدافعة وحسابها مشتركان لجميع الأشهر. المبالغ اليدوية تخص الشهر المختار فقط؛ الخانة الفارغة تعني صفراً." Foreground="#718481" TextWrapping="Wrap" Margin="0,8,0,16"/>
 <TextBlock Text="اسم الجهة الدافعة"/><TextBox x:Name="PayerText" Padding="8" Margin="0,4,0,10"/><TextBlock Text="IBAN حساب الجهة الدافعة"/><TextBox x:Name="IbanText" Padding="8" Margin="0,4,0,10" FlowDirection="LeftToRight"/>
 <TextBlock Text="الإجازات المتراكمة"/><TextBox x:Name="LeaveText" Padding="8" Margin="0,4,0,10"/><TextBlock Text="مكافآت المنتسبين"/><TextBox x:Name="RewardsText" Padding="8" Margin="0,4,0,10"/><TextBlock Text="قائمة مفردة"/><TextBox x:Name="SingleText" Padding="8" Margin="0,4,0,10"/>
 <TextBlock Text="عند تغيير IBAN الدافع، تُراجع مطابقته مع مراجع الكتب قبل إصدارها." Foreground="#A76716" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer></DockPanel>
</Window>
