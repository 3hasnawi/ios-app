<Window x:Class="SalaryDesktop.IbanAuditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تدقيق حسابات المنتسبين" Width="1000" Height="700" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="تدقيق حسابات المنتسبين" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="SummaryText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/><TextBlock Text="الفحص لا يؤكد ملكية الحساب أو قبوله لدى المصرف." TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,12"><RadioButton Content="الكل" IsChecked="True" Checked="FilterChanged" Margin="4" Tag="All"/><RadioButton Content="سليم حسابياً" Checked="FilterChanged" Margin="4" Tag="Valid"/><RadioButton Content="تنبيهات وأخطاء" Checked="FilterChanged" Margin="4" Tag="Warning"/><RadioButton Content="بدون حساب" Checked="FilterChanged" Margin="4" Tag="Missing"/></WrapPanel>
    <DataGrid x:Name="Rows" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" RowHeight="NaN" MinRowHeight="38" ColumnHeaderHeight="42"><DataGrid.Columns><DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="الرتبة" Binding="{Binding Rank}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="محل العمل" Binding="{Binding Workplace}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="الصافي" Binding="{Binding Net}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="التدقيق" Binding="{Binding Detail}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/></DataGrid.Columns></DataGrid>
    <Button Grid.Row="3" Content="إغلاق" IsCancel="True" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="20,8"/>
  </Grid>
</Window>
