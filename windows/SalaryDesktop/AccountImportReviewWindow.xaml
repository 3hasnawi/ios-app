<Window Foreground="{DynamicResource Ink}" x:Class="SalaryDesktop.AccountImportReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="مراجعة حسابات Excel" Width="1030" Height="650" MinWidth="780" MinHeight="480" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" Background="{DynamicResource TbgF1F4F6}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock FontSize="23" FontWeight="SemiBold" Text="مراجعة ملف الحسابات"/><TextBlock x:Name="Notice" Grid.Row="1" Margin="0,10,0,10" TextWrapping="Wrap" Foreground="{DynamicResource TfgA76716}"/>
  <DataGrid x:Name="Accounts" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column" Background="{DynamicResource TbgFFFFFF}" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="الجهة" Binding="{Binding Entity}" Width="2*"/><DataGridTextColumn Header="المصرف والفرع" Binding="{Binding Branch}" Width="2*"/><DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="2*"/><DataGridTextColumn Header="الحساب المحلي" Binding="{Binding LocalAccount}" Width="*"/><DataGridTextColumn Header="SWIFT" Binding="{Binding Swift}" Width="*"/></DataGrid.Columns></DataGrid>
  <ScrollViewer Grid.Row="3" MaxHeight="130" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Problems"><ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TfgA76716}"><Run Text="{Binding Sheet}"/><Run Text=" · الصف "/><Run Text="{Binding Row}"/><Run Text=" · "/><Run Text="{Binding Message}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="Apply" Content="حفظ الحسابات" Click="Save" Style="{StaticResource ActionButton}"/><Button Content="إلغاء" IsCancel="True" Padding="16,8" Margin="10,0"/></StackPanel>
 </Grid>
</Window>
