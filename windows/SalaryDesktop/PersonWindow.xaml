<Window x:Class="SalaryDesktop.PersonWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ملف المنتسب" Width="1280" Height="780" MinWidth="1060" MinHeight="580" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" FontSize="14"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <DataTemplate x:Key="LineTemplate">
      <Border BorderBrush="{DynamicResource TbgEDF1F2}" BorderThickness="0,0,0,1" Padding="0,7">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Tfg3A524F}" TextWrapping="Wrap"/><TextBlock Text="{Binding Note}" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap"/></StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Top"/>
        </Grid>
      </Border>
    </DataTemplate>
    <!-- سطر بيانات الراتب مع زر نسخ للقيمة. -->
    <DataTemplate x:Key="InfoTemplate">
      <Border BorderBrush="{DynamicResource TbgEDF1F2}" BorderThickness="0,0,0,1" Padding="0,5">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Padding="6,2" MinHeight="22" Margin="6,0,0,0" Tag="{Binding Value}" Click="CopyValue" ToolTip="نسخ"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="11"/></Button>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" FlowDirection="LeftToRight" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
          <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Tfg3A524F}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="24,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="54" Height="54" CornerRadius="14" Background="{DynamicResource PrimarySoft}">
        <TextBlock x:Name="Initial" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="NameText" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="IdentityText" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Grid>
    <TextBlock x:Name="Notice" Grid.Row="1" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <TabControl x:Name="Tabs" Grid.Row="2" Margin="0,12,0,0" Background="Transparent" BorderThickness="0,1,0,0">
      <TabItem x:Name="PayslipTab" Header="القسيمة">
        <!-- لوحة المنتسب (التصميم ٢ المعتمد): الأشهر يميناً، القسيمة في الوسط، البيانات والإجراءات يساراً. -->
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
          <!-- الأشهر: الصافي وسهم التغيّر عن الشهر السابق. -->
          <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="12,14">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="الأشهر" Margin="4,0,0,8"/>
              <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="12" Text="الصافي كل شهر؛ السهم = تغيّر عن الشهر السابق" TextWrapping="Wrap" Margin="4,8,0,0"/>
              <ListBox x:Name="MonthList" BorderThickness="0" Background="Transparent" SelectionChanged="MonthChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Box" CornerRadius="9" Padding="10,7" Background="Transparent" Cursor="Hand"><ContentPresenter/></Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource TbgEEF3F2}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimarySoft}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <TextBlock x:Name="Arrow" DockPanel.Dock="Left" Text="{Binding Arrow}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontWeight="Normal"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Month}"/>
                        <TextBlock Text="{Binding NetText}" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Normal"/>
                      </StackPanel>
                    </DockPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Trend}" Value="up"><Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Primary}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Trend}" Value="down"><Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource TfgB4362A}"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <!-- القسيمة: المخصصات واستقطاعات جهات التنفيذ (ملف الاستقطاعات) ثم الصافي. -->
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
              <TextBlock x:Name="SlipTitle" DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
              <!-- الصافي أسفل القسيمة. -->
              <Border DockPanel.Dock="Bottom" CornerRadius="12" Padding="18,12" Margin="0,12,0,0">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C6E5B" Offset="0"/><GradientStop Color="#0F443B" Offset="1"/></LinearGradientBrush></Border.Background>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="NetLabel" Text="صافي الراتب" Foreground="#CDE6DF" VerticalAlignment="Center"/>
                  <TextBlock x:Name="NetText" Grid.Column="1" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                  <TextBlock x:Name="DeltaText" Grid.Column="2" Foreground="White" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="المخصصات" Margin="0,0,0,2"/>
                    <ItemsControl x:Name="AllowanceList" ItemTemplate="{StaticResource LineTemplate}"/>
                    <Grid Margin="0,8,0,0"><TextBlock Text="الاستحقاق" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/><TextBlock x:Name="GrossText" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/></Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="استقطاعات جهات التنفيذ (ملف الاستقطاعات)" Margin="0,0,0,2"/>
                    <ItemsControl x:Name="EntityList" ItemTemplate="{StaticResource LineTemplate}"/>
                    <TextBlock x:Name="NoEntities" Text="لا توجد استقطاعات جهات لهذا الشهر." Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed"/>
                    <Grid Margin="0,8,0,0"><TextBlock Text="المجموع" FontWeight="SemiBold" Foreground="{DynamicResource TfgB4362A}"/><TextBlock x:Name="DeductionTotalText" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TfgB4362A}"/></Grid>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <!-- يساراً: تنبيه التغيّر، بيانات الراتب مع النسخ، والإجراءات. -->
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
              <Border x:Name="ChangeAlert" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                  <DockPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" FontSize="13" Margin="0,0,6,0" DockPanel.Dock="Left"/><TextBlock x:Name="ChangeTitle" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" FontSize="13"/></DockPanel>
                  <TextBlock x:Name="ChangeText" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,4"/>
                  <Button Style="{StaticResource QuietButton}" Content="عرض كل التغيّرات" Click="ShowChanges" HorizontalAlignment="Left" Padding="4,2"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardTitle}" Text="بيانات الراتب"/>
                  <ItemsControl x:Name="InfoList" ItemTemplate="{StaticResource InfoTemplate}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Button x:Name="PdfButton" Style="{StaticResource ActionButton}" Click="OpenPayslipMenu" HorizontalContentAlignment="Center" Margin="0,0,0,8" ToolTip="قسيمة الشهر المعروض: معاينة أو حفظ PDF أو طباعة">
                    <Button.ContextMenu>
                      <ContextMenu x:Name="PayslipMenu">
                        <MenuItem Header="معاينة القسيمة" Click="PreviewPayslip"/>
                        <MenuItem Header="حفظ القسيمة PDF…" Click="ExportPayslip"/>
                        <MenuItem Header="طباعة القسيمة" Click="PrintPayslip"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="13" Margin="0,0,7,0" Foreground="White"/><TextBlock Text="القسيمة PDF"/><TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="7,1,0,0" Foreground="White"/></StackPanel>
                  </Button>
                  <Button x:Name="ReportButton" Click="OpenReportMenu" HorizontalContentAlignment="Center" Margin="0,0,0,8" ToolTip="تقرير راتب الشهر المعروض بشكل «برنامج الرواتب الالكتروني الموحد»">
                    <Button.ContextMenu>
                      <ContextMenu x:Name="ReportMenu">
                        <MenuItem x:Name="HideZerosItem" Header="إخفاء البنود الصفرية" IsCheckable="True" Click="ReportOptionChanged"/>
                        <MenuItem x:Name="HidePersonalItem" Header="إخفاء IBAN والأرقام الشخصية" IsCheckable="True" Click="ReportOptionChanged"/>
                        <Separator/>
                        <MenuItem Header="معاينة تقرير الراتب" Click="PreviewSalaryReport"/>
                        <MenuItem Header="حفظ تقرير الراتب PDF…" Click="SaveSalaryReport"/>
                        <MenuItem Header="طباعة تقرير الراتب" Click="PrintSalaryReport"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="تقرير الراتب"/><TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="7,1,0,0"/></StackPanel>
                  </Button>
                  <Button x:Name="DeductionStatementButton" Click="OpenDeductionStatement" HorizontalContentAlignment="Center" Margin="0,0,0,8" ToolTip="كشف استقطاعات جهة واحدة عبر الأشهر">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A1;" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="كشف الاستقطاعات"/></StackPanel>
                  </Button>
                  <Button Click="CopySummary" HorizontalContentAlignment="Center" Margin="0,0,0,8" ToolTip="نسخ ملخص القسيمة">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="نسخ الملخص"/></StackPanel>
                  </Button>
                  <Button Click="ShowStaff" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="سجل الملاك"/></StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="الاستقطاعات عبر الأشهر">
        <DockPanel Margin="0,14,0,0">
          <TextBlock x:Name="HistoryStatus" DockPanel.Dock="Bottom" Foreground="{DynamicResource Muted}" Margin="2,8,0,0"/>
          <DataGrid x:Name="HistoryTable" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader">
            <DataGrid.Columns>
              <DataGridTextColumn Header="الشهر" Binding="{Binding Month}" Width="*"/>
              <DataGridTextColumn Header="جهة التنفيذ" Binding="{Binding Title}" Width="2*"/>
              <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:#,0.##}, TargetNullValue=غير محتسب}" Width="*"/>
              <DataGridTextColumn Header="الملاحظة" Binding="{Binding Note}" Width="2*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="StaffTab" Header="سجل الملاك">
        <DockPanel Margin="0,14,0,0">
          <TextBlock x:Name="StaffStatus" DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" Margin="2,0,0,8" TextWrapping="Wrap"/>
          <DataGrid x:Name="StaffTable" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader">
            <DataGrid.Columns>
              <DataGridTextColumn Header="القسم" Binding="{Binding Section}" Width="*"/>
              <DataGridTextColumn Header="الحقل" Binding="{Binding Label}" Width="1.4*"/>
              <DataGridTextColumn Header="القيمة" Binding="{Binding Value}" Width="2*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="ChangesTab" Header="التغيّرات مع الشهر السابق">
        <DockPanel Margin="0,14,0,0">
          <TextBlock x:Name="ChangesStatus" DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" Margin="2,0,0,8" TextWrapping="Wrap"/>
          <DataGrid x:Name="ChangesTable" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader">
            <DataGrid.Columns>
              <DataGridTextColumn Header="البند" Binding="{Binding Title}" Width="2*"/>
              <DataGridTextColumn Header="الشهر السابق" Binding="{Binding Before}" Width="*"/>
              <DataGridTextColumn Header="الشهر المعروض" Binding="{Binding After}" Width="*"/>
              <DataGridTextColumn Header="الفرق" Binding="{Binding Difference}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button DockPanel.Dock="Left" Content="إغلاق" IsCancel="True" Click="CloseWindow" Padding="20,7"/>
      <TextBlock Text="عرض محلي للقراءة؛ قارن مع الآيفون قبل الاعتماد." Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
    </DockPanel>
  </Grid>
</Window>
