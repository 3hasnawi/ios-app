<Window x:Class="SalaryDesktop.SpecialReportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SalaryDesktop"
        Title="كشف خاص" Width="1180" Height="800" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" FontSize="14"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" SnapsToDevicePixels="True" TextOptions.TextRenderingMode="ClearType" Typography.NumeralAlignment="Tabular">
  <Window.Resources>
    <Style x:Key="Cell" TargetType="TextBlock"><Setter Property="Padding" Value="0,4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- الرأس: اسم الكشف والشهر وبطاقة المجموع (مثل صفحة البند في الآيفون). -->
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="52" Height="52" CornerRadius="13" Background="{DynamicResource PrimarySoft}"><TextBlock x:Name="KindIcon" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="SubHeading" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
      </StackPanel>
      <Border Grid.Column="2" CornerRadius="14" Padding="22,12" MinWidth="260">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C6E5B" Offset="0"/><GradientStop Color="#0F443B" Offset="1"/></LinearGradientBrush></Border.Background>
        <StackPanel>
          <TextBlock Text="المجموع" Foreground="#CFE8DF" FontSize="12.5"/>
          <TextBlock x:Name="TotalText" Text="—" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock x:Name="CountText" Foreground="#CFE8DF" FontSize="12.5"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- الملخص بحسب نوع الكشف. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
        <StackPanel>
          <!-- صندوق الشهداء: حسب الفئة -->
          <Border x:Name="FundCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="حسب الفئة"/>
              <Grid Margin="0,10,0,4" TextElement.Foreground="{DynamicResource Muted}" TextElement.FontSize="12.5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                <TextBlock Text="الفئة"/><TextBlock Grid.Column="1" Text="العدد"/><TextBlock Grid.Column="2" Text="المقرر"/><TextBlock Grid.Column="3" Text="المجموع"/>
              </Grid>
              <ItemsControl x:Name="FundRows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource TbgEDF1F2}" BorderThickness="0,0,0,1">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Cell}" Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Cell}" Grid.Column="1" Text="{Binding Count}"/>
                        <TextBlock Style="{StaticResource Cell}" Grid.Column="2" Text="{Binding Rate}" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Style="{StaticResource Cell}" Grid.Column="3" Text="{Binding Total}" FontWeight="SemiBold"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                <TextBlock Text="المجموع" FontWeight="SemiBold"/><TextBlock x:Name="FundCount" Grid.Column="1" FontWeight="SemiBold"/><TextBlock x:Name="FundTotal" Grid.Column="3" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
              </Grid>
            </StackPanel>
          </Border>
          <!-- عقد الإطعام: حسب مبلغ الاستقطاع ثم تفاصيل النسبة -->
          <Border x:Name="FoodCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="عقد الإطعام: حسب مبلغ الاستقطاع"/>
              <Grid Margin="0,10,0,4" TextElement.Foreground="{DynamicResource Muted}" TextElement.FontSize="12.5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                <TextBlock Text="المشتركون"/><TextBlock Grid.Column="1" Text="المبلغ"/><TextBlock Grid.Column="2" Text="المجموع"/>
              </Grid>
              <ItemsControl x:Name="FoodRows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource TbgEDF1F2}" BorderThickness="0,0,0,1">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Cell}" Text="{Binding Count}"/>
                        <TextBlock Style="{StaticResource Cell}" Grid.Column="1" Text="{Binding Amount}"/>
                        <TextBlock Style="{StaticResource Cell}" Grid.Column="2" Text="{Binding Total}" FontWeight="SemiBold"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FoodCount" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="الإجمالي" FontWeight="SemiBold"/><TextBlock x:Name="FoodTotal" Grid.Column="2" FontWeight="SemiBold"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border x:Name="SplitCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="تفاصيل النسبة" Margin="0,0,0,6"/>
              <ItemsControl x:Name="SplitRows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource TbgEDF1F2}" BorderThickness="0,0,0,1" Padding="0,3">
                      <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="{Binding Weight}" Margin="10,0,0,0"/><TextBlock Text="{Binding Label}" Style="{StaticResource Cell}"/></DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <!-- الرعاية الصحية: المبالغ الشاذة ثم الأعداد والعائلات -->
          <Border x:Name="IrregularCard" Style="{StaticResource Card}" Visibility="Collapsed" BorderBrush="{DynamicResource WarnLine}" Background="{DynamicResource WarnSoft}">
            <StackPanel>
              <DockPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" Margin="0,0,8,0"/><TextBlock x:Name="IrregularTitle" Style="{StaticResource CardTitle}" Foreground="{DynamicResource Warn}"/></DockPanel>
              <ItemsControl x:Name="IrregularRows" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource WarnLine}" BorderThickness="0,0,0,1" Padding="0,4">
                      <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{DynamicResource Warn}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Note}" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel></DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,0" Text="الكشف لا يقبل الكسور: راجع هذه المبالغ في ملف الرواتب. تظهر في الملف المصدّر بخانة حمراء."/>
            </StackPanel>
          </Border>
          <Border x:Name="HealthCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="الرعاية الصحية: 3,500 لكل فرد" Margin="0,0,0,6"/>
              <ItemsControl x:Name="HealthRows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource TbgEDF1F2}" BorderThickness="0,0,0,1" Padding="0,3">
                      <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="{Binding Weight}" Margin="10,0,0,0"/><TextBlock Text="{Binding Label}" Style="{StaticResource Cell}"/></DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- الأسماء -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="14">
        <Grid>
          <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
            <TabItem x:Name="NamesTab" Header="الأسماء">
              <DataGrid x:Name="Names" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"  EnableRowVirtualization="True" Margin="0,8,0,0" RowHeight="40" ColumnHeaderHeight="42" AlternatingRowBackground="{DynamicResource AccountingGridAlternate}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource AccountingGridLines}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ت" Binding="{Binding Index}" Width="55"/>
                  <DataGridTextColumn Header="الرتبة" Binding="{Binding Rank}" Width="*"/>
                  <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2.4*"/>
                  <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="*"/>
                  <DataGridTextColumn x:Name="ExtraColumn" Header="محل العمل" Binding="{Binding Extra}" Width="1.8*"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem x:Name="OthersTab" Header="غير المشتركين" Visibility="Collapsed">
              <DataGrid x:Name="Others" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"  EnableRowVirtualization="True" Margin="0,8,0,0" RowHeight="40" ColumnHeaderHeight="42" AlternatingRowBackground="{DynamicResource AccountingGridAlternate}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource AccountingGridLines}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ت" Binding="{Binding Index}" Width="55"/>
                  <DataGridTextColumn Header="الرتبة" Binding="{Binding Rank}" Width="*"/>
                  <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2.4*"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>
          <local:LoadingSpinner x:Name="Loading" Text="جارٍ إعداد الكشف…"/>
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <Button DockPanel.Dock="Left" Content="إغلاق" IsCancel="True" Padding="20,8"/>
      <TextBlock x:Name="Notice" DockPanel.Dock="Left" Foreground="{DynamicResource Warn}" VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap"/>
      <WrapPanel x:Name="Actions" IsEnabled="False">
        <Button Click="PreviewReport" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ReportActionIcon}" Text="{StaticResource PreviewActionGlyph}" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="معاينة الكشف"/></StackPanel></Button>
        <Button Style="{StaticResource ActionButton}" Click="ExportExcel" Margin="0,0,8,0" Content="Excel" ContentTemplate="{StaticResource ExcelActionContent}"/>
        <Button Style="{StaticResource ActionButton}" Click="ExportPdf" Margin="0,0,8,0" Content="PDF" ContentTemplate="{StaticResource PdfActionContent}"/>
        <Button Click="PrintReport" Margin="0,0,18,0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ReportActionIcon}" Text="{StaticResource PrintActionGlyph}" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="طباعة"/></StackPanel></Button>
        <Button Click="PreviewNames" ToolTip="قائمة أسماء البند بالشكل المعتمد" Content="معاينة قائمة الأسماء" ContentTemplate="{StaticResource PreviewActionContent}"/>
      </WrapPanel>
    </DockPanel>
  </Grid>
</Window>
