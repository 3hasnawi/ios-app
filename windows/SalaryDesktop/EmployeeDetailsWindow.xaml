<Window Foreground="{DynamicResource Ink}" x:Class="SalaryDesktop.EmployeeDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تفاصيل الراتب" Width="850" Height="680" MinWidth="600" MinHeight="450" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" Background="{DynamicResource TbgF1F4F6}" WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" Typography.NumeralAlignment="Tabular">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource DialogHeaderBanner}"><TextBlock x:Name="NameText" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Tfg135148}"/></Border>
    <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,8,0,14" Foreground="{DynamicResource Tfg718481}" TextWrapping="Wrap"/>
    <DataGrid x:Name="DetailTable" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column" Background="{DynamicResource TbgFFFFFF}"  EnableRowVirtualization="True" RowHeight="40" ColumnHeaderHeight="42" AlternatingRowBackground="{DynamicResource AccountingGridAlternate}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource AccountingGridLines}">
      <DataGrid.Columns><DataGridTextColumn Header="القسم" Binding="{Binding Section}" Width="*"/><DataGridTextColumn Header="البيان" Binding="{Binding Key}" Width="2*"/><DataGridTextColumn Header="القيمة" Binding="{Binding Value}" Width="2*"/></DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="3" Style="{StaticResource DialogFooterBar}"><Button Content="إغلاق" IsCancel="True" HorizontalAlignment="Left" Padding="20,7"/></Border>
  </Grid>
</Window>
