<Window x:Class="SalaryDesktop.EmployeeDeductionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SalaryDesktop"
        Title="كشف استقطاعات موظف" Width="1120" Height="780" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" FontSize="14"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" SnapsToDevicePixels="True" TextOptions.TextRenderingMode="ClearType" Typography.NumeralAlignment="Tabular">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- الرأس وبطاقة المجموع (مثل صفحة كشف الاستقطاعات في الآيفون). -->
    <Border Style="{StaticResource DialogHeaderBanner}"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="52" Height="52" CornerRadius="13" Background="{StaticResource HeroGradient}"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A1;" FontSize="22" Foreground="White" HorizontalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="كشف استقطاعات موظف" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="SubHeading" Text="استقطاع جهة واحدة عبر الأشهر، حسب الفترة" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <Border Grid.Column="2" CornerRadius="14" Padding="22,12" MinWidth="280">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C6E5B" Offset="0"/><GradientStop Color="#0F443B" Offset="1"/></LinearGradientBrush></Border.Background>
        <StackPanel>
          <TextBlock x:Name="TotalLabel" Text="مجموع الاستقطاعات" Foreground="#CFE8DF" FontSize="12.5"/>
          <TextBlock x:Name="TotalText" Text="—" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock x:Name="EntityText" Foreground="#CFE8DF" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
        </StackPanel>
      </Border>
    </Grid></Border>

    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- بيانات الكشف: الموظف، الجهة، الفترة. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="بيانات الكشف"/>
              <TextBlock Text="الموظف" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/>
              <Border x:Name="PersonCard" Background="{DynamicResource PrimarySoft}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="تغيير" Click="ChangePerson" Padding="10,3" MinHeight="26"/>
                  <StackPanel>
                    <TextBlock x:Name="PersonName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PersonDetail" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <StackPanel x:Name="SearchPanel">
                <Grid>
                  <TextBox x:Name="Query" Height="36" Padding="32,0,8,0" VerticalContentAlignment="Center" TextChanged="QueryChanged"/>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/>
                  <TextBlock x:Name="QueryHint" Text="اكتب اسم الموظف…" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False"/>
                </Grid>
                <ListBox x:Name="Results" MaxHeight="260" Margin="0,6,0,0" BorderThickness="1" BorderBrush="{DynamicResource Line}" Visibility="Collapsed" SelectionChanged="ResultChosen" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="SearchStatus" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Text="جهة الاستقطاع" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/>
              <ComboBox x:Name="EntityPicker" Height="36" VerticalContentAlignment="Center" SelectionChanged="EntityChanged" IsEnabled="False"/>
              <TextBlock x:Name="EntityStatus" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="الفترة المطلوبة" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="من شهر" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,0,0,3"/>
                  <ComboBox x:Name="FromPicker" Height="36" VerticalContentAlignment="Center" DisplayMemberPath="Label" SelectionChanged="PeriodChanged" IsEnabled="False"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="إلى شهر" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,0,0,3"/>
                  <ComboBox x:Name="ToPicker" Height="36" VerticalContentAlignment="Center" DisplayMemberPath="Label" SelectionChanged="PeriodChanged" IsEnabled="False"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="PeriodStatus" Foreground="{DynamicResource Warn}" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="Warning" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="4,12,0,0"/>
        </StackPanel>
      </ScrollViewer>

      <!-- تفاصيل الأشهر. -->
      <Border Grid.Column="1" Style="{StaticResource Card}">
        <Grid>
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock x:Name="RowsCount" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
              <TextBlock Style="{StaticResource CardTitle}" Text="تفاصيل الأشهر"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="Line" BorderBrush="{DynamicResource TbgEDF1F2}" BorderThickness="0,0,0,1" Padding="4,9">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}"/>
                        <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding ValueText}" FontWeight="SemiBold"/>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsUnavailable}" Value="True"><Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Warn}"/><Setter TargetName="Value" Property="FontWeight" Value="Normal"/></DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="None"><Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Muted}"/><Setter TargetName="Value" Property="FontWeight" Value="Normal"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
          <TextBlock x:Name="EmptyText" Text="اختر الموظف وجهة الاستقطاع لعرض الكشف." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <local:LoadingSpinner x:Name="Spinner" Text="جارٍ إعداد الكشف…" Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Grid>

    <Border Style="{StaticResource DialogFooterBar}" Grid.Row="2" Margin="0,14,0,0"><DockPanel>
      <Button DockPanel.Dock="Left" Content="إغلاق" IsCancel="True" Click="CloseWindow" Padding="20,7"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="PreviewButton" Click="PreviewPdf" IsEnabled="False" Margin="0,0,8,0" Padding="14,7">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ReportActionIcon}" Text="{StaticResource PreviewActionGlyph}" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="معاينة"/></StackPanel>
        </Button>
        <Button x:Name="PrintButton" Click="PrintPdf" IsEnabled="False" Margin="0,0,8,0" Padding="14,7">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ReportActionIcon}" Text="{StaticResource PrintActionGlyph}" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="طباعة"/></StackPanel>
        </Button>
        <Button x:Name="SaveButton" Style="{StaticResource ActionButton}" Click="SavePdf" IsEnabled="False" Padding="14,7" IsDefault="True">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ReportActionIcon}" Text="{StaticResource PdfActionGlyph}" FontSize="13" Margin="0,0,7,0" Foreground="White"/><TextBlock Text="حفظ PDF…"/></StackPanel>
        </Button>
      </StackPanel>
      <TextBlock Text="تُربط الاستقطاعات بالاسم؛ راجع الأسماء المتشابهة قبل اعتماد الكشف." Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
    </DockPanel></Border>
  </Grid>
</Window>
