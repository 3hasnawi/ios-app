<Window x:Class="SalaryDesktop.SearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بحث شامل" Width="680" MinWidth="320" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" FontSize="14"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" ShowInTaskbar="False" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" PreviewKeyDown="WindowKeyDown" SnapsToDevicePixels="True" TextOptions.TextRenderingMode="ClearType" Typography.NumeralAlignment="Tabular">
  <Border Background="{DynamicResource TbgFFFFFF}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="18">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <TextBox x:Name="Query" Height="44" FontSize="15" Padding="38,6,44,6" TextChanged="QueryChanged" Tag="اكتب اسماً أو اسم الأم أو الرقم الموحد أو جهة…"/>
      <Button Content="✕" Click="CloseSearchClick" HorizontalAlignment="Right" Width="30" Height="30" Margin="5,0" Padding="0" ToolTip="إغلاق البحث (Esc)"/>
      <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource Tfg7A8D8A}" FontSize="16" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False"/>
    </Grid>
    <TextBlock x:Name="Status" Grid.Row="1" Foreground="{DynamicResource Muted}" Margin="2,8,0,8" Text="جارٍ تجهيز فهرس البحث…"/>
    <Border x:Name="ResultsContainer" Grid.Row="2" Background="{DynamicResource TbgFFFFFF}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
      <ListBox x:Name="Results" BorderThickness="0" Background="Transparent" Margin="4" MouseDoubleClick="ResultsDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,1"><ContentPresenter HorizontalAlignment="Stretch"/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource TbgEEF3F2}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoft}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="8" Background="{Binding Tint}"><TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Ink}" HorizontalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding KindText}" Foreground="{DynamicResource Tfg8A9B98}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <TextBlock Grid.Row="3" Foreground="{DynamicResource Tfg8A9B98}" FontSize="12" Margin="2,10,0,0" Text="↑ ↓ للتنقل · Enter للفتح · Esc للإغلاق · الأرقام تبحث في الرقم الموحد والإحصائي"/>
  </Grid>
  </Border>
</Window>
