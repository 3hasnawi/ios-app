<Window x:Class="SalaryDesktop.ReconciliationConfirmWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اعتماد مطابقة الفترة" Width="600" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" FontSize="14"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" ShowInTaskbar="False" SnapsToDevicePixels="True" TextOptions.TextRenderingMode="ClearType" Typography.NumeralAlignment="Tabular">
  <StackPanel Margin="22">
    <Border Style="{StaticResource DialogHeaderBanner}"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource PrimarySoft}"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FB;" FontSize="20" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="اعتماد مطابقة الفترة" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="PeriodText" Foreground="{DynamicResource Muted}"/>
      </StackPanel>
    </Grid></Border>
    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12">
      <Grid x:Name="Facts">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="الرصيد الافتتاحي" Foreground="{DynamicResource Muted}" Margin="0,3,18,3"/><TextBlock x:Name="OpeningText" Grid.Column="1" FontWeight="SemiBold" Margin="0,3"/>
        <TextBlock Grid.Row="1" Text="الدائن" Foreground="{DynamicResource Muted}" Margin="0,3,18,3"/><TextBlock x:Name="CreditText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Margin="0,3"/>
        <TextBlock Grid.Row="2" Text="المدين" Foreground="{DynamicResource Muted}" Margin="0,3,18,3"/><TextBlock x:Name="DebitText" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Margin="0,3"/>
        <TextBlock Grid.Row="3" Text="الرصيد الختامي" Foreground="{DynamicResource Muted}" Margin="0,3,18,3"/><TextBlock x:Name="BalanceText" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" Margin="0,3"/>
        <TextBlock Grid.Row="4" Text="الحركات" Foreground="{DynamicResource Muted}" Margin="0,3,18,3"/><TextBlock x:Name="MovementsText" Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" Margin="0,3"/>
        <TextBlock Grid.Row="5" Text="التنبيهات" Foreground="{DynamicResource Muted}" Margin="0,3,18,3"/><TextBlock x:Name="AlertsText" Grid.Row="5" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3"/>
      </Grid>
    </Border>
    <Border x:Name="AlertsBox" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,12,0,0" Visibility="Collapsed">
      <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="AlertsList" TextWrapping="Wrap" FontSize="13"/></ScrollViewer>
    </Border>
    <Border Background="{DynamicResource TbgF7FAF9}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,12,0,0">
      <DockPanel>
        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{DynamicResource Primary}" FontSize="14" Margin="0,1,8,0" VerticalAlignment="Top"/>
        <TextBlock TextWrapping="Wrap" FontSize="13" Text="بعد الاعتماد تُقفل الفترة وتُحفظ «معتمدة» كما هي، ويُفتح كشفها المعتمد في أي وقت للمعاينة أو الطباعة. للتعديل لاحقاً: الزر الأيمن على الفترة ← «إلغاء الاعتماد للتعديل». تدخل في النسخة الاحتياطية التالية."/>
      </DockPanel>
    </Border>
    <CheckBox x:Name="ReviewedBox" Content="راجعت الحركات والرصيد مع كشف المصرف الورقي" Margin="0,14,0,0" Checked="BoxChanged" Unchecked="BoxChanged"/>
    <CheckBox x:Name="AcceptBox" Content="أتحمل مسؤولية التنبيهات الظاهرة وأعتمد المطابقة يدوياً" Margin="0,8,0,0" Visibility="Collapsed" Checked="BoxChanged" Unchecked="BoxChanged"/>
    <Border Style="{StaticResource DialogFooterBar}" Margin="0,18,0,0"><DockPanel>
      <Button DockPanel.Dock="Left" Content="إلغاء" IsCancel="True" Padding="20,7"/>
      <Button x:Name="ConfirmButton" Style="{StaticResource ActionButton}" IsDefault="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Confirm" IsEnabled="False" Background="{DynamicResource Primary}" BorderBrush="{DynamicResource Primary}" Foreground="White" Padding="18,7">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FB;" Foreground="White" Margin="0,0,7,0"/><TextBlock Text="اعتماد وحفظ"/></StackPanel>
      </Button>
    </DockPanel></Border>
  </StackPanel>
</Window>
