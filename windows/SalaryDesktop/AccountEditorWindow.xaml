<Window Foreground="{DynamicResource Ink}" x:Class="SalaryDesktop.AccountEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تعديل بيانات الحساب" Width="560" Height="560" MinHeight="480" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" Background="{DynamicResource TbgF1F4F6}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" Typography.NumeralAlignment="Tabular">
 <DockPanel Margin="24"><Border Style="{StaticResource DialogFooterBar}" DockPanel.Dock="Bottom"><StackPanel Orientation="Horizontal"><Button Content="حفظ الحساب" Click="Save" Style="{StaticResource ActionButton}" IsDefault="True"/><Button Content="إلغاء" IsCancel="True" Padding="16,8" Margin="10,0"/></StackPanel></Border>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource DialogHeaderBanner}" Margin="0,0,0,12"><TextBlock Text="تعديل بيانات الحساب" FontSize="23" FontWeight="SemiBold"/></Border><TextBlock x:Name="Entity" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBlock Text="المصرف والفرع"/><TextBox x:Name="Branch" Padding="8" Margin="0,4,0,10" Style="{StaticResource FluentFieldInput}"/><TextBlock Text="IBAN"/><TextBox x:Name="Iban" Padding="8" Margin="0,4,0,10" FlowDirection="LeftToRight" Style="{StaticResource FluentFieldInput}"/><TextBlock Text="SWIFT"/><TextBox x:Name="Swift" Padding="8" Margin="0,4,0,10" FlowDirection="LeftToRight" Style="{StaticResource FluentFieldInput}"/><TextBlock Text="الحساب المحلي (إن وجد)"/><TextBox x:Name="Local" Padding="8" Margin="0,4,0,10" FlowDirection="LeftToRight" Style="{StaticResource FluentFieldInput}"/><TextBlock Text="يتحقق التطبيق من IBAN، ويقبل الحساب المحلي منفرداً لجهتي الإسكان والموارد المائية في فرع الأنبار. لا يتغير اسم الحساب من هذه الشاشة." TextWrapping="Wrap" Foreground="{DynamicResource TfgA76716}"/></StackPanel></ScrollViewer></DockPanel>
</Window>
