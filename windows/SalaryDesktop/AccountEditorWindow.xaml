<Window x:Class="SalaryDesktop.AccountEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تعديل بيانات الحساب" Width="560" Height="560" MinHeight="480" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}" Background="#F1F4F6">
 <DockPanel Margin="24"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="حفظ الحساب" Click="Save" Style="{StaticResource ActionButton}"/><Button Content="إلغاء" IsCancel="True" Padding="16,8" Margin="10,0"/></StackPanel>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="تعديل بيانات الحساب" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="Entity" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBlock Text="المصرف والفرع"/><TextBox x:Name="Branch" Padding="8" Margin="0,4,0,10"/><TextBlock Text="IBAN"/><TextBox x:Name="Iban" Padding="8" Margin="0,4,0,10" FlowDirection="LeftToRight"/><TextBlock Text="SWIFT"/><TextBox x:Name="Swift" Padding="8" Margin="0,4,0,10" FlowDirection="LeftToRight"/><TextBlock Text="الحساب المحلي (إن وجد)"/><TextBox x:Name="Local" Padding="8" Margin="0,4,0,10" FlowDirection="LeftToRight"/><TextBlock Text="يتحقق التطبيق من IBAN، ويقبل الحساب المحلي منفرداً لجهتي الإسكان والموارد المائية في فرع الأنبار. لا يتغير اسم الحساب من هذه الشاشة." TextWrapping="Wrap" Foreground="#A76716"/></StackPanel></ScrollViewer></DockPanel>
</Window>
