<Window x:Class="SalaryDesktop.ArchiveBookWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="كتاب في الأرشيف" Width="1040" Height="720" MinWidth="860" MinHeight="560" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" FontSize="14"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" ShowInTaskbar="False" AllowDrop="True" DragOver="FileDragOver" Drop="FileDrop">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- الرأس -->
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="52" Height="52" CornerRadius="13" Background="{DynamicResource PrimarySoft}"><TextBlock x:Name="HeadIcon" Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="22" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="Heading" Text="إضافة كتاب إلى الأرشيف" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="SubHeading" Text="من ملف PDF أو صور، أو بالمسح من الطابعة أو الماسح الضوئي · من صفحة إلى ثلاث صفحات" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="InfoColumn" Width="370"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- بيانات الكتاب -->
      <Border x:Name="InfoCard" Style="{StaticResource Card}" Margin="0,0,14,0" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="بيانات الكتاب"/>
          <TextBlock Text="اسم الكتاب" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/>
          <TextBox x:Name="TitleBox" Height="38" VerticalContentAlignment="Center" Tag="مثال: كتاب مصرف الرافدين بشأن الاستقطاع" TextChanged="FieldChanged"/>
          <DockPanel Margin="2,6,0,0">
            <Button x:Name="SuggestButton" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Click="SuggestTitle" Padding="8,2" ToolTip="اسم من الجهة والشهر لكتاب بلا عنوان">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="12" Margin="0,0,5,0"/><TextBlock Text="اقترح اسماً"/></StackPanel>
            </Button>
            <TextBlock x:Name="TitleHint" Text="إن لم يكن للكتاب اسم، اكتب اسماً يسهل البحث عنه." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock Text="الشهر" Style="{StaticResource SectionLabel}" Margin="0,14,0,4"/>
          <ComboBox x:Name="MonthBox" Height="38" VerticalContentAlignment="Center" SelectionChanged="FieldChanged"/>
          <TextBlock Text="الجهة (اختياري)" Style="{StaticResource SectionLabel}" Margin="0,14,0,4"/>
          <ComboBox x:Name="EntityBox" Height="38" VerticalContentAlignment="Center" IsEditable="True" IsTextSearchEnabled="True" ToolTip="تُحفظ الجهة لربط الكتاب بكشفها لاحقاً"/>
          <Border Background="{DynamicResource PrimarySoft}" CornerRadius="10" Padding="12,9" Margin="0,18,0,0">
            <DockPanel>
              <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource Primary}" FontSize="14" Margin="0,1,8,0" DockPanel.Dock="Left" VerticalAlignment="Top"/>
              <TextBlock x:Name="SaveNote" TextWrapping="Wrap" FontSize="12.5" Text="يُحفظ الكتاب على هذا الجهاز ويدخل في النسخة الاحتياطية التالية، ويظهر في الآيفون بعد استرجاعها."/>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- الصفحات -->
      <Border x:Name="PagesCard" Grid.Column="1" Style="{StaticResource Card}" Margin="0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="FileButton" Click="AddFromFile" Margin="0,0,8,0" ToolTip="ملف PDF واحد، أو حتى ثلاث صور (JPG أو PNG)">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Foreground="{DynamicResource Primary}" Margin="0,0,7,0"/><TextBlock Text="إضافة من ملف…"/></StackPanel>
              </Button>
              <Button x:Name="ScanButton" Click="ScanPage" Style="{StaticResource ActionButton}" ToolTip="يمسح صفحة واحدة من الطابعة أو الماسح؛ كرر للصفحة التالية">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FE;" Foreground="White" Margin="0,0,7,0"/><TextBlock x:Name="ScanText" Text="مسح صفحة من الماسح"/></StackPanel>
              </Button>
            </StackPanel>
            <StackPanel>
              <TextBlock x:Name="PagesTitle" Style="{StaticResource CardTitle}" Text="الصفحات"/>
              <TextBlock x:Name="PagesHint" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="PageList">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="214" Margin="0,0,14,14" Background="{DynamicResource TbgF7FAF9}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="10">
                      <StackPanel>
                        <Border Height="270" Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                          <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <DockPanel Margin="0,8,0,0">
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource QuietButton}" Padding="6,2" Tag="{Binding}" Click="RotatePage" ToolTip="تدوير ٩٠ درجة" Visibility="{Binding RotateVisibility}"><TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" FontSize="13"/></Button>
                            <Button Style="{StaticResource QuietButton}" Padding="6,2" Tag="{Binding}" Click="RemovePage" ToolTip="إزالة"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Foreground="{DynamicResource TfgB4362A}"/></Button>
                          </StackPanel>
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <!-- حالة فارغة: اسحب ملفاً أو امسح صفحة. -->
            <Border x:Name="EmptyPages" BorderBrush="{DynamicResource Line}" BorderThickness="2" CornerRadius="14" Padding="20" Background="{DynamicResource TbgF7FAF9}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="38" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/>
                <TextBlock Text="اسحب ملف PDF أو صور الكتاب إلى هنا" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="أو اختر «إضافة من ملف»، أو ضع الكتاب في الطابعة واضغط «مسح صفحة من الماسح»." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <Button DockPanel.Dock="Left" Content="إلغاء" IsCancel="True" Padding="20,7"/>
      <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Click="Save" IsDefault="True" Padding="18,7">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,7,0" Foreground="White"/><TextBlock x:Name="SaveText" Text="حفظ في الأرشيف"/></StackPanel>
      </Button>
      <TextBlock x:Name="Status" Foreground="{DynamicResource Warn}" VerticalAlignment="Center" Margin="14,0,14,0" TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</Window>
