<Window x:Class="SalaryDesktop.PasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="كلمة سر البرنامج" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}" FontSize="13.5"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" ShowInTaskbar="False" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="22">
    <TextBlock Text="كلمة سر البرنامج" FontSize="19" FontWeight="SemiBold"/>
    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,14" Text="تُطلب عند فتح البرنامج وبعد مدة عدم الاستخدام. تُحفظ بصمتها فقط على هذا الجهاز، ولا تُرسل إلى أي مكان."/>
    <TextBlock x:Name="CurrentLabel" Text="كلمة السر الحالية" Margin="0,0,0,4"/>
    <PasswordBox x:Name="Current" Height="36" Margin="0,0,0,10"/>
    <StackPanel x:Name="NewFields">
      <TextBlock Text="كلمة السر الجديدة (4 أحرف على الأقل)" Margin="0,0,0,4"/>
      <PasswordBox x:Name="First" Height="36" Margin="0,0,0,10"/>
      <TextBlock Text="تأكيد كلمة السر" Margin="0,0,0,4"/>
      <PasswordBox x:Name="Second" Height="36"/>
    </StackPanel>
    <TextBlock x:Name="Error" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
      <Button Content="حفظ" Style="{StaticResource ActionButton}" IsDefault="True" Click="Save" MinWidth="100"/>
      <Button Content="إلغاء" IsCancel="True" Margin="8,0,0,0" MinWidth="90"/>
    </StackPanel>
  </StackPanel>
</Window>
