<Window Foreground="{DynamicResource Ink}" x:Class="SalaryDesktop.GroupIssuanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تدقيق إصدار المجموعة" Width="880" Height="680" MinWidth="650" MinHeight="500" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" Background="{DynamicResource TbgF1F4F6}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" Typography.NumeralAlignment="Tabular">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource DialogHeaderBanner}"><TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold"/></Border><TextBlock x:Name="Status" Grid.Row="1" Foreground="{DynamicResource TfgA76716}" TextWrapping="Wrap" Margin="0,8,0,12"/>
  <ListBox x:Name="Changes" Grid.Row="2" Background="{DynamicResource TbgFFFFFF}" BorderBrush="{DynamicResource TbgE1E7E8}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="8"/></DataTemplate></ListBox.ItemTemplate></ListBox>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="ملاحظة المراجعة · اختيارية"/><TextBox x:Name="NoteText" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="8" Margin="0,5,0,0" MaxLength="2000"/></StackPanel>
  <CheckBox x:Name="Reviewed" Grid.Row="4" Content="راجعت التغييرات وأؤكد المجموعة" Margin="0,12,0,0" Visibility="Collapsed"/>
  <Border Style="{StaticResource DialogFooterBar}" Grid.Row="5" Margin="0,12,0,0"><WrapPanel><Button x:Name="ConfirmButton" Content="تأكيد إصدار المجموعة" Click="Confirm" Style="{StaticResource ActionButton}" IsDefault="True"/><Button Content="إغلاق" IsCancel="True" Padding="18,9" Margin="12,0"/></WrapPanel></Border>
 </Grid>
</Window>
