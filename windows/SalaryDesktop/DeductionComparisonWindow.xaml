<Window x:Class="SalaryDesktop.DeductionComparisonWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مقارنة الاستقطاعات" Width="1100" Height="720" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="مقارنة الاستقطاعات بين الأشهر" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="تجميع حسب المنتسب أو المنتسب والجهة والإضبارة؛ راجع الأسماء المتشابهة قبل الاعتماد." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,12"><TextBlock Text="من" VerticalAlignment="Center"/><ComboBox x:Name="FromMonth" SelectionChanged="MonthChanged" Width="180" Margin="8,0,14,0"/><TextBlock Text="إلى" VerticalAlignment="Center"/><ComboBox x:Name="ToMonth" SelectionChanged="MonthChanged" Width="180" Margin="8,0,14,0"/><Button x:Name="CompareRunButton" Content="عرض المقارنة" Click="CompareClick" Style="{StaticResource ActionButton}"/></WrapPanel>
    <WrapPanel Grid.Row="2" Margin="0,0,0,10"><TextBlock Text="المستوى" VerticalAlignment="Center"/><ComboBox x:Name="LevelPicker" Width="190" Margin="8,0,14,0" SelectionChanged="FilterChanged"><ComboBoxItem Content="حسب الاستقطاع" Tag="entries"/><ComboBoxItem Content="مجموع المنتسب" Tag="people"/></ComboBox><TextBlock Text="الحالة" VerticalAlignment="Center"/><ComboBox x:Name="KindPicker" Width="150" Margin="8,0,14,0" SelectionChanged="FilterChanged"><ComboBoxItem Content="كل الحالات" Tag="all"/><ComboBoxItem Content="بدأ" Tag="Started"/><ComboBoxItem Content="توقف" Tag="Stopped"/><ComboBoxItem Content="زاد" Tag="Increased"/><ComboBoxItem Content="نقص" Tag="Decreased"/><ComboBoxItem Content="ثابت" Tag="Unchanged"/></ComboBox><TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></WrapPanel>
    <DataGrid x:Name="Rows" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="الجهة" Binding="{Binding Entity}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="الإضبارة / الملاحظة" Binding="{Binding Note}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="السابق" Binding="{Binding BeforeText}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="الحالي" Binding="{Binding AfterText}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="الفرق" Binding="{Binding DifferenceText}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/></DataGrid.Columns></DataGrid>
    <DockPanel Grid.Row="4" Margin="0,12,0,0"><Button DockPanel.Dock="Left" Content="إغلاق" IsCancel="True"/><WrapPanel><Button Content="معاينة" Click="PreviewClick" ContentTemplate="{StaticResource PreviewActionContent}" Margin="0,0,8,0"/><Button Content="PDF" Click="PdfClick" ContentTemplate="{StaticResource PdfActionContent}" Margin="0,0,8,0"/><Button Content="Excel" Click="ExcelClick" ContentTemplate="{StaticResource ExcelActionContent}"/></WrapPanel></DockPanel>
  </Grid>
</Window>
