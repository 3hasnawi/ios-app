<Window Foreground="{DynamicResource Ink}" x:Class="SalaryDesktop.SalaryItemsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="بنود الرواتب" Width="1050" Height="760" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" Background="{DynamicResource Page}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="اختر بنداً لعرض المنتسبين الذين احتُسب ضمن رواتبهم." Grid.Row="1" Foreground="{DynamicResource Tfg718481}" Margin="0,8,0,10"/>
 <DataGrid x:Name="Groups" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="{DynamicResource TbgFFFFFF}" GridLinesVisibility="Horizontal" SelectionChanged="GroupChanged"><DataGrid.Columns><DataGridTextColumn Header="البند" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="العدد" Binding="{Binding People}" Width="*"/><DataGridTextColumn Header="المجموع" Binding="{Binding Total, StringFormat={}{0:N0}}" Width="*"/></DataGrid.Columns></DataGrid>
 <TextBlock x:Name="Status" Grid.Row="3" TextWrapping="Wrap" Foreground="{DynamicResource TfgA76716}" Margin="0,10"/>
 <DataGrid x:Name="Rows" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="{DynamicResource TbgFFFFFF}" GridLinesVisibility="Horizontal" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="الرتبة" Binding="{Binding Rank}" Width="*"/><DataGridTextColumn Header="محل العمل" Binding="{Binding Workplace}" Width="2*"/><DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="*"/></DataGrid.Columns></DataGrid>
 <DockPanel Grid.Row="5" Margin="0,12,0,0">
  <Button DockPanel.Dock="Left" Content="إغلاق" IsCancel="True" Padding="20,8"/>
  <WrapPanel Margin="14,0,0,0">
   <TextBlock Text="قائمة البند:" VerticalAlignment="Center" Foreground="{DynamicResource Tfg4B625F}" FontWeight="SemiBold" Margin="0,0,8,6"/>
   <Button x:Name="ListPreview" Content="معاينة" Click="PreviewList" IsEnabled="False" Margin="0,0,6,6" ToolTip="معاينة قائمة البند داخل البرنامج"/>
   <Button x:Name="ListExcel" Content="Excel" Click="ExportListExcel" IsEnabled="False" Margin="0,0,6,6" ToolTip="قائمة البند بالشكل المعتمد"/>
   <Button x:Name="ListPdf" Content="PDF" Click="ExportListPdf" IsEnabled="False" Margin="0,0,6,6"/>
   <Button x:Name="ListPrint" Content="طباعة" Click="PrintList" IsEnabled="False" Margin="0,0,18,6"/>
   <StackPanel x:Name="SpecialPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,6">
    <TextBlock x:Name="SpecialTitle" VerticalAlignment="Center" Foreground="{DynamicResource Tfg135148}" FontWeight="SemiBold" Margin="0,0,8,0"/>
    <Button Content="عرض الكشف" Click="OpenSpecial" Style="{StaticResource ActionButton}" Margin="0,0,6,0" ToolTip="الملخص والأسماء والتصدير كما في الآيفون"/>
    <Button Content="معاينة" Click="PreviewSpecial" Margin="0,0,6,0"/>
    <Button Content="Excel" Click="ExportSpecialExcel" Style="{StaticResource ActionButton}" Margin="0,0,6,0"/>
    <Button Content="PDF" Click="ExportSpecialPdf" Style="{StaticResource ActionButton}" Margin="0,0,6,0"/>
    <Button Content="طباعة" Click="PrintSpecial"/>
   </StackPanel>
  </WrapPanel>
 </DockPanel>
 </Grid>
</Window>
