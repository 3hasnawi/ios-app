<Window x:Class="SalaryDesktop.SalaryItemsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="بنود الرواتب" Width="1050" Height="760" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI" Background="#F1F4F6">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock x:Name="Heading" FontSize="24" FontWeight="Bold"/><TextBlock Text="اختر بنداً لعرض المنتسبين الذين احتُسب ضمن رواتبهم." Grid.Row="1" Foreground="#718481" Margin="0,8,0,10"/>
 <DataGrid x:Name="Groups" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="White" GridLinesVisibility="Horizontal" SelectionChanged="GroupChanged"><DataGrid.Columns><DataGridTextColumn Header="البند" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="العدد" Binding="{Binding People}" Width="*"/><DataGridTextColumn Header="المجموع" Binding="{Binding Total, StringFormat={}{0:N0}}" Width="*"/></DataGrid.Columns></DataGrid>
 <TextBlock x:Name="Status" Grid.Row="3" TextWrapping="Wrap" Foreground="#A76716" Margin="0,10"/>
 <DataGrid x:Name="Rows" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="White" GridLinesVisibility="Horizontal" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="الرتبة" Binding="{Binding Rank}" Width="*"/><DataGridTextColumn Header="محل العمل" Binding="{Binding Workplace}" Width="2*"/><DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="*"/></DataGrid.Columns></DataGrid>
 <DockPanel Grid.Row="5" Margin="0,12,0,0"><Button DockPanel.Dock="Left" Content="إغلاق" IsCancel="True" Padding="20,8"/><TextBlock Text="عرض للمراجعة؛ طباعة الكشوف المتخصصة لم تكتمل بعد." TextWrapping="Wrap" Foreground="#718481" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
