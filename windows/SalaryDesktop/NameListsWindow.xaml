<Window Foreground="{DynamicResource Ink}" x:Class="SalaryDesktop.NameListsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="قوائم الأسماء" Width="1050" Height="720" MinWidth="750" MinHeight="500" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" Background="{DynamicResource TbgF1F4F6}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" Typography.NumeralAlignment="Tabular">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource DialogHeaderBanner}"><TextBlock x:Name="Heading" Text="قوائم الأسماء" FontSize="24" FontWeight="SemiBold"/></Border>
    <ComboBox x:Name="ListPicker" Grid.Row="1" Height="40" Margin="0,14,0,10" DisplayMemberPath="Title" SelectionChanged="ListChanged"/>
    <TextBlock x:Name="Notice" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource TfgA76716}" Margin="0,0,0,10"/>
    <DataGrid x:Name="Rows" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="{DynamicResource TbgFFFFFF}"  EnableRowVirtualization="True" RowHeight="NaN" MinRowHeight="38" ColumnHeaderHeight="42" AlternatingRowBackground="{DynamicResource AccountingGridAlternate}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource AccountingGridLines}">
      <DataGrid.Columns><DataGridTextColumn Header="ت" Binding="{Binding Number}" Width="50" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="الرتبة" Binding="{Binding Rank}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="محل العمل" Binding="{Binding Workplace}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/><DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="Auto" MaxWidth="320" ElementStyle="{StaticResource CompactTableText}"/></DataGrid.Columns>
    </DataGrid>
    <Border Style="{StaticResource DialogFooterBar}" Grid.Row="4" Margin="0,12,0,0"><DockPanel><Button DockPanel.Dock="Left" Content="إغلاق" IsCancel="True" Padding="20,8"/><Button x:Name="ExportButton" DockPanel.Dock="Left" Content="تصدير قائمة PDF" Click="Export" Style="{StaticResource ActionButton}" Margin="8,0" IsDefault="True" ContentTemplate="{StaticResource PdfActionContent}"/><Button x:Name="PreviewButton" DockPanel.Dock="Left" Content="معاينة" Click="Preview" Padding="16,8" Margin="0,0,8,0" ContentTemplate="{StaticResource PreviewActionContent}"/><TextBlock x:Name="Summary" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel></Border>
  </Grid>
</Window>
