<Window Foreground="{DynamicResource Ink}" x:Class="SalaryDesktop.NameListsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="قوائم الأسماء" Width="1050" Height="720" MinWidth="750" MinHeight="500" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" Background="{DynamicResource TbgF1F4F6}">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Text="قوائم الأسماء" FontSize="24" FontWeight="SemiBold"/>
    <ComboBox x:Name="ListPicker" Grid.Row="1" Height="40" Margin="0,14,0,10" DisplayMemberPath="Title" SelectionChanged="ListChanged"/>
    <TextBlock x:Name="Notice" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource TfgA76716}" Margin="0,0,0,10"/>
    <DataGrid x:Name="Rows" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="{DynamicResource TbgFFFFFF}" GridLinesVisibility="Horizontal" EnableRowVirtualization="True">
      <DataGrid.Columns><DataGridTextColumn Header="ت" Binding="{Binding Number}" Width="50"/><DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="الرتبة" Binding="{Binding Rank}" Width="*"/><DataGridTextColumn Header="محل العمل" Binding="{Binding Workplace}" Width="*"/><DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="*"/></DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="4" Margin="0,12,0,0"><Button DockPanel.Dock="Left" Content="إغلاق" IsCancel="True" Padding="20,8"/><Button x:Name="ExportButton" DockPanel.Dock="Left" Content="تصدير قائمة PDF" Click="Export" Style="{StaticResource ActionButton}" Margin="8,0"/><Button x:Name="PreviewButton" DockPanel.Dock="Left" Content="معاينة" Click="Preview" Padding="16,8" Margin="0,0,8,0"/><TextBlock x:Name="Summary" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
  </Grid>
</Window>
