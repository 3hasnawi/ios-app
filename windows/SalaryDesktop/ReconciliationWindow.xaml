<Window x:Class="SalaryDesktop.ReconciliationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SalaryDesktop"
        Title="دفتر مطابقة الحساب" Width="1340" Height="820" MinWidth="1000" MinHeight="560" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" FontSize="14"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" PreviewKeyDown="WindowKeyDown">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- الرأس -->
    <DockPanel>
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Click="AddPeriod" ToolTip="فترة مطابقة جديدة (Ctrl+Shift+N)">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Foreground="{DynamicResource Primary}" Margin="0,0,7,0"/><TextBlock Text="فترة جديدة"/></StackPanel>
        </Button>
        <Button x:Name="PreviewButton" Click="PreviewPdf" Margin="8,0,0,0" ToolTip="كشف الفترة بالشكل المعتمد">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FF;" Foreground="{DynamicResource Primary}" Margin="0,0,7,0"/><TextBlock Text="معاينة الكشف"/></StackPanel>
        </Button>
      </StackPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="50" Height="50" CornerRadius="13" Background="{DynamicResource PrimarySoft}"><TextBlock Style="{StaticResource Icon}" Text="&#xE825;" FontSize="21" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="دفتر مطابقة الحساب" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock x:Name="AccountText" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- الفترات -->
      <DockPanel Margin="0,0,14,0">
        <TextBlock DockPanel.Dock="Top" Text="الفترات · الزر الأيمن لخيارات الفترة" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="2,0,0,8"/>
        <ListBox x:Name="PeriodList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="PeriodChanged"
                 ItemTemplate="{StaticResource PeriodCardTemplate}" ItemContainerStyle="{StaticResource PeriodCardItem}">
          <ListBox.ContextMenu>
            <ContextMenu Opened="PeriodMenuOpened">
              <MenuItem x:Name="PeriodPreviewItem" Header="فتح كشف الفترة" Click="PreviewPdf" FontWeight="SemiBold"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8FF;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
              <MenuItem x:Name="PeriodPrintItem" Header="طباعة" Click="PrintPdf"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE749;"/></MenuItem.Icon></MenuItem>
              <MenuItem x:Name="PeriodSaveItem" Header="حفظ PDF…" Click="ExportPdf"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" Foreground="{DynamicResource TfgB03A2E}"/></MenuItem.Icon></MenuItem>
              <Separator/>
              <MenuItem x:Name="PeriodConfirmItem" Header="اعتماد مطابقة الفترة…" Click="ConfirmPeriod"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8FB;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
              <MenuItem x:Name="PeriodUnconfirmItem" Header="إلغاء الاعتماد للتعديل…" Click="UnconfirmPeriod"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;"/></MenuItem.Icon></MenuItem>
              <MenuItem x:Name="PeriodEditItem" Header="تعديل الفترة واللجنة…" Click="EditPeriod"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE787;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
              <MenuItem x:Name="PeriodCopyItem" Header="نسخ ملخص الفترة" Click="CopySummary"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;"/></MenuItem.Icon></MenuItem>
              <Separator/>
              <MenuItem Header="فترة جديدة…" Click="AddPeriod"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
              <MenuItem x:Name="PeriodDeleteItem" Header="حذف الفترة…" Click="DeletePeriod" Foreground="{DynamicResource TfgB4362A}"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{DynamicResource TfgB4362A}"/></MenuItem.Icon></MenuItem>
            </ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>
      </DockPanel>

      <!-- الفترة المختارة -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="18,16">
        <Grid>
          <DockPanel x:Name="PeriodPanel">
            <DockPanel DockPanel.Dock="Top">
              <Border x:Name="StatusChip" DockPanel.Dock="Right" CornerRadius="9" Padding="10,2" Background="{DynamicResource WarnSoft}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource Primary}" Visibility="Collapsed"/>
                  <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{DynamicResource Warn}"/>
                </StackPanel>
              </Border>
              <TextBlock VerticalAlignment="Center"><Run x:Name="PeriodTitle" FontSize="18" FontWeight="SemiBold"/><Run x:Name="RangeText" Foreground="{DynamicResource Muted}"/></TextBlock>
            </DockPanel>
            <!-- ملخص الأرقام -->
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource TbgEDF1F2}" BorderThickness="0,1" Margin="0,12,0,0">
              <UniformGrid Columns="5">
                <StackPanel Margin="12,9"><TextBlock Text="الرصيد الافتتاحي" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="OpeningText" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Margin="12,9"><TextBlock x:Name="CreditLabel" Text="الدائن" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="CreditText" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Margin="12,9"><TextBlock Text="المدين" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="DebitText" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Margin="12,9"><TextBlock Text="الرصيد" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="BalanceText" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Margin="12,9"><TextBlock Text="المؤشرة" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="MatchedText" FontSize="17" FontWeight="SemiBold"/></StackPanel>
              </UniformGrid>
            </Border>
            <!-- سطر التنبيهات أو الاعتماد بدل البطاقات المتراكمة -->
            <Border x:Name="AlertBar" DockPanel.Dock="Top" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="9" Padding="12,7" Margin="0,12,0,0" Visibility="Collapsed">
              <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource QuietButton}" Content="عرض التفاصيل" Click="ShowAlerts" Padding="6,1"/>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="AlertTitle" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="AlertText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Border>
            <Border x:Name="ConfirmedBar" DockPanel.Dock="Top" Background="{DynamicResource PrimarySoft}" CornerRadius="9" Padding="12,7" Margin="0,12,0,0" Visibility="Collapsed">
              <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{DynamicResource Primary}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ConfirmedText" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
            </Border>
            <!-- الأسفل -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <Button x:Name="ConfirmButton" DockPanel.Dock="Left" Click="ConfirmOrOpen" Background="{DynamicResource Primary}" BorderBrush="{DynamicResource Primary}" Foreground="White" Padding="16,8">
                <StackPanel Orientation="Horizontal"><TextBlock x:Name="ConfirmIcon" Style="{StaticResource Icon}" Text="&#xE8FB;" Foreground="White" Margin="0,0,7,0"/><TextBlock x:Name="ConfirmText" Text="اعتماد مطابقة الفترة"/></StackPanel>
              </Button>
              <TextBlock x:Name="FooterHint" Foreground="{DynamicResource Muted}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" Text="انقر الدائرة لتأشير الحركة بعد مطابقتها مع كشف المصرف الورقي · الزر الأيمن لخيارات الحركة"/>
            </DockPanel>
            <!-- الحركات -->
            <Grid Margin="0,12,0,0">
              <DataGrid x:Name="Lines" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" RowHeaderWidth="0" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                        MouseDoubleClick="LinesDoubleClick">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Matched}" Value="False"><Setter Property="Background" Value="{DynamicResource WarnSoft}"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="44" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource QuietButton}" Padding="4,0" Click="ToggleRow" Tag="{Binding}" ToolTip="تأشير الحركة كمطابقة (Space)">
                          <TextBlock x:Name="Mark" Style="{StaticResource Icon}" Text="&#xEA3A;" FontSize="16" Foreground="{DynamicResource Muted}"/>
                        </Button>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Matched}" Value="True"><Setter TargetName="Mark" Property="Text" Value="&#xE930;"/><Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Primary}"/></DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="104"/>
                  <DataGridTemplateColumn Header="البيان" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel VerticalAlignment="Center" Margin="4,2">
                          <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TfgB4362A}" FontSize="11.5" TextWrapping="Wrap" Visibility="{Binding NoteVisibility}"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="دائن" Binding="{Binding Credit}" Width="*"/>
                  <DataGridTextColumn Header="مدين" Binding="{Binding Debit}" Width="*"/>
                  <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance}" Width="*"/>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                  <ContextMenu Opened="MovementMenuOpened">
                    <MenuItem x:Name="ToggleItem" Header="تأشير كمطابقة" Click="ToggleMatched" InputGestureText="Space" FontWeight="SemiBold"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="EditMovementItem" Header="تعديل الحركة…" Click="EditMovement" InputGestureText="Enter"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="CopyMovementItem" Header="نسخ الحركة" Click="CopyMovement" InputGestureText="Ctrl+C"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="DeleteMovementItem" Header="حذف الحركة…" Click="DeleteMovement" InputGestureText="Delete" Foreground="{DynamicResource TfgB4362A}"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{DynamicResource TfgB4362A}"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem x:Name="AddMovementItem" Header="إضافة حركة…" Click="AddMovement" InputGestureText="Ctrl+N"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="SuggestionsItem" Header="المبالغ المقترحة…" Click="OpenSuggestions"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="MarkAllItem" Header="تأشير كل الحركات" Click="MarkAll"/>
                    <Separator/>
                    <MenuItem x:Name="EditPeriodItem" Header="تعديل الفترة واللجنة…" Click="EditPeriod"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE787;"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="ConfirmItem" Header="اعتماد مطابقة الفترة…" Click="ConfirmPeriod"><MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8FB;" Foreground="{DynamicResource Primary}"/></MenuItem.Icon></MenuItem>
                  </ContextMenu>
                </DataGrid.ContextMenu>
              </DataGrid>
              <TextBlock x:Name="NoMovements" Text="لا توجد حركات بعد · الزر الأيمن ← «إضافة حركة» أو «المبالغ المقترحة»" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
              <Border x:Name="SourceLoading" Background="{DynamicResource TbgFFFFFF}" Visibility="Collapsed" Opacity="0.92"><local:LoadingSpinner Text="جارٍ فحص مصادر الشهر…"/></Border>
            </Grid>
          </DockPanel>
          <!-- لا توجد فترة -->
          <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE825;" FontSize="40" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyTitle" Text="لا توجد فترات مطابقة بعد" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
            <TextBlock Text="ابدأ بتمويل الشهر السابق وانتهِ قبل التمويل الجديد." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
            <Button Click="AddPeriod" Style="{StaticResource ActionButton}" HorizontalAlignment="Center" Margin="0,14,0,0">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Foreground="White" Margin="0,0,7,0"/><TextBlock Text="فترة جديدة"/></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
