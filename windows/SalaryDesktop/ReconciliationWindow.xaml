<Window x:Class="SalaryDesktop.ReconciliationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دفتر مطابقة الحساب" Height="700" Width="1100" MinWidth="850" MinHeight="500"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI" Background="#F1F4F6">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock FontSize="24" FontWeight="Bold" Text="دفتر مطابقة الحساب"/>
    <TextBlock Grid.Row="1" Foreground="#A76716" TextWrapping="Wrap" Margin="0,12" Text="البيانات من نسخة الآيفون المحفوظة، للعرض فقط. لا تُحتسب حركة التمويل الجديدة تلقائياً في الفترة السابقة؛ راجع ترتيب حركات يوم التمويل."/>
    <StackPanel Grid.Row="2">
      <ComboBox x:Name="Periods" Height="38" SelectionChanged="PeriodChanged" DisplayMemberPath="Label"/>
      <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,12" FontWeight="SemiBold"/>
    </StackPanel>
    <DataGrid Grid.Row="3" x:Name="Lines" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column" Background="White" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="*"/>
        <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="3*"/>
        <DataGridTextColumn Header="دائن" Binding="{Binding Credit}" Width="*"/>
        <DataGridTextColumn Header="مدين" Binding="{Binding Debit}" Width="*"/>
        <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance}" Width="*"/>
        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
