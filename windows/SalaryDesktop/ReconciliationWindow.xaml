<Window x:Class="SalaryDesktop.ReconciliationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دفتر مطابقة الحساب" Height="700" Width="1100" MinWidth="850" MinHeight="500"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}" Background="#F1F4F6">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="24" FontWeight="SemiBold" Text="دفتر مطابقة الحساب"/>
    <TextBlock Grid.Row="1" Foreground="#A76716" TextWrapping="Wrap" Margin="0,12" Text="تُحفظ تعديلات المطابقة على هذا الجهاز مرتبطة بالنسخة المفتوحة. لتضمينها في نسخة احتياطية استخدم زر حفظ النسخة أدناه. استيراد نسخة أخرى لا يدمج هذه التعديلات تلقائياً؛ راجع حركات يوم التمويل."/>
    <StackPanel Grid.Row="2">
      <ComboBox x:Name="Periods" Height="38" SelectionChanged="PeriodChanged" DisplayMemberPath="Label"/>
      <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,12" FontWeight="SemiBold"/>
      <TextBlock x:Name="SourceStatus" Foreground="#A76716" TextWrapping="Wrap" Margin="0,0,0,10"/>
    </StackPanel>
    <DataGrid Grid.Row="3" x:Name="Lines" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column" Background="White" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="*"/>
        <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="3*"/>
        <DataGridTextColumn Header="دائن" Binding="{Binding Credit}" Width="*"/>
        <DataGridTextColumn Header="مدين" Binding="{Binding Debit}" Width="*"/>
        <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance}" Width="*"/>
        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <WrapPanel Grid.Row="4" Margin="0,12,0,0">
      <Button Content="فترة جديدة" Click="AddPeriod" Padding="12,8" Margin="0,0,8,0"/><Button Content="تعديل الفترة" Click="EditPeriod" Padding="12,8" Margin="0,0,8,0"/>
      <Button Content="إضافة حركة" Click="AddMovement" Padding="12,8" Margin="0,0,8,0"/><Button Content="تعديل الحركة" Click="EditMovement" Padding="12,8" Margin="0,0,8,0"/>
      <Button x:Name="SuggestionsButton" Content="المبالغ المقترحة" Click="OpenSuggestions" Padding="12,8" Margin="0,0,8,0"/>
      <Button Content="تأكيد / إلغاء المطابقة" Click="ToggleMatched" Padding="12,8" Margin="0,0,8,0"/><Button Content="حذف الحركة" Click="DeleteMovement" Padding="12,8"/>
      <Button x:Name="ExportButton" Content="حفظ نسخة تشمل المطابقة" Click="ExportBackup" Padding="12,8" Margin="8,0,0,0"/>
      <Button x:Name="ExportPdfButton" Content="تصدير مسودة الكشف PDF" Click="ExportPdf" Padding="12,8" Margin="8,0,0,0"/>
    </WrapPanel>
  </Grid>
</Window>
