<Window Foreground="{DynamicResource Ink}" x:Class="SalaryDesktop.AccountLinkWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ربط حساب الجهة" Width="900" Height="610" MinWidth="700" MinHeight="450" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" Background="{DynamicResource TbgF1F4F6}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" Typography.NumeralAlignment="Tabular">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><Border Style="{StaticResource DialogHeaderBanner}"><TextBlock Text="ربط حساب الجهة" FontSize="23" FontWeight="SemiBold"/></Border><TextBlock x:Name="SourceTitle" Margin="0,8,0,10" TextWrapping="Wrap"/><TextBlock Text="اختر الحساب الصحيح حتى إن اختلف اسمه عن اسم جهة الاستقطاع. راجع رقم الحساب والمصرف قبل الحفظ." Foreground="{DynamicResource TfgA76716}" TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel>
  <TextBox x:Name="Search" Grid.Row="1" Padding="8" Margin="0,0,0,10" TextChanged="Filter" ToolTip="بحث باسم الحساب أو المصرف أو IBAN" Tag="ابحث باسم الحساب أو المصرف أو IBAN…" Style="{StaticResource FluentFieldInput}"/>
  <DataGrid x:Name="Accounts" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column" Background="{DynamicResource TbgFFFFFF}" RowHeight="40" ColumnHeaderHeight="42" AlternatingRowBackground="{DynamicResource AccountingGridAlternate}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource AccountingGridLines}"><DataGrid.Columns><DataGridTextColumn Header="اسم الحساب" Binding="{Binding Entity}" Width="2*"/><DataGridTextColumn Header="المصرف والفرع" Binding="{Binding Branch}" Width="2*"/><DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="2*"/><DataGridTextColumn Header="SWIFT" Binding="{Binding Swift}" Width="*"/></DataGrid.Columns></DataGrid>
  <Border Style="{StaticResource DialogFooterBar}" Grid.Row="3" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><Button Content="حفظ الربط" Click="Choose" Style="{StaticResource ActionButton}" IsDefault="True"/><Button Content="إلغاء" IsCancel="True" Padding="18,8" Margin="10,0"/></StackPanel></Border>
 </Grid>
</Window>
