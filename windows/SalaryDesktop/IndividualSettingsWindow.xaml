<Window Foreground="{DynamicResource Ink}" x:Class="SalaryDesktop.IndividualSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تخصيص الكتاب" Width="950" Height="800" MinWidth="700" MinHeight="570" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}" Background="{DynamicResource TbgF1F4F6}">
 <DockPanel Margin="22"><WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button x:Name="SaveButton" Content="حفظ التخصيص" Click="SaveSettings" Style="{StaticResource ActionButton}"/><Button Content="إغلاق" IsCancel="True" Padding="14,8" Margin="10,0"/></WrapPanel>
 <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="{DynamicResource TfgA76716}" Margin="0,9,0,10"/>
  <TextBlock Text="نطاق حفظ الحقول المعدلة"/><ComboBox x:Name="Scope" Height="36" SelectedIndex="0" Margin="0,4,0,10"><ComboBoxItem Content="هذا الكتاب"/><ComboBoxItem Content="جميع الكتب · الحقول المعدلة فقط"/></ComboBox>
  <TextBlock Text="الترويسة"/><TextBox x:Name="HeaderText" AcceptsReturn="True" TextWrapping="Wrap" Height="110" Padding="8" Margin="0,4,0,10" VerticalScrollBarVisibility="Auto"/>
  <UniformGrid Columns="2"><StackPanel Margin="0,0,8,8"><TextBlock Text="العدد الموحد"/><TextBox x:Name="NumberText" Padding="8" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="8,0,0,8"><TextBlock Text="شهر الصادر · فارغ لاستخدام شهر البيانات"/><TextBox x:Name="OutgoingText" Padding="8" Margin="0,4,0,0"/></StackPanel></UniformGrid>
  <StackPanel x:Name="AccountSection"><TextBlock Text="حساب المستفيد لهذا الكتاب"/><TextBox x:Name="AccountText" FlowDirection="LeftToRight" Padding="8" Margin="0,4,0,5"/><CheckBox x:Name="ConfirmAccount" Content="اعتماد الحساب الظاهر للكتاب بعد مراجعته" Visibility="Collapsed" Margin="0,0,0,7"/><TextBlock Text="يحفظ لهذا الكتاب فقط. للجهة المنفردة حدّث قائمة الحسابات حتى تطابقه؛ تركه فارغاً يعيد حساب المرجع." TextWrapping="Wrap" Foreground="{DynamicResource Tfg718481}" Margin="0,0,0,9"/></StackPanel>
  <TextBlock Text="رقم وتاريخ عقد الإطعام · موحد لجميع الكتب"/><TextBox x:Name="FoodContractText" Padding="8" Margin="0,4,0,9"/><TextBlock Text="عضو اللجنة الأول"/><TextBox x:Name="FirstText" Padding="8" Margin="0,4,0,9"/><TextBlock Text="عضو اللجنة الثاني"/><TextBox x:Name="SecondText" Padding="8" Margin="0,4,0,9"/><TextBlock Text="عضو اللجنة الثالث"/><TextBox x:Name="ThirdText" Padding="8" Margin="0,4,0,9"/>
  <TextBlock Text="موضع اللجنة · من ٦٠- إلى ٦٠، الموجب إلى الأسفل"/><TextBox x:Name="OffsetText" Padding="8" Margin="0,4,0,9"/><TextBlock Text="الهامش السفلي"/><TextBox x:Name="FooterText" AcceptsReturn="True" TextWrapping="Wrap" Height="75" Padding="8" Margin="0,4,0,9"/>
  <TextBlock Text="شهر متن الكتاب · فارغ لاستخدام شهر البيانات"/><TextBox x:Name="BodyMonthText" Padding="8" Margin="0,4,0,9"/><TextBlock Text="متن الكتاب"/><TextBlock Text="اترك الحقول بين الأقواس كما هي. تعديل المتن يحفظ لهذا الكتاب فقط." Foreground="{DynamicResource Tfg718481}" TextWrapping="Wrap"/><TextBox x:Name="BodyText" AcceptsReturn="True" TextWrapping="Wrap" Height="140" Padding="8" Margin="0,4,0,10" VerticalScrollBarVisibility="Auto"/>
 </StackPanel></ScrollViewer></DockPanel>
</Window>
