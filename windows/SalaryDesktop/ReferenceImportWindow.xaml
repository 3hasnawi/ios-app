<Window x:Class="SalaryDesktop.ReferenceImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="استيراد مراجع الكتب" Width="880" Height="720" MinWidth="650" MinHeight="520" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI" Background="#F1F4F6">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="استيراد مراجع الكتب" FontSize="23" FontWeight="Bold"/><TextBlock Text="اختر مجلداً يحتوي ملفات PDF المدرجة بأسمائها الأصلية. تُقرأ محلياً وتُفحص قبل حفظها داخل النسخة." Grid.Row="1" TextWrapping="Wrap" Foreground="#718481" Margin="0,8,0,12"/>
  <Button x:Name="Choose" Grid.Row="2" Content="اختيار مجلد المراجع" Click="ChooseFolder" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Margin="0,0,0,12"/>
  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="Notice" Foreground="#A76716" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock TextWrapping="Wrap" LineHeight="25" Text="مجموعة مصارف الرافدين.pdf&#10;مجموعة مصارف الرشيد.pdf&#10;شركة عراق الجوال.pdf&#10;امانات ضريبة.pdf&#10;خزينة الانبار حماية اجتماعية وضريبة.pdf&#10;الضمان الاجتماعي.pdf&#10;امانات رواتب.pdf&#10;الرمادي.pdf&#10;صندوق الاسكان فرع الانبار.pdf&#10;الموارد المائية.pdf&#10;مصرف الرافدين فرع الانبار.pdf&#10;&#10;تنسيق ارقام عربية.pdf — اختياري لويندوز، ويُفضّل إضافته لتوافق مراجع الآيفون."/></StackPanel></ScrollViewer>
  <WrapPanel Grid.Row="4" Margin="0,12,0,0"><Button x:Name="SaveButton" Content="حفظ المراجع" Click="Save" Style="{StaticResource ActionButton}" IsEnabled="False"/><Button Content="إلغاء" IsCancel="True" Padding="18,9" Margin="12,0"/></WrapPanel>
 </Grid>
</Window>
