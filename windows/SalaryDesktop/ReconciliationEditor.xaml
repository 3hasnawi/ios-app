<Window x:Class="SalaryDesktop.ReconciliationEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بيانات المطابقة" Width="560" Height="720" MinHeight="460" MinWidth="480" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}" FontSize="14"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" ShowInTaskbar="False">
  <DockPanel Margin="22">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource PrimarySoft}"><TextBlock x:Name="HeadIcon" Style="{StaticResource Icon}" Text="&#xE787;" FontSize="19" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="HintText" Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button DockPanel.Dock="Left" Content="إلغاء" IsCancel="True" Padding="20,7"/>
      <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource ActionButton}" Click="Save" IsDefault="True" Padding="18,7">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Foreground="White" Margin="0,0,7,0"/><TextBlock Text="حفظ"/></StackPanel>
      </Button>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="FirstLabel" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/><TextBox x:Name="First" Height="36" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="DateLabel" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/><DatePicker x:Name="Date" Height="36" VerticalContentAlignment="Center"/>
        <StackPanel x:Name="PeriodFields">
          <TextBlock Text="نهاية الفترة · قبل التمويل الجديد" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/><DatePicker x:Name="EndDate" Height="36" VerticalContentAlignment="Center"/>
          <TextBlock Text="الرصيد الافتتاحي" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/><TextBox x:Name="Opening" Height="36" VerticalContentAlignment="Center"/>
          <TextBlock Text="أدخل التمويل كحركة دائنة، ولا تضفه إلى الرصيد الافتتاحي مرة أخرى." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <!-- اللجنة كما في الآيفون: يمين الكشف العضو الأول، ويساره الثاني؛ الحقل الفارغ يأخذ القيمة الافتراضية. -->
          <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,12">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="عضو اللجنة الأول · يمين الكشف"/>
              <TextBlock Text="الرتبة" Style="{StaticResource SectionLabel}" Margin="0,8,0,4"/><TextBox x:Name="FirstRank" Height="34" VerticalContentAlignment="Center" Tag="عقيد الشرطة"/>
              <TextBlock Text="الاسم" Style="{StaticResource SectionLabel}" Margin="0,8,0,4"/><TextBox x:Name="MemberFirst" Height="34" VerticalContentAlignment="Center"/>
              <TextBlock Text="المنصب" Style="{StaticResource SectionLabel}" Margin="0,8,0,4"/><TextBox x:Name="FirstPosition" Height="34" VerticalContentAlignment="Center" Tag="مدير قسم التدقيق والرقابة الداخلية"/>
              <TextBlock Text="التاريخ (فارغ = الشهر والسنة من نهاية الفترة)" Style="{StaticResource SectionLabel}" Margin="0,8,0,4"/><TextBox x:Name="FirstDate" Height="34" VerticalContentAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,12">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="عضو اللجنة الثاني · يسار الكشف"/>
              <TextBlock Text="الرتبة" Style="{StaticResource SectionLabel}" Margin="0,8,0,4"/><TextBox x:Name="SecondRank" Height="34" VerticalContentAlignment="Center" Tag="العميد"/>
              <TextBlock Text="الاسم" Style="{StaticResource SectionLabel}" Margin="0,8,0,4"/><TextBox x:Name="MemberSecond" Height="34" VerticalContentAlignment="Center"/>
              <TextBlock Text="المنصب" Style="{StaticResource SectionLabel}" Margin="0,8,0,4"/><TextBox x:Name="SecondPosition" Height="34" VerticalContentAlignment="Center" Tag="مدير الحسابات"/>
              <TextBlock Text="التاريخ (فارغ = الشهر والسنة من نهاية الفترة)" Style="{StaticResource SectionLabel}" Margin="0,8,0,4"/><TextBox x:Name="SecondDate" Height="34" VerticalContentAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="MovementFields">
          <TextBlock Text="المبلغ بالدينار" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/><TextBox x:Name="Amount" Height="36" VerticalContentAlignment="Center"/>
          <TextBlock Text="نوع الحركة" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/>
          <ComboBox x:Name="Direction" Height="36" VerticalContentAlignment="Center" SelectedIndex="0"><ComboBoxItem Content="دائن · وارد"/><ComboBoxItem Content="مدين · مصروف"/></ComboBox>
          <CheckBox x:Name="Funding" Content="تمويل الشهر" Margin="0,12,0,4"/>
          <CheckBox x:Name="Refund" Content="وارد مسترجع من جهة" Margin="0,4"/>
          <TextBlock Text="ربط الصرف بوارد مسترجع (اختياري)" Style="{StaticResource SectionLabel}" Margin="0,12,0,4"/><ComboBox x:Name="RefundOf" Height="36" VerticalContentAlignment="Center" DisplayMemberPath="Label"/>
          <TextBlock Text="أدخل تاريخ التنفيذ كما يظهر في كشف المصرف؛ تأكيد كتاب أو احتساب راتب لا يثبت تنفيذ حركة مصرفية." Foreground="{DynamicResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
