<Window x:Class="SalaryDesktop.AnnualImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="استيراد الاستقطاعات السنوية" Width="1050" Height="720" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}" Background="#F1F4F6">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="استيراد الاستقطاعات السنوية" FontSize="23" FontWeight="SemiBold"/>
  <Button x:Name="Choose" Grid.Row="1" Content="اختيار ملف Excel السنوي" Click="ChooseFile" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Margin="0,12"/>
  <TextBlock x:Name="Notice" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#A76716" Text="يجب أن تتضمن تسمية الملف أو الورقة سنة واحدة، وأن يحتوي الملف على أعمدة الاسم والجهة والمبلغ والشهر."/>
  <TabControl Grid.Row="3"><TabItem Header="الأشهر"><DataGrid x:Name="MonthsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="الشهر" Binding="{Binding Month}" Width="2*"/><DataGridTextColumn Header="عدد الاستقطاعات" Binding="{Binding Count}" Width="*"/><DataGridTextColumn Header="الحالات غير النشطة" Binding="{Binding Inactive}" Width="*"/><DataGridTextColumn Header="المحفوظة حالياً" Binding="{Binding Existing}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
  <TabItem Header="القيود"><DataGrid x:Name="Rows" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="الشهر" Binding="{Binding Month}" Width="*"/><DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="الجهة" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="*"/><DataGridTextColumn Header="الملاحظة" Binding="{Binding Note}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
  <ScrollViewer Grid.Row="4" MaxHeight="110" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Problems"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="#A76716" TextWrapping="Wrap"><Run Text="{Binding Sheet}"/><Run Text=" · الصف "/><Run Text="{Binding Row}"/><Run Text=" · "/><Run Text="{Binding Message}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="SaveButton" Content="حفظ الأشهر" Click="Save" Style="{StaticResource ActionButton}" IsEnabled="False"/><Button Content="إلغاء" IsCancel="True" Padding="16,8" Margin="10,0"/></StackPanel>
 </Grid>
</Window>
