<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>false</TreatWarningsAsErrors></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="plist-cil" Version="2.3.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.9" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <None Include="$(MSBuildProjectDirectory)/obj/native-bin/lzfse.dll" Link="lzfse.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildProjectDirectory)/obj/native-bin/LZFSE-LICENSE.txt" Link="LZFSE-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildCompression" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'" Inputs="../Native/CMakeLists.txt" Outputs="obj/native-bin/lzfse.dll">
    <Exec Command="cmake -S ../Native -B obj/native-build -A x64" />
    <Exec Command="cmake --build obj/native-build --config Release" />
    <Exec Command="cmake --install obj/native-build --config Release --prefix obj/native-bin" />
  </Target>
</Project>
