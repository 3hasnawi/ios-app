<Application ThemeMode="System" x:Class="AnbarPayroll.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:AnbarPayroll.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Application.Resources>
  <local:DisplayNumberConverter x:Key="NumeralConverter"/>
  <DataTemplate x:Key="DisplayNumberItem"><TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource NumeralConverter}}"/></DataTemplate>
  <DataTemplate x:Key="NumeralExamples">
    <TextBlock Text="{Binding}" Language="en-US" NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="en-US" NumberSubstitution.Substitution="European"/>
  </DataTemplate>
  <Style TargetType="Window"><Setter Property="NumberSubstitution.Substitution" Value="European"/><Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}"/><Setter Property="FontFamily" Value="Arial"/><Setter Property="FontSize" Value="{DynamicResource UiFont15}"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="FlowDirection" Value="RightToLeft"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#91AB9A"/><Setter TargetName="surface" Property="Opacity" Value=".90"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value=".75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#BB852D"/><Setter TargetName="surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="FieldSurface" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/>
  </Style>
  <Style x:Key="FieldControl" TargetType="Control">
    <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="Padding" Value="9,6"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="ItemSurface" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent">
        <ContentPresenter ContentSource="Content" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <ControlTemplate x:Key="ChoiceField" TargetType="ComboBox">
    <Grid>
      <Border x:Name="Surface" Style="{StaticResource FieldSurface}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"/>
      <ToggleButton x:Name="FieldToggle" Style="{x:Null}" OverridesDefaultStyle="True"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" Padding="0" BorderThickness="0"
                    Height="{TemplateBinding Height}" Background="Transparent" Focusable="False" ClickMode="Press" IsTabStop="False"
                    IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <Grid Margin="{TemplateBinding Padding}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="CalendarIcon" Visibility="Collapsed" IsHitTestVisible="False" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE787;" Margin="0,0,7,0" VerticalAlignment="Center"/>
        <ContentPresenter x:Name="SelectedContent" Grid.Column="1" IsHitTestVisible="False" VerticalAlignment="Center"
                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
        <TextBlock x:Name="MonthHint" Grid.Column="1" Visibility="Collapsed" IsHitTestVisible="False" Text="شهر العمل" VerticalAlignment="Center"/>
        <TextBox x:Name="PART_EditableTextBox" Grid.Column="1" Visibility="Collapsed" Focusable="True" Style="{x:Null}" MinWidth="0"
                 IsReadOnly="{TemplateBinding IsReadOnly}" Foreground="{TemplateBinding Foreground}" Background="Transparent"
                 CaretBrush="{TemplateBinding Foreground}" BorderThickness="0" Padding="0" VerticalContentAlignment="Center">
          <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"/></ControlTemplate></TextBox.Template>
        </TextBox>
        <TextBlock Grid.Column="2" IsHitTestVisible="False" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"/>
      </Grid>
      <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
        <Border Style="{StaticResource FieldSurface}" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="3">
          <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="Tag" Value="WorkingMonth"><Setter TargetName="CalendarIcon" Property="Visibility" Value="Visible"/></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="WorkingMonth"/><Condition Property="SelectedIndex" Value="-1"/></MultiTrigger.Conditions><Setter TargetName="MonthHint" Property="Visibility" Value="Visible"/></MultiTrigger>
      <Trigger Property="IsEditable" Value="True">
        <Setter Property="IsTabStop" Value="False"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
        <Setter TargetName="SelectedContent" Property="Visibility" Value="Hidden"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/></Trigger>
      <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="ComboBox" BasedOn="{StaticResource FieldControl}">
    <Setter Property="Template" Value="{StaticResource ChoiceField}"/>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource FieldControl}">
    <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Surface" Style="{StaticResource FieldSurface}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DatePicker" BasedOn="{StaticResource FieldControl}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
      <Grid>
        <Border x:Name="Surface" Style="{StaticResource FieldSurface}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Padding="4,1">
          <DockPanel>
            <Button x:Name="PART_Button" DockPanel.Dock="Right" Padding="4,0" BorderThickness="0" Background="Transparent" Focusable="False"
                    ToolTip="اختيار التاريخ" AutomationProperties.Name="اختيار التاريخ">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE787;" FontSize="16"/>
            </Button>
            <DatePickerTextBox x:Name="PART_TextBox" Background="Transparent" Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding Foreground}" BorderThickness="0" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
          </DockPanel>
        </Border>
        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Padding" Value="12,6"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <Border x:Name="TabSurface" Style="{StaticResource FieldSurface}" Padding="{TemplateBinding Padding}" Margin="2">
        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="RowBackground" Value="{DynamicResource ControlSolidFillColorDefaultBrush}"/><Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/><Setter Property="RowHeight" Value="{DynamicResource TableRowHeight}"/><Setter Property="ColumnHeaderHeight" Value="{DynamicResource TableHeaderHeight}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/><Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="Padding" Value="7,3"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/></Trigger></Style.Triggers>
  </Style>
</Application.Resources></Application>
