<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework><SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion><UseWPF>true</UseWPF><OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>AnbarPayroll</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0</Version><ApplicationIcon>AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../SalaryApp/Assets.xcassets/IraqEmblem.imageset/IraqEmblem.png" Link="IraqEmblem.png" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../Core/Payroll.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="OneDriveTrialWindow.cs" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
    <None Include="$(BaseIntermediateOutputPath)payroll-sync.exe" Link="payroll-sync.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CompileWorkspaceSync" BeforeTargets="PrepareForBuild">
    <Exec WorkingDirectory="../../sync/workspace" Command="go build -trimpath -o &quot;$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)payroll-sync.exe&quot; ./cmd/desktop" EnvironmentVariables="GOOS=windows;GOARCH=amd64;CGO_ENABLED=0" />
  </Target>
</Project>
