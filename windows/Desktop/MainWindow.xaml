<Window x:Class="AnbarPayroll.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:AnbarPayroll.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Arial" FlowDirection="RightToLeft" NumberSubstitution.Substitution="European" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Title="قسم الحسابات | الرواتب والاستقطاعات" Width="1366" Height="840" MinWidth="540" MinHeight="360" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource ApplicationBackgroundBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
<Window.Resources>
  <Style x:Key="NavigationRow" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#F4FBF7"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
    <Setter Property="MinHeight" Value="47"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="{DynamicResource UiFont16}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
            <Border x:Name="Hover" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="8"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="{TemplateBinding BorderBrush}" Height="20" CornerRadius="1.5"/>
              <Border x:Name="IconSlot" Grid.ColumnSpan="2" Width="24" Margin="10,0" HorizontalAlignment="Left">
                <TextBlock Text="{Binding}" FlowDirection="LeftToRight" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="20" TextAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="Label" Grid.ColumnSpan="2" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                         Margin="38,5" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
            <Border x:Name="FocusRing" Margin="2" CornerRadius="6" BorderThickness="1" Visibility="Collapsed"
                    BorderBrush="{TemplateBinding Foreground}" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Compact">
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="IconSlot" Property="HorizontalAlignment" Value="Center"/>
              <Setter TargetName="IconSlot" Property="Margin" Value="0"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.07"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.14"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CurrentNavigationRow" TargetType="Button" BasedOn="{StaticResource NavigationRow}">
    <Setter Property="Background" Value="#D9EFE2"/>
    <Setter Property="Foreground" Value="#143E31"/>
    <Setter Property="BorderBrush" Value="#307651"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
</Window.Resources>
<Grid Background="{DynamicResource ApplicationBackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border x:Name="SidePanel" Background="#173F37" Padding="13,22,13,14">
  <DockPanel>
    <Border x:Name="Brand" DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="#3F6157" Padding="0,0,0,16" Margin="0,0,0,12">
      <StackPanel>
        <Border Width="30" Height="30" CornerRadius="8" BorderThickness="1" BorderBrush="#56766B" HorizontalAlignment="Center">
          <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE736;" FontSize="18" Foreground="#D6E9DE"
                     VerticalAlignment="Center" TextAlignment="Center"/>
        </Border>
        <TextBlock Text="قسم الحسابات" FontSize="{DynamicResource UiFont23}" FontWeight="Bold" Foreground="White" TextAlignment="Center" Margin="0,7,0,0"/>
        <TextBlock Text="قيادة شرطة محافظة الأنبار" FontSize="{DynamicResource UiFont12}" Foreground="#BED7CD" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>
    <TextBlock x:Name="NavFoot" DockPanel.Dock="Bottom" Text="بيانات محلية على هذه الحاسبة" TextAlignment="Center" TextWrapping="Wrap" Foreground="#CEE0D5" FontSize="{DynamicResource UiFont12}"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel x:Name="Nav"/></ScrollViewer>
  </DockPanel>
</Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="{DynamicResource ControlSolidFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition MinWidth="40"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Grid Grid.Column="0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Button x:Name="BackButton" Grid.Column="0" Height="40" Padding="0" Click="BackClick" IsEnabled="False"
          VerticalAlignment="Center" HorizontalContentAlignment="Center" ToolTip="الرجوع" AutomationProperties.Name="الرجوع">
    <TextBlock FlowDirection="LeftToRight" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72B;" FontSize="17"/>
  </Button>
</Grid>
<TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" x:Name="PageTitle" Grid.Column="1" FontWeight="Bold" FontSize="{DynamicResource UiFont19}" TextAlignment="Center" VerticalAlignment="Center"/>
<TextBlock Grid.Column="1" Text="البحث الشامل" Visibility="{Binding Visibility, ElementName=SearchLayer}" FontWeight="Bold" FontSize="{DynamicResource UiFont19}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
<Viewbox x:Name="SyncTransferIndicator" Grid.Column="3" Width="15" Height="15"
         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" IsHitTestVisible="False"
         RenderTransformOrigin=".5,.5" AutomationProperties.Name="جارٍ نقل بيانات OneDrive">
  <Viewbox.RenderTransform><RotateTransform x:Name="SyncTransferRotation"/></Viewbox.RenderTransform>
  <Canvas Width="24" Height="24" FlowDirection="LeftToRight">
    <Path Stroke="{DynamicResource SystemFillColorSuccessBrush}" StrokeThickness="2" StrokeStartLineCap="Round"
          StrokeEndLineCap="Round" StrokeLineJoin="Round"
          Data="M3,10 A9,9 0 0 1 18.2,5.5 L21,8 M21,3 V8 H16 M21,14 A9,9 0 0 1 5.8,18.5 L3,16 M3,21 V16 H8"/>
  </Canvas>
</Viewbox>
<ComboBox Grid.Column="2" x:Name="Period" Tag="WorkingMonth" ItemTemplate="{StaticResource DisplayNumberItem}" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center"
          ToolTip="شهر العمل" AutomationProperties.Name="شهر العمل" SelectionChanged="PeriodChanged"/>
<Button x:Name="AccountDirectoryButton" Grid.Column="4" Height="40" Margin="6,0,0,0" Click="OpenAccountDirectory" ToolTip="دليل الحسابات المصرفية (IBAN)" AutomationProperties.Name="دليل الحسابات المصرفية" Content="حسابات IBAN"/>
</Grid></Border>
<DockPanel Grid.Row="1">
  <Button x:Name="UpdateNotice" DockPanel.Dock="Top" Visibility="Collapsed" Click="OpenUpdate" HorizontalContentAlignment="Center" Margin="8,4" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
  <WrapPanel x:Name="TransferTabs" DockPanel.Dock="Top" Margin="10,6,10,0" Visibility="Collapsed" AutomationProperties.Name="أقسام التحويلات"/>
  <Grid>
  <ScrollViewer x:Name="BodyViewport" Margin="26,22,26,10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid x:Name="CanvasArea" Width="{Binding ViewportWidth, ElementName=BodyViewport}" Height="{Binding ViewportHeight, ElementName=BodyViewport}" MinWidth="628" MinHeight="400"/>
  </ScrollViewer>
  <Grid x:Name="SearchLayer" Visibility="Collapsed" Margin="{Binding Margin, ElementName=BodyViewport}"/>
  </Grid>
</DockPanel>
<Border Grid.Row="2" Background="{DynamicResource ControlSolidFillColorDefaultBrush}" Padding="25,6"><StackPanel><ProgressBar x:Name="SyncOperationProgress" Visibility="Collapsed" Height="4" Margin="0,0,0,4" AutomationProperties.Name="تقدم المزامنة"/><local:DisplayText x:Name="Status" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{DynamicResource UiFont12}" TextWrapping="Wrap"/></StackPanel></Border></Grid>
</Grid></Window>
