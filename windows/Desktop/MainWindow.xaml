<Window x:Class="AnbarPayroll.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:AnbarPayroll.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Arial" FlowDirection="RightToLeft" Foreground="#193B34" Title="قسم الحسابات | الرواتب والاستقطاعات" Width="1366" Height="840" MinWidth="540" MinHeight="360" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#F2F5F1" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
<Grid Background="#F2F5F1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="194"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border x:Name="SidePanel" Background="#153F37" Padding="17,30,17,18"><DockPanel>
<StackPanel x:Name="Brand" DockPanel.Dock="Top" Margin="6,0,0,36"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE80F;" FontSize="26" Foreground="#BADECE" Margin="0,0,0,14"/>
<TextBlock Text="قسم الحسابات" FontSize="{DynamicResource UiFont23}" FontWeight="Bold" Foreground="White"/><TextBlock Text="قيادة شرطة محافظة الأنبار" FontSize="{DynamicResource UiFont12}" Foreground="#CDDFD3" Margin="0,5,0,0"/></StackPanel>
<TextBlock x:Name="NavFoot" DockPanel.Dock="Bottom" Text="بيانات محلية على هذه الحاسبة" Foreground="#CEE0D5" FontSize="{DynamicResource UiFont12}"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Nav"/></ScrollViewer></DockPanel></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="White" BorderBrush="#D6E1D9" BorderThickness="0,0,0,1" Padding="25,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Button x:Name="SearchButton" Height="40" Click="SearchClick" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="البحث الشامل (Ctrl+K)">البحث الشامل　 Ctrl+K</Button>
<TextBlock x:Name="PageTitle" Grid.Column="1" FontWeight="Bold" FontSize="{DynamicResource UiFont19}" TextAlignment="Center" VerticalAlignment="Center"/>
<ComboBox Grid.Column="2" x:Name="Period" ItemTemplate="{StaticResource DisplayNumberItem}" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center"
          ToolTip="شهر العمل" AutomationProperties.Name="شهر العمل" SelectionChanged="PeriodChanged">
  <ComboBox.Template>
    <ControlTemplate TargetType="ComboBox">
      <Grid>
        <Button x:Name="MonthButton" Focusable="False" Click="OpenMonthList" AutomationProperties.Name="اختيار الشهر">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE787;" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="MonthText" Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NumeralConverter}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70D;" Margin="7,0,0,0" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
          <Border Background="White" BorderBrush="#CCDAD2" BorderThickness="1" CornerRadius="7" Padding="3" Margin="0,2,0,0"
                  MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, ElementName=MonthButton}">
            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="SelectedIndex" Value="-1"><Setter TargetName="MonthText" Property="Text" Value="شهر العمل"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="MonthButton" Property="BorderBrush" Value="#BB852D"/></Trigger>
        <Trigger Property="HasItems" Value="False"><Setter TargetName="MonthButton" Property="IsEnabled" Value="False"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </ComboBox.Template>
</ComboBox></Grid></Border>
<DockPanel Grid.Row="1">
  <Button x:Name="UpdateNotice" DockPanel.Dock="Top" Visibility="Collapsed" Click="OpenUpdate" HorizontalContentAlignment="Center" Margin="8,4" Background="#D8EEE0"/>
  <ScrollViewer x:Name="BodyViewport" Margin="26,22,26,10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid x:Name="CanvasArea" Width="{Binding ViewportWidth, ElementName=BodyViewport}" Height="{Binding ViewportHeight, ElementName=BodyViewport}" MinWidth="628" MinHeight="400"/>
  </ScrollViewer>
</DockPanel>
<Border Grid.Row="2" Background="White" Padding="25,6"><local:DisplayText x:Name="Status" Foreground="#50645A" FontSize="{DynamicResource UiFont12}" TextWrapping="Wrap"/></Border></Grid>
</Grid></Window>
