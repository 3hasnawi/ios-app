<Window x:Class="AnbarPayroll.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Arial" FlowDirection="RightToLeft" Foreground="#193B34" Title="قسم الحسابات | الرواتب والاستقطاعات" Width="1366" Height="840" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#F2F5F1" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
<Grid Background="#F2F5F1"><Grid.ColumnDefinitions><ColumnDefinition Width="194"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#153F37" Padding="17,30,17,18"><DockPanel>
<StackPanel DockPanel.Dock="Top" Margin="6,0,0,36"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE80F;" FontSize="26" Foreground="#BADECE" Margin="0,0,0,14"/>
<TextBlock Text="قسم الحسابات" FontSize="23" FontWeight="Bold" Foreground="White"/><TextBlock Text="قيادة شرطة محافظة الأنبار" FontSize="12" Foreground="#CDDFD3" Margin="0,5,0,0"/></StackPanel>
<TextBlock DockPanel.Dock="Bottom" Text="بيانات محلية على هذه الحاسبة" Foreground="#CEE0D5" FontSize="12"/><StackPanel x:Name="Nav"/></DockPanel></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="White" BorderBrush="#D6E1D9" BorderThickness="0,0,0,1" Padding="25,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Button Click="SearchClick" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="البحث الشامل (Ctrl+K)">البحث الشامل　 Ctrl+K</Button>
<TextBlock x:Name="PageTitle" Grid.Column="1" FontWeight="Bold" FontSize="19" TextAlignment="Center" VerticalAlignment="Center"/>
<ComboBox Grid.Column="2" x:Name="Period" HorizontalAlignment="Left" MinWidth="159" VerticalAlignment="Center" ToolTip="شهر العمل" SelectionChanged="PeriodChanged"/></Grid></Border>
<Grid Grid.Row="1" x:Name="CanvasArea" Margin="26,22,26,10"/>
<Border Grid.Row="2" Background="White" Padding="25,6"><TextBlock x:Name="Status" Foreground="#50645A" FontSize="12" TextWrapping="Wrap"/></Border></Grid>
</Grid></Window>
