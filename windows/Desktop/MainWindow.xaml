<Window x:Class="AnbarPayroll.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:AnbarPayroll.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Arial" FlowDirection="RightToLeft" NumberSubstitution.Substitution="European" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Title="قسم الحسابات | الرواتب والاستقطاعات" Width="1366" Height="840" MinWidth="540" MinHeight="360" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource ApplicationBackgroundBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
<Grid Background="{DynamicResource ApplicationBackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="194"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border x:Name="SidePanel" Background="#153F37" Padding="17,30,17,18"><DockPanel>
<StackPanel x:Name="Brand" DockPanel.Dock="Top" Margin="6,0,0,36"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE80F;" FontSize="26" Foreground="#BADECE" Margin="0,0,0,14"/>
<TextBlock Text="قسم الحسابات" FontSize="{DynamicResource UiFont23}" FontWeight="Bold" Foreground="White"/><TextBlock Text="قيادة شرطة محافظة الأنبار" FontSize="{DynamicResource UiFont12}" Foreground="#CDDFD3" Margin="0,5,0,0"/></StackPanel>
<TextBlock x:Name="NavFoot" DockPanel.Dock="Bottom" Text="بيانات محلية على هذه الحاسبة" Foreground="#CEE0D5" FontSize="{DynamicResource UiFont12}"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Nav"/></ScrollViewer></DockPanel></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="{DynamicResource ControlSolidFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition MinWidth="40"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Grid Grid.Column="0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Button x:Name="BackButton" Grid.Column="0" Height="40" Padding="0" Click="BackClick" IsEnabled="False"
          VerticalAlignment="Center" HorizontalContentAlignment="Center" ToolTip="الرجوع" AutomationProperties.Name="الرجوع">
    <TextBlock FlowDirection="LeftToRight" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72B;" FontSize="17"/>
  </Button>
</Grid>
<TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" x:Name="PageTitle" Grid.Column="1" FontWeight="Bold" FontSize="{DynamicResource UiFont19}" TextAlignment="Center" VerticalAlignment="Center"/>
<TextBlock Grid.Column="1" Text="البحث الشامل" Visibility="{Binding Visibility, ElementName=SearchLayer}" FontWeight="Bold" FontSize="{DynamicResource UiFont19}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
<ComboBox Grid.Column="2" x:Name="Period" Tag="WorkingMonth" ItemTemplate="{StaticResource DisplayNumberItem}" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center"
          ToolTip="شهر العمل" AutomationProperties.Name="شهر العمل" SelectionChanged="PeriodChanged"/>
<Button x:Name="AccountDirectoryButton" Grid.Column="3" Height="40" Margin="6,0,0,0" Click="OpenAccountDirectory" ToolTip="دليل الحسابات المصرفية (IBAN)" AutomationProperties.Name="دليل الحسابات المصرفية" Content="حسابات IBAN"/>
</Grid></Border>
<DockPanel Grid.Row="1">
  <Button x:Name="UpdateNotice" DockPanel.Dock="Top" Visibility="Collapsed" Click="OpenUpdate" HorizontalContentAlignment="Center" Margin="8,4" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
  <WrapPanel x:Name="TransferTabs" DockPanel.Dock="Top" Margin="10,6,10,0" Visibility="Collapsed" AutomationProperties.Name="أقسام التحويلات"/>
  <Grid>
  <ScrollViewer x:Name="BodyViewport" Margin="26,22,26,10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid x:Name="CanvasArea" Width="{Binding ViewportWidth, ElementName=BodyViewport}" Height="{Binding ViewportHeight, ElementName=BodyViewport}" MinWidth="628" MinHeight="400"/>
  </ScrollViewer>
  <Grid x:Name="SearchLayer" Visibility="Collapsed" Margin="{Binding Margin, ElementName=BodyViewport}"/>
  </Grid>
</DockPanel>
<Border Grid.Row="2" Background="{DynamicResource ControlSolidFillColorDefaultBrush}" Padding="25,6"><local:DisplayText x:Name="Status" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{DynamicResource UiFont12}" TextWrapping="Wrap"/></Border></Grid>
</Grid></Window>
