<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>AlRawatib</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="'$(PayloadPath)' != ''">
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="SalaryApp.Payload.zip" />
  </ItemGroup>
  <Target Name="CheckPayload" BeforeTargets="PrepareForBuild" Condition="'$(PayloadPath)' == '' Or !Exists('$(PayloadPath)')">
    <Error Text="PayloadPath must point to the published SalaryWindows ZIP." />
  </Target>
</Project>
