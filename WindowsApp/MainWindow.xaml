<Window x:Class="SalaryWindows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="الرواتب">
  <Grid RequestedTheme="Light" FlowDirection="RightToLeft" Background="#F3F6F4">
    <Grid.Resources>
      <Style x:Key="NavButton" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Padding" Value="14,11"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#24443B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="10"/></Style>
      <Style x:Key="ResultItemStyle" TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/></Style>
      <DataTemplate x:Key="ResultCardTemplate"><Border Background="White" BorderBrush="#E4ECE7" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,8"><StackPanel Spacing="6"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="#1A3D32" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" FontSize="14" Foreground="#65796E" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate>
      <DataTemplate x:Key="BankRowTemplate"><Grid Padding="8,11" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontSize="15" Foreground="#263E36" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="SemiBold" FontSize="15" Foreground="#173D32" FlowDirection="LeftToRight"/></Grid></DataTemplate>
    </Grid.Resources>
    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="White" BorderBrush="#E4ECE7" BorderThickness="0,0,1,0" Padding="18,24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="5">
      <TextBlock Text="الرواتب" FontSize="28" FontWeight="Bold" Foreground="#143F33" Margin="10,0,0,0"/>
      <TextBlock Text="نسخة ويندوز · قراءة فقط" Foreground="#64736C" Margin="10,0,0,18"/>
      <Button Style="{StaticResource NavButton}" Content="⌂   الرئيسية" Click="Home_Click"/>
      <Button Style="{StaticResource NavButton}" Content="⌕   البحث الشامل" Click="SearchPage_Click"/>
      <Button Style="{StaticResource NavButton}" Content="▤   التقارير والجهات" Click="Reports_Click"/>
      <Button Style="{StaticResource NavButton}" Content="▤   بنود الرواتب" Click="PayrollReports_Click"/>
      <Button Style="{StaticResource NavButton}" Content="▥   كشف البنك" Click="Bank_Click"/>
      <Button Style="{StaticResource NavButton}" Content="✓   التدقيق" Click="Audit_Click"/>
      <Button Style="{StaticResource NavButton}" Content="☷   الملاك" Click="Staff_Click"/>
      <Button Style="{StaticResource NavButton}" Content="▣   الكتب الرسمية" Click="Books_Click"/>
      <Button Style="{StaticResource NavButton}" Content="⚙   الإعدادات" Click="Settings_Click"/>
      <Button Content="فتح نسخة احتياطية" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,20,0,0" Background="#155D49" Foreground="White" Click="Connect_Click"/>
    </StackPanel></ScrollViewer></Border>
    <ScrollViewer Grid.Column="1" Padding="32" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">
      <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="5"><TextBlock x:Name="PageTitle" Text="الرئيسية" FontSize="30" FontWeight="Bold" Foreground="#173C32"/><TextBlock x:Name="StatusText" Text="اختر نسخة احتياطية لعرض البيانات" Foreground="#61726A" TextWrapping="Wrap"/></StackPanel>
        <ComboBox Grid.Column="1" x:Name="MonthPicker" PlaceholderText="الشهر" MinWidth="180" SelectionChanged="MonthChanged"/>
      </Grid>
      <StackPanel x:Name="HomePanel" Spacing="20">
        <Border Background="#143F33" CornerRadius="18" Padding="28"><StackPanel Spacing="10">
          <TextBlock Text="صافي الرواتب" Foreground="#DBE9E2" FontSize="18"/><TextBlock x:Name="NetText" Text="—" FontSize="36" FontWeight="Bold" Foreground="White"/>
          <TextBlock x:Name="CountText" Text="عدد الموظفين: —" Foreground="#DBE9E2"/><TextBlock x:Name="CategoriesText" Text="ضباط —   ·   موظفون —   ·   مراتب —   ·   عقود —" Foreground="#DBE9E2" TextWrapping="Wrap"/>
        </StackPanel></Border>
        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Background="White" CornerRadius="14" Padding="24"><StackPanel Spacing="10"><TextBlock Text="التقارير" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="كشوف الرواتب وجهات التنفيذ" Foreground="#64736C"/><Button Content="عرض الجهات" Click="Reports_Click"/></StackPanel></Border>
          <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="24"><StackPanel Spacing="10"><TextBlock Text="تدقيق الرواتب" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="فحوص ومقارنة البيانات" Foreground="#64736C"/><Button Content="عرض الفحوص" Click="Audit_Click"/></StackPanel></Border>
        </Grid>
      </StackPanel>
      <StackPanel x:Name="SearchPanel" Visibility="Collapsed" Spacing="14">
        <TextBox x:Name="SearchBox" PlaceholderText="ابحث عن موظف أو جهة تنفيذ أو كتاب" TextChanged="SearchChanged"/><TextBlock x:Name="SearchStatus" Foreground="#61726A" Text="النتائج من الشهر المحدد."/>
        <ListView x:Name="SearchResults" MaxHeight="600" SelectionMode="None" ItemClick="Item_Click" IsItemClickEnabled="True" ItemTemplate="{StaticResource ResultCardTemplate}" ItemContainerStyle="{StaticResource ResultItemStyle}"/>
      </StackPanel>
      <StackPanel x:Name="DataPanel" Visibility="Collapsed" Spacing="14">
        <ComboBox x:Name="ComparePicker" Visibility="Collapsed" Header="مقارنة بالشهر" MinWidth="200" HorizontalAlignment="Right" SelectionChanged="CompareChanged"/><TextBox x:Name="DataFilter" PlaceholderText="بحث في القائمة" TextChanged="DataFilterChanged"/><TextBlock x:Name="DataCaption" Foreground="#61726A" TextWrapping="Wrap"/>
        <ListView x:Name="DataResults" MaxHeight="600" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Item_Click" ItemTemplate="{StaticResource ResultCardTemplate}" ItemContainerStyle="{StaticResource ResultItemStyle}"/>
      </StackPanel>
      <StackPanel x:Name="BankPanel" Visibility="Collapsed" Spacing="16">
        <Border Background="#143F33" CornerRadius="18" Padding="26"><StackPanel Spacing="7"><TextBlock Text="المبلغ المطلوب" FontSize="16" Foreground="#D4E9DE"/><TextBlock x:Name="BankMonth" Foreground="#D4E9DE"/><TextBlock x:Name="BankTotal" Text="—" FontSize="34" FontWeight="Bold" Foreground="White"/><TextBlock Text="اضغط أي مبلغ أدناه لنسخه" Foreground="#D4E9DE"/></StackPanel></Border>
        <Border Background="#E6F2EB" CornerRadius="12" Padding="16"><TextBlock x:Name="BankStatus" Text="افتح نسخة احتياطية أولاً." Foreground="#235542" TextWrapping="Wrap"/></Border>
        <TextBlock Text="صافي الرواتب" FontSize="18" FontWeight="SemiBold" Foreground="#24463B"/>
        <Border Background="White" CornerRadius="14" Padding="12,4"><ListView x:Name="BankSalaryRows" ItemTemplate="{StaticResource BankRowTemplate}" ItemContainerStyle="{StaticResource ResultItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="BankItem_Click"/></Border>
        <TextBlock Text="مبالغ تضاف للرواتب" FontSize="18" FontWeight="SemiBold" Foreground="#24463B"/>
        <Border Background="White" CornerRadius="14" Padding="12,4"><ListView x:Name="BankManualRows" ItemTemplate="{StaticResource BankRowTemplate}" ItemContainerStyle="{StaticResource ResultItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="BankItem_Click"/></Border>
        <TextBlock Text="الاستقطاعات والمساهمات" FontSize="18" FontWeight="SemiBold" Foreground="#24463B"/>
        <Border Background="White" CornerRadius="14" Padding="12,4"><ListView x:Name="BankDeductionRows" ItemTemplate="{StaticResource BankRowTemplate}" ItemContainerStyle="{StaticResource ResultItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="BankItem_Click"/></Border>
      </StackPanel>
      <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="16">
        <TextBlock Text="النسخة الاحتياطية" FontSize="18" FontWeight="SemiBold" Foreground="#24463B"/>
        <Border Background="White" CornerRadius="14" Padding="22"><StackPanel Spacing="14"><TextBlock Text="عنوان السيرفر المحلي" FontWeight="SemiBold"/><TextBox x:Name="ServerAddress" PlaceholderText="http://192.168.1.10:8765" FlowDirection="LeftToRight"/><TextBlock Text="يُحفظ العنوان على هذا الجهاز فقط. يُطلب رمز الوصول عند فتح النسخة ولا يُحفظ." Foreground="#64736C" TextWrapping="Wrap"/><Button Content="حفظ العنوان" Click="SaveSettings_Click"/><TextBlock x:Name="SettingsMessage" Foreground="#237457" TextWrapping="Wrap"/></StackPanel></Border>
        <TextBlock Text="عرض كشف البنك" FontSize="18" FontWeight="SemiBold" Foreground="#24463B"/>
        <Border Background="White" CornerRadius="14" Padding="22"><CheckBox x:Name="HideZeroRows" Content="إخفاء البنود الصفرية في كشف البنك" Click="SaveSettings_Click"/></Border>
        <TextBlock Text="حول البرنامج" FontSize="18" FontWeight="SemiBold" Foreground="#24463B"/>
        <Border Background="White" CornerRadius="14" Padding="22"><StackPanel Spacing="8"><TextBlock Text="الرواتب لويندوز · إصدار تجريبي" FontWeight="SemiBold"/><TextBlock Text="يعرض بيانات النسخة الاحتياطية للقراءة فقط. حدّث البيانات بفتح أحدث نسخة." Foreground="#64736C" TextWrapping="Wrap"/><TextBlock Text="تطوير: Emad Hasnawi" Foreground="#64736C"/></StackPanel></Border>
      </StackPanel>
    </StackPanel></ScrollViewer>
  </Grid>
</Window>
