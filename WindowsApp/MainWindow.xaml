<Window x:Class="SalaryWindows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="الرواتب">
  <Grid x:Name="RootGrid" RequestedTheme="Light" FlowDirection="RightToLeft" Background="{ThemeResource AppPage}" TextElement.FontFamily="ms-appx:///Resources/Cairo.ttf#Cairo">
    <Grid.Resources>
      <Style x:Key="NavButton" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Padding" Value="14,11"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{ThemeResource AppText}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="10"/></Style>
      <Style x:Key="ResultItemStyle" TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/></Style>
      <DataTemplate x:Key="ResultCardTemplate"><Border Background="{ThemeResource AppCard}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,8"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{ThemeResource AppBadge}" CornerRadius="12" Width="44" Height="44"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding Glyph}" FontSize="18" Foreground="{ThemeResource AppAccent}"/></Border><StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{ThemeResource AppText}" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" Glyph="&#xE76B;" FontSize="14" Foreground="{ThemeResource AppArrow}" VerticalAlignment="Center"/></Grid></Border></DataTemplate>
      <DataTemplate x:Key="BankRowTemplate"><Grid Padding="8,11" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{ThemeResource AppText}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="SemiBold" Foreground="{ThemeResource AppText}" FlowDirection="LeftToRight"/></Grid></DataTemplate>
    </Grid.Resources>
    <Grid x:Name="AppContent">
    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{ThemeResource AppCard}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="0,0,1,0" Padding="18,24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="5">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,0,0,0"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="25" Foreground="{ThemeResource AppAccent}"/><TextBlock Text="الرواتب" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource AppText}"/></StackPanel>
      <TextBlock Text="نسخة ويندوز · إدارة البيانات" Foreground="{ThemeResource AppMuted}" Margin="10,0,0,18"/>
      <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Click="Home_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE80F;" FontSize="17"/><TextBlock Text="الرئيسية"/></StackPanel></Button>
      <Button x:Name="SearchNav" Style="{StaticResource NavButton}" Click="SearchPage_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE721;" FontSize="17"/><TextBlock Text="البحث الشامل"/></StackPanel></Button>
      <Button x:Name="ReportsNav" Style="{StaticResource NavButton}" Click="Reports_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="17"/><TextBlock Text="التقارير والجهات"/></StackPanel></Button>
      <Button x:Name="PayrollNav" Style="{StaticResource NavButton}" Click="PayrollReports_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D9;" FontSize="17"/><TextBlock Text="بنود الرواتب"/></StackPanel></Button>
      <Button x:Name="BankNav" Style="{StaticResource NavButton}" Click="Bank_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C7;" FontSize="17"/><TextBlock Text="كشف البنك"/></StackPanel></Button>
      <Button x:Name="AuditNav" Style="{StaticResource NavButton}" Click="Audit_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="17"/><TextBlock Text="التدقيق"/></StackPanel></Button>
      <Button x:Name="StaffNav" Style="{StaticResource NavButton}" Click="Staff_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE716;" FontSize="17"/><TextBlock Text="الملاك"/></StackPanel></Button>
      <Button x:Name="AccountsNav" Style="{StaticResource NavButton}" Click="Accounts_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C7;" FontSize="17"/><TextBlock Text="حسابات الجهات"/></StackPanel></Button>
      <Button x:Name="BooksNav" Style="{StaticResource NavButton}" Click="Books_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8F1;" FontSize="17"/><TextBlock Text="الكتب الرسمية"/></StackPanel></Button>
      <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="Settings_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="17"/><TextBlock Text="الإعدادات"/></StackPanel></Button>
      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,12" Margin="0,20,0,0" Background="#155D49" Foreground="White" Click="Connect_Click"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E5;" FontSize="17"/><TextBlock Text="فتح نسخة احتياطية"/></StackPanel></Button>
    </StackPanel></ScrollViewer></Border>
    <ScrollViewer Grid.Column="1" Padding="32" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">
      <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="5"><TextBlock x:Name="PageTitle" Text="الرئيسية" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource AppText}"/><TextBlock x:Name="StatusText" Text="اختر نسخة احتياطية لعرض البيانات" Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/></StackPanel>
        <ComboBox Grid.Column="1" x:Name="MonthPicker" PlaceholderText="الشهر" MinWidth="180" SelectionChanged="MonthChanged"/>
      </Grid>
      <StackPanel x:Name="HomePanel" Spacing="20">
        <Border Background="#143F33" CornerRadius="18" Padding="28"><StackPanel Spacing="10">
          <TextBlock Text="صافي الرواتب" Foreground="#DBE9E2" FontSize="18"/><TextBlock x:Name="NetText" Text="—" FontSize="36" FontWeight="Bold" Foreground="White"/>
          <TextBlock x:Name="CountText" Text="عدد الموظفين: —" Foreground="#DBE9E2"/><TextBlock x:Name="CategoriesText" Text="ضباط —   ·   موظفون —   ·   مراتب —   ·   عقود —" Foreground="#DBE9E2" TextWrapping="Wrap"/>
        </StackPanel></Border>
        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Background="{ThemeResource AppCard}" CornerRadius="14" Padding="24"><StackPanel Spacing="10"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="26" Foreground="{ThemeResource AppAccent}" HorizontalAlignment="Right"/><TextBlock Text="التقارير" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="كشوف الرواتب وجهات التنفيذ" Foreground="{ThemeResource AppMuted}"/><Button Content="عرض الجهات" Click="Reports_Click"/></StackPanel></Border>
          <Border Grid.Column="1" Background="{ThemeResource AppCard}" CornerRadius="14" Padding="24"><StackPanel Spacing="10"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="26" Foreground="{ThemeResource AppAccent}" HorizontalAlignment="Right"/><TextBlock Text="تدقيق الرواتب" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="فحوص ومقارنة البيانات" Foreground="{ThemeResource AppMuted}"/><Button Content="عرض الفحوص" Click="Audit_Click"/></StackPanel></Border>
        </Grid>
      </StackPanel>
      <StackPanel x:Name="SearchPanel" Visibility="Collapsed" Spacing="14">
        <TextBox x:Name="SearchBox" PlaceholderText="ابحث عن موظف أو جهة تنفيذ أو كتاب" TextChanged="SearchChanged"/><TextBlock x:Name="SearchStatus" Foreground="{ThemeResource AppMuted}" Text="النتائج من الشهر المحدد."/>
        <ListView x:Name="SearchResults" MaxHeight="600" SelectionMode="None" ItemClick="Item_Click" IsItemClickEnabled="True" ItemTemplate="{StaticResource ResultCardTemplate}" ItemContainerStyle="{StaticResource ResultItemStyle}"/>
      </StackPanel>
      <StackPanel x:Name="DataPanel" Visibility="Collapsed" Spacing="14">
        <Button x:Name="AddAccountButton" Content="إضافة حساب جهة" HorizontalAlignment="Right" Visibility="Collapsed" Click="AddAccount_Click"/>
        <ComboBox x:Name="ComparePicker" Visibility="Collapsed" Header="مقارنة بالشهر" MinWidth="200" HorizontalAlignment="Right" SelectionChanged="CompareChanged"/><TextBox x:Name="DataFilter" PlaceholderText="بحث في القائمة" TextChanged="DataFilterChanged"/><TextBlock x:Name="DataCaption" Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/>
        <ListView x:Name="DataResults" MaxHeight="600" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Item_Click" ItemTemplate="{StaticResource ResultCardTemplate}" ItemContainerStyle="{StaticResource ResultItemStyle}"/>
      </StackPanel>
      <StackPanel x:Name="BankPanel" Visibility="Collapsed" Spacing="16">
        <Border Background="#143F33" CornerRadius="18" Padding="26"><StackPanel Spacing="7"><TextBlock Text="المبلغ المطلوب" FontSize="16" Foreground="#D4E9DE"/><TextBlock x:Name="BankMonth" Foreground="#D4E9DE"/><TextBlock x:Name="BankTotal" Text="—" FontSize="34" FontWeight="Bold" Foreground="White"/><TextBlock Text="اضغط أي مبلغ أدناه لنسخه" Foreground="#D4E9DE"/></StackPanel></Border>
        <Border Background="{ThemeResource AppNotice}" CornerRadius="12" Padding="16"><TextBlock x:Name="BankStatus" Text="افتح نسخة احتياطية أولاً." Foreground="{ThemeResource AppNoticeText}" TextWrapping="Wrap"/></Border>
        <TextBlock Text="صافي الرواتب" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppText}"/>
        <Border Background="{ThemeResource AppCard}" CornerRadius="14" Padding="12,4"><ListView x:Name="BankSalaryRows" ItemTemplate="{StaticResource BankRowTemplate}" ItemContainerStyle="{StaticResource ResultItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="BankItem_Click"/></Border>
        <TextBlock Text="مبالغ تضاف للرواتب" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppText}"/>
        <Border Background="{ThemeResource AppCard}" CornerRadius="14" Padding="12,4"><ListView x:Name="BankManualRows" ItemTemplate="{StaticResource BankRowTemplate}" ItemContainerStyle="{StaticResource ResultItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="BankItem_Click"/></Border>
        <TextBlock Text="الاستقطاعات والمساهمات" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppText}"/>
        <Border Background="{ThemeResource AppCard}" CornerRadius="14" Padding="12,4"><ListView x:Name="BankDeductionRows" ItemTemplate="{StaticResource BankRowTemplate}" ItemContainerStyle="{StaticResource ResultItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="BankItem_Click"/></Border>
      </StackPanel>
      <StackPanel x:Name="SavedDataPanel" Visibility="Collapsed" Spacing="16">
        <Button Content="العودة للإعدادات" HorizontalAlignment="Right" Click="Settings_Click"/>
        <Border Background="#143F33" CornerRadius="18" Padding="26"><StackPanel Spacing="8"><TextBlock Text="حجم النسخة المفتوحة" Foreground="#D4E9DE"/><TextBlock x:Name="SavedTotal" Text="—" FontSize="30" FontWeight="Bold" Foreground="White"/><TextBlock Text="أحجام الأقسام محسوبة داخل ملف ZIP المضغوط." Foreground="#D4E9DE" TextWrapping="Wrap"/></StackPanel></Border>
        <TextBlock x:Name="SavedStatus" Text="افتح نسخة احتياطية أولاً." Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/>
        <Border Background="{ThemeResource AppCard}" CornerRadius="14" Padding="12,4"><ListView x:Name="SavedRows" ItemTemplate="{StaticResource BankRowTemplate}" ItemContainerStyle="{StaticResource ResultItemStyle}" SelectionMode="None"/></Border>
        <TextBlock Text="تعرض هذه الصفحة النسخة المفتوحة أثناء الجلسة. لا توجد قاعدة بيانات محلية دائمة حالياً." Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="16">
        <TextBlock Text="النسخ الاحتياطي والاتصال" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppText}"/>
        <Border Background="{ThemeResource AppCard}" CornerRadius="14" Padding="22"><StackPanel Spacing="12">
          <TextBlock Text="السيرفر المحلي" FontWeight="SemiBold"/><TextBox x:Name="ServerAddress" Header="عنوان السيرفر" PlaceholderText="http://192.168.1.10:8765" FlowDirection="LeftToRight"/>
          <PasswordBox x:Name="ServerToken" Header="رمز الوصول" FlowDirection="LeftToRight"/>
          <TextBlock Text="يُحفظ العنوان على هذا الجهاز؛ الرمز يبقى خلال جلسة التطبيق فقط." Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/>
          <StackPanel Spacing="8"><Button Content="حفظ العنوان" HorizontalAlignment="Right" Click="SaveSettings_Click"/><Button Content="اختبار الاتصال" HorizontalAlignment="Right" Click="TestServer_Click"/><Button Content="فتح آخر نسخة" HorizontalAlignment="Right" Click="LoadServer_Click"/></StackPanel>
          <Button Content="اختيار ملف نسخة احتياطية" HorizontalAlignment="Right" Click="OpenLocalBackup_Click"/>
          <TextBlock x:Name="ServerStatus" Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/>
          <TextBlock Text="المزامنة والرفع المتبادل غير متاحين حالياً. افتح آخر نسخة لتحديث البيانات." Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/>
        </StackPanel></Border>
        <TextBlock Text="البيانات المحفوظة" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppText}"/>
        <Border Background="{ThemeResource AppCard}" CornerRadius="14" Padding="22"><StackPanel Spacing="10"><TextBlock Text="راجع عدد السجلات وأحجامها داخل النسخة المفتوحة." Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/><Button Content="عرض البيانات المحفوظة" HorizontalAlignment="Right" Click="SavedData_Click"/></StackPanel></Border>
        <TextBlock Text="المظهر والخط" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppText}"/>
        <Border Background="{ThemeResource AppCard}" CornerRadius="14" Padding="22"><StackPanel Spacing="12">
          <ComboBox x:Name="AppearancePicker" Header="المظهر" HorizontalAlignment="Stretch" SelectionChanged="AppearanceChanged"><ComboBoxItem Content="فاتح" Tag="light"/><ComboBoxItem Content="داكن" Tag="dark"/><ComboBoxItem Content="حسب النظام" Tag="system"/></ComboBox>
          <ComboBox x:Name="FontSizePicker" Header="حجم الخط" HorizontalAlignment="Stretch" SelectionChanged="AppearanceChanged"><ComboBoxItem Content="صغير" Tag="14"/><ComboBoxItem Content="متوسط" Tag="16"/><ComboBoxItem Content="كبير" Tag="19"/></ComboBox>
          <TextBlock Text="الخط للواجهة: Cairo · خط الكشوف المصدّرة: Arial" Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/>
          <CheckBox x:Name="HideZeroRows" Content="إخفاء البنود الصفرية في كشف البنك" Click="SaveDisplaySettings_Click"/>
          <TextBlock x:Name="SettingsMessage" Foreground="{ThemeResource AppAccent}" TextWrapping="Wrap"/>
        </StackPanel></Border>
        <TextBlock Text="الأمان" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppText}"/>
        <Border Background="{ThemeResource AppCard}" CornerRadius="14" Padding="22"><StackPanel Spacing="12"><ToggleSwitch x:Name="LockToggle" Header="قفل واجهة التطبيق" OnContent="مفعّل" OffContent="متوقف" Toggled="LockToggled"/><TextBlock Text="يُقفل عند فتح التطبيق أو باختيار «قفل الآن». يستخدم Windows Hello البصمة أو الوجه أو رمز PIN الخاص بويندوز؛ لا يشفّر ملف النسخة الاحتياطية." Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/><Button x:Name="LockNowButton" Content="قفل الآن" HorizontalAlignment="Right" Click="LockNow_Click"/><TextBlock x:Name="SecurityMessage" Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/></StackPanel></Border>
        <TextBlock Text="حول البرنامج" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppText}"/>
        <Border Background="{ThemeResource AppCard}" CornerRadius="14" Padding="22"><StackPanel Spacing="8"><TextBlock Text="الرواتب لويندوز" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" Foreground="{ThemeResource AppMuted}"/><TextBlock Text="إدارة وعرض كشوف الرواتب والاستقطاعات والكتب الرسمية." Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/><TextBlock Text="تطوير: Emad Hasnawi" Foreground="{ThemeResource AppMuted}"/></StackPanel></Border>
      </StackPanel>
    </StackPanel></ScrollViewer>
    </Grid>
    <Grid x:Name="LockPanel" Visibility="Collapsed" Background="{ThemeResource AppPage}">
      <Border Background="{ThemeResource AppCard}" CornerRadius="20" Padding="34" Width="380" MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72E;" FontSize="34" Foreground="{ThemeResource AppAccent}" HorizontalAlignment="Center"/><TextBlock Text="التطبيق مقفل" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AppText}" HorizontalAlignment="Center"/><TextBlock Text="استخدم Windows Hello بالبصمة أو الوجه أو رمز PIN الخاص بويندوز." Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock x:Name="LockMessage" Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap" TextAlignment="Center"/><Button x:Name="UnlockButton" Content="فتح التطبيق" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Unlock_Click"/></StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
